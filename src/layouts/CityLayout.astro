---
import BaseLayout from './BaseLayout.astro';
import ServiceAreaMap from '../components/ServiceAreaMap.astro';
import ReviewCard from '../components/ReviewCard.astro';
import Accordion from '../components/Accordion.astro';
import FullBleedSection from '../components/FullBleedSection.astro';
import HeritagePlaceholder from '../components/HeritagePlaceholder.astro';

interface FaqItem { q: string; a: string; placeholderFact?: string; }

interface Props {
	title: string;
	cityName: string;
	stateAbbrev: string;
	heroPhoto: string;
	cityIntroParagraphs: string[]; // 10% custom — population, distance, housing stock, weather
	localContextParagraphs: string[]; // 10% custom — typical roof concerns, storm patterns
	driveTimeFact: string;
	faqItems: FaqItem[];
}

const p = Astro.props;
const cityFull = `${p.cityName}, ${p.stateAbbrev}`;

const allServices = [
	{ label: 'Roof replacement', href: '/residential/roof-replacement' },
	{ label: 'Roof repair', href: '/residential/roof-repair' },
	{ label: 'Roof inspection', href: '/residential/roof-inspection' },
	{ label: 'Storm damage', href: '/residential/storm-damage-roofing' },
	{ label: 'Gutter installation', href: '/residential/gutter-installation-and-repair' },
	{ label: 'Skylight installation', href: '/residential/skylight-installation-and-repair' },
	{ label: 'Attic ventilation', href: '/residential/attic-ventilation' },
	{ label: 'Chimney flashing', href: '/residential/chimney-flashing-and-repair' },
];

const allCommercial = [
	{ label: 'TPO roofing', href: '/commercial/tpo-roofing' },
	{ label: 'EPDM roofing', href: '/commercial/epdm-roofing' },
	{ label: 'Modified bitumen', href: '/commercial/modified-bitumen-roofing' },
	{ label: 'Metal roofing', href: '/commercial/metal-roofing' },
	{ label: 'Built-up (BUR)', href: '/commercial/built-up-roofing' },
	{ label: 'Coatings + restorations', href: '/commercial/roof-coatings-and-restorations' },
];
---

<BaseLayout title={p.title}>
	<!-- Hero -->
	<section class="ct-hero">
		<div class="ct-hero-photo" aria-hidden="true">
			<img src={p.heroPhoto} alt={`Roof in ${cityFull}`} loading="eager" />
		</div>
		<div class="ct-hero-overlay" aria-hidden="true"></div>
		<div class="ct-hero-content">
			<p class="ct-hero-eyebrow">Service area</p>
			<h1 class="ct-hero-h1">Roofing in {cityFull}.</h1>
			<p class="ct-hero-sub">Locally owned. Crews in your area. Free inspection same-day or next-day.</p>
			<div class="ct-hero-cta-row">
				<a class="cta-primary" href="/free-inspection">Get my free inspection</a>
				<a class="cta-secondary" href="tel:9032428102">Call 903-242-8102</a>
			</div>
		</div>
	</section>

	<div class="flow">

		<!-- City-specific intro (10% custom) -->
		<section class="block">
			<div class="narrative">
				<p class="eyebrow">{cityFull}</p>
				<h2 class="block-h">{`Why Heritage Co. covers ${p.cityName}.`}</h2>
				{p.cityIntroParagraphs.map((para) => <p class="np">{para}</p>)}
			</div>
		</section>

		<!-- What we do here (template-shared) -->
		<section class="block">
			<p class="eyebrow">What we do here</p>
			<h2 class="block-h">{`Every Heritage service runs in ${p.cityName}.`}</h2>
			<div class="svc-grid">
				<div class="svc-col">
					<p class="svc-h">For homeowners</p>
					<ul>
						{allServices.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
					</ul>
				</div>
				<div class="svc-col">
					<p class="svc-h">For businesses</p>
					<ul>
						{allCommercial.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
					</ul>
				</div>
			</div>
		</section>

		<!-- Drive time (template-shared) -->
		<section class="block">
			<p class="eyebrow">How long it takes us to get there</p>
			<h2 class="block-h">{`From Longview HQ to ${p.cityName}.`}</h2>
			<div class="drive-row">
				<div class="drive-fact">
					<p class="drive-label">Distance + drive time</p>
					<HeritagePlaceholder fact={p.driveTimeFact} />
				</div>
				<div class="drive-fact">
					<p class="drive-label">Crews on the road</p>
					<HeritagePlaceholder fact={`Cities Heritage crews live in across the ${p.stateAbbrev === 'TX' ? 'East Texas' : 'Central Arkansas'} footprint. See Founder Input page §6.`} />
				</div>
				<div class="drive-fact">
					<p class="drive-label">Inspection turnaround</p>
					<HeritagePlaceholder fact={`Free-inspection turnaround SLA in ${p.cityName} (e.g. same-day or next-day). See Founder Input page §8.`} />
				</div>
			</div>
		</section>

		<!-- Local context (10% custom) -->
		<section class="block">
			<div class="narrative">
				<p class="eyebrow">Local context</p>
				<h2 class="block-h">{`What the roofs are doing in ${p.cityName}.`}</h2>
				{p.localContextParagraphs.map((para) => <p class="np">{para}</p>)}
			</div>
		</section>

		<!-- Map (template-shared) -->
		<section class="block">
			<p class="eyebrow">Where we work</p>
			<h2 class="block-h">East Texas + Central Arkansas.</h2>
			<ServiceAreaMap />
		</section>

		<!-- Reviews (template-shared) -->
		<section class="block">
			<p class="eyebrow">{`From customers in ${p.cityName}`}</p>
			<h2 class="block-h">What homeowners have said.</h2>
			<div class="rv-grid">
				<ReviewCard placeholderFact={`Review from a ${p.cityName} customer — first + last name, project type, star rating, 1–2 sentence quote. Permission required. See Founder Input page §5.`} />
				<ReviewCard placeholderFact={`Second review from ${p.cityName}. See Founder Input page §5.`} />
				<ReviewCard placeholderFact={`Third review from ${p.cityName}. See Founder Input page §5.`} />
			</div>
		</section>

		<!-- FAQ (template-shared shape, city-specific Q&A) -->
		<section class="block">
			<p class="eyebrow">Common questions</p>
			<h2 class="block-h">{`What ${p.cityName} homeowners ask us.`}</h2>
			<Accordion items={p.faqItems} />
		</section>

	</div>

	<FullBleedSection
		imageSrc={p.heroPhoto}
		imageAlt=""
		overlayPosition="center"
		minHeight="420px"
		overlayDarken={0.65}
	>
		<p class="end-cta-eyebrow">Ready when you are</p>
		<h2 class="end-cta-h">{`Free inspection on your roof in ${p.cityName}.`}</h2>
		<p class="end-cta-sub">No obligation. Same-day or next-day quote.</p>
		<a class="end-cta-button" href="/free-inspection">Get my free inspection</a>
	</FullBleedSection>
</BaseLayout>

<style>
	.ct-hero { position: relative; min-height: 480px; background: var(--charcoal); overflow: hidden; }
	.ct-hero-photo { position: absolute; inset: 0; }
	.ct-hero-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
	.ct-hero-overlay {
		position: absolute; inset: 0;
		background: linear-gradient(90deg, rgba(26,26,26,0.82) 0%, rgba(26,26,26,0.5) 50%, rgba(26,26,26,0.2) 100%);
	}
	.ct-hero-content { position: relative; padding: 96px 48px 80px; max-width: 720px; }
	.ct-hero-eyebrow { color: var(--rust); font-size: 13px; font-weight: 500; margin: 0 0 20px; letter-spacing: 1px; text-transform: uppercase; }
	.ct-hero-h1 { color: var(--off-white); font-size: 56px; font-weight: 600; line-height: 1.05; margin: 0 0 24px; letter-spacing: -1.8px; }
	.ct-hero-sub { color: var(--subhead-dark); font-size: 17px; line-height: 1.55; margin: 0 0 32px; max-width: 580px; }
	.ct-hero-cta-row { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
	.cta-primary {
		background: var(--rust); color: var(--off-white);
		padding: 14px 28px; font-size: 15px; font-weight: 500;
		border-radius: var(--radius-pill);
	}
	.cta-secondary {
		color: var(--off-white); padding: 12px 26px;
		font-size: 15px; font-weight: 500;
		border: 2px solid var(--off-white);
		border-radius: var(--radius-pill);
	}

	.flow { background: var(--off-white); }
	.block { padding: 80px 48px; max-width: 1200px; margin: 0 auto; }
	.block + .block { border-top: 1px solid var(--border); }
	.eyebrow { color: var(--rust); font-size: 13px; font-weight: 500; letter-spacing: 1px; text-transform: uppercase; margin: 0 0 16px; }
	.block-h { color: var(--charcoal); font-size: 36px; font-weight: 600; letter-spacing: -0.8px; line-height: 1.15; margin: 0 0 16px; }
	.narrative { max-width: 720px; }
	.np { color: var(--warm-gray); font-size: 17px; line-height: 1.65; margin: 0 0 18px; }

	.svc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; max-width: 1000px; }
	.svc-h { color: var(--charcoal); font-size: 18px; font-weight: 600; margin: 0 0 16px; padding-bottom: 8px; border-bottom: 2px solid var(--charcoal); }
	.svc-col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
	.svc-col a { color: var(--charcoal); font-size: 14px; padding: 6px 0; display: inline-block; transition: color 150ms ease; }
	.svc-col a:hover { color: var(--rust); }

	.drive-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; max-width: 1100px; }
	.drive-label { color: var(--charcoal); font-size: 13px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase; margin: 0 0 12px; }

	.rv-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }

	.end-cta-eyebrow { color: var(--rust); font-size: 13px; font-weight: 500; letter-spacing: 1px; text-transform: uppercase; margin: 0 0 16px; }
	.end-cta-h { color: var(--off-white); font-size: 44px; font-weight: 600; letter-spacing: -1px; line-height: 1.1; margin: 0 0 14px; max-width: 640px; }
	.end-cta-sub { color: var(--subhead-dark); font-size: 17px; line-height: 1.55; margin: 0 0 28px; }
	.end-cta-button {
		display: inline-flex; align-items: center;
		padding: 18px 36px;
		background: var(--rust); color: var(--off-white);
		font-size: 16px; font-weight: 500;
		border-radius: var(--radius-pill);
		box-shadow: var(--shadow-active);
	}
</style>
