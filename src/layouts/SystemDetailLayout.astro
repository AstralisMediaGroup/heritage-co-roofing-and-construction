---
import BaseLayout from './BaseLayout.astro';
import Accordion from '../components/Accordion.astro';
import FullBleedSection from '../components/FullBleedSection.astro';
import HeritagePlaceholder from '../components/HeritagePlaceholder.astro';

interface BestFitItem { title: string; body: string; }
interface SpecRow { label: string; value: string; }
interface Tradeoff { kind: 'pro' | 'con'; body: string; }
interface FaqItem { q: string; a: string; placeholderFact?: string; }

interface Props {
	title: string;
	heroEyebrow: string;
	heroH1: string;
	heroSub: string;
	heroPhoto: string;
	heroPhotoAlt?: string;
	whatItIsHeading: string;
	whatItIsParagraphs: string[];
	bestFitHeading: string;
	bestFitItems: BestFitItem[];
	specsHeading: string;
	specRows: SpecRow[];
	manufacturerPlaceholder?: string;
	howInstallHeading: string;
	howInstallBody: string;
	maintenanceHeading: string;
	maintenanceBody: string;
	tradeoffsHeading: string;
	tradeoffs: Tradeoff[];
	faqItems: FaqItem[];
	endCtaPhoto: string;
	endCtaHeading: string;
	endCtaSub: string;
	endCtaLabel: string;
	endCtaHref: string;
}

const p = Astro.props;
---

<BaseLayout title={p.title} ctaButton="Request consultation">
	<section class="sy-hero">
		<div class="sy-hero-photo" aria-hidden="true">
			<img src={p.heroPhoto} alt={p.heroPhotoAlt || ''} loading="eager" />
		</div>
		<div class="sy-hero-overlay" aria-hidden="true"></div>
		<div class="sy-hero-content">
			<p class="sy-hero-eyebrow">{p.heroEyebrow}</p>
			<h1 class="sy-hero-h1">{p.heroH1}</h1>
			<p class="sy-hero-sub">{p.heroSub}</p>
			<div class="sy-hero-cta-row">
				<a class="cta-primary" href="/free-inspection">Request consultation</a>
				<a class="cta-secondary" href="tel:9032428102">Call 903-242-8102</a>
			</div>
		</div>
	</section>

	<div class="flow">

		<section class="block">
			<div class="narrative">
				<p class="eyebrow">What it is</p>
				<h2 class="block-h">{p.whatItIsHeading}</h2>
				{p.whatItIsParagraphs.map((para) => <p class="np">{para}</p>)}
			</div>
		</section>

		<section class="block">
			<p class="eyebrow">Best fit for</p>
			<h2 class="block-h">{p.bestFitHeading}</h2>
			<div class="bf-grid">
				{p.bestFitItems.map((bf) => (
					<div class="bf-item">
						<p class="bf-title">{bf.title}</p>
						<p class="bf-body">{bf.body}</p>
					</div>
				))}
			</div>
		</section>

		<section class="block">
			<p class="eyebrow">Specs</p>
			<h2 class="block-h">{p.specsHeading}</h2>
			<dl class="spec-list">
				{p.specRows.map((s) => (
					<div class="spec-row">
						<dt class="spec-label">{s.label}</dt>
						<dd class="spec-value">{s.value}</dd>
					</div>
				))}
			</dl>
			{p.manufacturerPlaceholder && (
				<div class="spec-mfr">
					<HeritagePlaceholder fact={p.manufacturerPlaceholder} />
				</div>
			)}
		</section>

		<section class="block">
			<div class="narrative">
				<p class="eyebrow">How install works</p>
				<h2 class="block-h">{p.howInstallHeading}</h2>
				<p class="np">{p.howInstallBody}</p>
			</div>
		</section>

		<section class="block">
			<div class="narrative">
				<p class="eyebrow">Maintenance</p>
				<h2 class="block-h">{p.maintenanceHeading}</h2>
				<p class="np">{p.maintenanceBody}</p>
			</div>
		</section>

		<section class="block">
			<p class="eyebrow">Where it shines / where it doesn't</p>
			<h2 class="block-h">{p.tradeoffsHeading}</h2>
			<div class="tradeoff-grid">
				<div class="tradeoff-col">
					<p class="tradeoff-h tradeoff-h-pro">Where it shines</p>
					<ul>
						{p.tradeoffs.filter((t) => t.kind === 'pro').map((t) => <li>{t.body}</li>)}
					</ul>
				</div>
				<div class="tradeoff-col">
					<p class="tradeoff-h tradeoff-h-con">Where it doesn't</p>
					<ul>
						{p.tradeoffs.filter((t) => t.kind === 'con').map((t) => <li>{t.body}</li>)}
					</ul>
				</div>
			</div>
		</section>

		<section class="block">
			<p class="eyebrow">Common questions</p>
			<h2 class="block-h">What facility managers ask us.</h2>
			<Accordion items={p.faqItems} />
		</section>

	</div>

	<FullBleedSection
		imageSrc={p.endCtaPhoto}
		imageAlt=""
		overlayPosition="center"
		minHeight="440px"
		overlayDarken={0.65}
	>
		<p class="end-cta-eyebrow">Bid-ready</p>
		<h2 class="end-cta-h">{p.endCtaHeading}</h2>
		<p class="end-cta-sub">{p.endCtaSub}</p>
		<a class="end-cta-button" href={p.endCtaHref}>{p.endCtaLabel}</a>
	</FullBleedSection>
</BaseLayout>

<style>
	.sy-hero { position: relative; min-height: 520px; background: var(--charcoal); overflow: hidden; }
	.sy-hero-photo { position: absolute; inset: 0; }
	.sy-hero-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
	.sy-hero-overlay {
		position: absolute; inset: 0;
		background: linear-gradient(90deg, rgba(26,26,26,0.82) 0%, rgba(26,26,26,0.5) 50%, rgba(26,26,26,0.2) 100%);
	}
	.sy-hero-content { position: relative; padding: 96px 48px 80px; max-width: 720px; }
	.sy-hero-eyebrow { color: var(--rust); font-size: 13px; font-weight: 500; margin: 0 0 20px; letter-spacing: 1px; text-transform: uppercase; }
	.sy-hero-h1 { color: var(--off-white); font-size: 56px; font-weight: 600; line-height: 1.05; margin: 0 0 24px; letter-spacing: -1.8px; }
	.sy-hero-sub { color: var(--subhead-dark); font-size: 17px; line-height: 1.55; margin: 0 0 32px; max-width: 580px; }
	.sy-hero-cta-row { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
	.cta-primary {
		background: var(--rust); color: var(--off-white);
		padding: 14px 28px; font-size: 15px; font-weight: 500;
		border-radius: var(--radius-pill);
		transition: background 150ms ease, box-shadow 150ms ease;
	}
	.cta-primary:hover { background: #9d3a1a; box-shadow: var(--shadow-active); }
	.cta-secondary {
		color: var(--off-white); padding: 12px 26px;
		font-size: 15px; font-weight: 500;
		border: 2px solid var(--off-white);
		border-radius: var(--radius-pill);
		transition: background 150ms ease, color 150ms ease;
	}
	.cta-secondary:hover { background: var(--off-white); color: var(--charcoal); }

	.flow { background: var(--off-white); }
	.block { padding: 80px 48px; max-width: 1200px; margin: 0 auto; }
	.block + .block { border-top: 1px solid var(--border); }

	.eyebrow { color: var(--rust); font-size: 13px; font-weight: 500; letter-spacing: 1px; text-transform: uppercase; margin: 0 0 16px; }
	.block-h { color: var(--charcoal); font-size: 36px; font-weight: 600; letter-spacing: -0.8px; line-height: 1.15; margin: 0 0 16px; }

	.narrative { max-width: 720px; }
	.np { color: var(--warm-gray); font-size: 17px; line-height: 1.65; margin: 0 0 18px; }
	.np:last-child { margin: 0; }

	.bf-grid {
		display: grid; grid-template-columns: repeat(3, 1fr);
		gap: 0; border-top: 1px solid var(--border);
	}
	.bf-item { padding: 24px 28px 0 0; }
	.bf-item + .bf-item { padding-left: 28px; border-left: 1px solid var(--border); }
	.bf-item:nth-child(n+4) { padding-top: 24px; border-top: 1px solid var(--border); margin-top: 24px; }
	.bf-title { color: var(--charcoal); font-size: 17px; font-weight: 600; margin: 0 0 8px; }
	.bf-body { color: var(--warm-gray); font-size: 14px; line-height: 1.55; margin: 0; }

	.spec-list {
		max-width: 880px; margin: 0;
		display: flex; flex-direction: column; gap: 0;
	}
	.spec-row {
		display: grid; grid-template-columns: 240px 1fr;
		gap: 32px; padding: 16px 0;
		border-top: 1px solid var(--border);
	}
	.spec-row:last-child { border-bottom: 1px solid var(--border); }
	.spec-label { color: var(--charcoal); font-size: 14px; font-weight: 600; letter-spacing: -0.1px; }
	.spec-value { color: var(--warm-gray); font-size: 14px; line-height: 1.55; margin: 0; }
	.spec-mfr { max-width: 880px; margin: 24px 0 0; }

	.tradeoff-grid {
		display: grid; grid-template-columns: 1fr 1fr;
		gap: 56px; max-width: 1000px;
	}
	.tradeoff-h { font-size: 13px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; margin: 0 0 16px; }
	.tradeoff-h-pro { color: var(--rust); }
	.tradeoff-h-con { color: var(--warm-gray); }
	.tradeoff-col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; }
	.tradeoff-col li {
		color: var(--charcoal); font-size: 15px; line-height: 1.55;
		padding-left: 18px; position: relative;
	}
	.tradeoff-h-pro ~ ul li::before { content: '+'; position: absolute; left: 0; color: var(--rust); font-weight: 700; }
	.tradeoff-h-con ~ ul li::before { content: '−'; position: absolute; left: 0; color: var(--warm-gray); font-weight: 700; }

	.end-cta-eyebrow { color: var(--rust); font-size: 13px; font-weight: 500; letter-spacing: 1px; text-transform: uppercase; margin: 0 0 16px; }
	.end-cta-h { color: var(--off-white); font-size: 44px; font-weight: 600; letter-spacing: -1px; line-height: 1.1; margin: 0 0 14px; max-width: 640px; }
	.end-cta-sub { color: var(--subhead-dark); font-size: 17px; line-height: 1.55; margin: 0 0 28px; max-width: 580px; }
	.end-cta-button {
		display: inline-flex; align-items: center;
		padding: 18px 36px;
		background: var(--rust); color: var(--off-white);
		font-size: 16px; font-weight: 500;
		border-radius: var(--radius-pill);
		box-shadow: var(--shadow-active);
		transition: background 150ms ease, transform 200ms ease;
	}
	.end-cta-button:hover { background: #9d3a1a; transform: translateY(-1px); }
</style>
