---
import BaseLayout from './BaseLayout.astro';
import TechnicalFeatures from '../components/TechnicalFeatures.astro';
import Accordion from '../components/Accordion.astro';
import FullBleedSection from '../components/FullBleedSection.astro';
import HeritagePlaceholder from '../components/HeritagePlaceholder.astro';

interface Benefit { icon: 'shield' | 'wind' | 'sun' | 'water' | 'layers' | 'gauge' | 'wrench' | 'check' | 'flame' | 'ruler' | 'bolt' | 'compass'; title: string; body: string; }
interface SpecRow { label: string; value: string; }
interface ColorSwatch { name: string; gradient?: string; imageSrc?: string; }
interface Tradeoff { kind: 'pro' | 'con'; body: string; }
interface FaqItem { q: string; a: string; placeholderFact?: string; }

interface Props {
	title: string;
	heroEyebrow: string;
	heroH1: string;
	heroSub: string;
	heroPhoto: string;
	heroPhotoAlt?: string;
	whatItIsHeading: string;
	whatItIsParagraphs: string[];
	benefitsHeading: string;
	benefitsSub: string;
	benefits: Benefit[];
	colorsHeading: string;
	colorsSub?: string;
	colorSwatches: ColorSwatch[];
	colorsPlaceholder?: string;
	specsHeading: string;
	specRows: SpecRow[];
	manufacturerPlaceholder?: string;
	costPriceBandFact: string;
	costFactors: string[];
	tradeoffsHeading: string;
	tradeoffs: Tradeoff[];
	faqItems: FaqItem[];
	endCtaPhoto: string;
	endCtaHeading: string;
	endCtaSub: string;
}

const p = Astro.props;
---

<BaseLayout title={p.title}>
	<!-- Hero -->
	<section class="md-hero">
		<div class="md-hero-photo" aria-hidden="true">
			<img src={p.heroPhoto} alt={p.heroPhotoAlt || ''} loading="eager" />
		</div>
		<div class="md-hero-overlay" aria-hidden="true"></div>
		<div class="md-hero-content">
			<p class="md-hero-eyebrow">{p.heroEyebrow}</p>
			<h1 class="md-hero-h1">{p.heroH1}</h1>
			<p class="md-hero-sub">{p.heroSub}</p>
			<div class="md-hero-cta-row">
				<a class="cta-primary" href="/free-inspection">Get my free inspection</a>
				<a class="cta-secondary" href="tel:9032428102">Call 903-242-8102</a>
			</div>
		</div>
	</section>

	<div class="flow">

		<!-- What it is -->
		<section class="block">
			<div class="narrative">
				<p class="eyebrow">What it is</p>
				<h2 class="block-h">{p.whatItIsHeading}</h2>
				{p.whatItIsParagraphs.map((para) => <p class="np">{para}</p>)}
			</div>
		</section>

		<!-- Benefits (TechnicalFeatures 6-card pattern) -->
		<section class="block">
			<TechnicalFeatures
				eyebrow="Benefits"
				heading={p.benefitsHeading}
				sub={p.benefitsSub}
				columns={3}
				features={p.benefits}
			/>
		</section>

		<!-- Color / style options -->
		<section class="block">
			<p class="eyebrow">Color + style options</p>
			<h2 class="block-h">{p.colorsHeading}</h2>
			{p.colorsSub && <p class="block-sub">{p.colorsSub}</p>}
			<div class="md-swatches">
				{p.colorSwatches.map((s) => (
					<div class="md-swatch">
						<div class="md-swatch-color" style={s.imageSrc ? `background-image: url(${s.imageSrc}); background-size: cover; background-position: center;` : `background: ${s.gradient};`} aria-hidden="true">
							{s.imageSrc && <img src={s.imageSrc} alt={s.name} loading="lazy" />}
						</div>
						<p class="md-swatch-name">{s.name}</p>
					</div>
				))}
			</div>
			{p.colorsPlaceholder && (
				<div class="md-colors-note">
					<HeritagePlaceholder fact={p.colorsPlaceholder} />
				</div>
			)}
		</section>

		<!-- Specs table -->
		<section class="block">
			<p class="eyebrow">Specs</p>
			<h2 class="block-h">{p.specsHeading}</h2>
			<dl class="md-spec-list">
				{p.specRows.map((s) => (
					<div class="md-spec-row">
						<dt class="md-spec-label">{s.label}</dt>
						<dd class="md-spec-value">{s.value}</dd>
					</div>
				))}
			</dl>
			{p.manufacturerPlaceholder && (
				<div class="md-mfr">
					<HeritagePlaceholder fact={p.manufacturerPlaceholder} />
				</div>
			)}
		</section>

		<!-- Cost -->
		<section class="block">
			<p class="eyebrow">What it costs</p>
			<h2 class="block-h">Price band, plus what moves the number.</h2>
			<div class="md-cost-row">
				<div class="md-cost-band">
					<p class="md-cost-label">Typical price band</p>
					<HeritagePlaceholder fact={p.costPriceBandFact} />
				</div>
				<div class="md-cost-factors">
					<p class="md-cost-label">What moves the number</p>
					<ul class="md-cost-list">
						{p.costFactors.map((f) => <li>{f}</li>)}
					</ul>
				</div>
			</div>
		</section>

		<!-- Tradeoffs -->
		<section class="block">
			<p class="eyebrow">Where it shines / where it doesn't</p>
			<h2 class="block-h">{p.tradeoffsHeading}</h2>
			<div class="md-trade-grid">
				<div class="md-trade-col">
					<p class="md-trade-h md-trade-h-pro">Where it shines</p>
					<ul>
						{p.tradeoffs.filter((t) => t.kind === 'pro').map((t) => <li>{t.body}</li>)}
					</ul>
				</div>
				<div class="md-trade-col">
					<p class="md-trade-h md-trade-h-con">Where it doesn't</p>
					<ul>
						{p.tradeoffs.filter((t) => t.kind === 'con').map((t) => <li>{t.body}</li>)}
					</ul>
				</div>
			</div>
		</section>

		<!-- FAQ -->
		<section class="block">
			<p class="eyebrow">Common questions</p>
			<h2 class="block-h">What homeowners ask us about this material.</h2>
			<Accordion items={p.faqItems} />
		</section>

	</div>

	<!-- End CTA -->
	<FullBleedSection
		imageSrc={p.endCtaPhoto}
		imageAlt=""
		overlayPosition="center"
		minHeight="440px"
		overlayDarken={0.65}
	>
		<p class="end-cta-eyebrow">Ready when you are</p>
		<h2 class="end-cta-h">{p.endCtaHeading}</h2>
		<p class="end-cta-sub">{p.endCtaSub}</p>
		<a class="end-cta-button" href="/free-inspection">Get my free inspection</a>
	</FullBleedSection>
</BaseLayout>

<style>
	.md-hero { position: relative; min-height: 540px; background: var(--charcoal); overflow: hidden; }
	.md-hero-photo { position: absolute; inset: 0; }
	.md-hero-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
	.md-hero-overlay {
		position: absolute; inset: 0;
		background: linear-gradient(90deg, rgba(26,26,26,0.82) 0%, rgba(26,26,26,0.5) 50%, rgba(26,26,26,0.2) 100%);
	}
	.md-hero-content { position: relative; padding: 96px 48px 80px; max-width: 720px; }
	.md-hero-eyebrow { color: var(--rust); font-size: 13px; font-weight: 500; margin: 0 0 20px; letter-spacing: 1px; text-transform: uppercase; }
	.md-hero-h1 { color: var(--off-white); font-size: 56px; font-weight: 600; line-height: 1.05; margin: 0 0 24px; letter-spacing: -1.8px; }
	.md-hero-sub { color: var(--subhead-dark); font-size: 17px; line-height: 1.55; margin: 0 0 32px; max-width: 580px; }
	.md-hero-cta-row { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
	.cta-primary {
		background: var(--rust); color: var(--off-white);
		padding: 14px 28px; font-size: 15px; font-weight: 500;
		border-radius: var(--radius-pill);
		transition: background 150ms ease, box-shadow 150ms ease;
	}
	.cta-primary:hover { background: #9d3a1a; box-shadow: var(--shadow-active); }
	.cta-secondary {
		color: var(--off-white); padding: 12px 26px;
		font-size: 15px; font-weight: 500;
		border: 2px solid var(--off-white);
		border-radius: var(--radius-pill);
	}
	.cta-secondary:hover { background: var(--off-white); color: var(--charcoal); }

	.flow { background: var(--off-white); }
	.block { padding: 80px 48px; max-width: 1200px; margin: 0 auto; }
	.block + .block { border-top: 1px solid var(--border); }
	.eyebrow { color: var(--rust); font-size: 13px; font-weight: 500; letter-spacing: 1px; text-transform: uppercase; margin: 0 0 16px; }
	.block-h { color: var(--charcoal); font-size: 36px; font-weight: 600; letter-spacing: -0.8px; line-height: 1.15; margin: 0 0 16px; }
	.block-sub { color: var(--warm-gray); font-size: 17px; line-height: 1.6; margin: 0 0 32px; max-width: 580px; }
	.narrative { max-width: 720px; }
	.np { color: var(--warm-gray); font-size: 17px; line-height: 1.65; margin: 0 0 18px; }
	.np:last-child { margin: 0; }

	/* Color swatches */
	.md-swatches {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 24px;
	}
	.md-swatch {}
	.md-swatch-color {
		aspect-ratio: 5 / 4;
		width: 100%;
		border: 1px solid var(--border);
		border-radius: var(--radius-card);
		box-shadow: var(--shadow-subtle);
		overflow: hidden;
		position: relative;
	}
	.md-swatch-color img { width: 100%; height: 100%; object-fit: cover; display: block; }
	.md-swatch-name { color: var(--charcoal); font-size: 13px; font-weight: 500; margin: 12px 0 0; text-align: center; }
	.md-colors-note { max-width: 1100px; margin: 24px 0 0; }

	/* Specs */
	.md-spec-list { max-width: 880px; margin: 0; display: flex; flex-direction: column; gap: 0; }
	.md-spec-row { display: grid; grid-template-columns: 240px 1fr; gap: 32px; padding: 16px 0; border-top: 1px solid var(--border); }
	.md-spec-row:last-child { border-bottom: 1px solid var(--border); }
	.md-spec-label { color: var(--charcoal); font-size: 14px; font-weight: 600; }
	.md-spec-value { color: var(--warm-gray); font-size: 14px; line-height: 1.55; margin: 0; }
	.md-mfr { max-width: 880px; margin: 24px 0 0; }

	/* Cost */
	.md-cost-row { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; max-width: 1000px; }
	.md-cost-label { color: var(--charcoal); font-size: 13px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; margin: 0 0 12px; }
	.md-cost-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
	.md-cost-list li { color: var(--warm-gray); font-size: 14px; line-height: 1.55; padding-left: 16px; position: relative; }
	.md-cost-list li::before { content: '·'; position: absolute; left: 0; color: var(--rust); font-weight: 700; }

	/* Tradeoffs */
	.md-trade-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; max-width: 1000px; }
	.md-trade-h { font-size: 13px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; margin: 0 0 16px; }
	.md-trade-h-pro { color: var(--rust); }
	.md-trade-h-con { color: var(--warm-gray); }
	.md-trade-col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; }
	.md-trade-col li { color: var(--charcoal); font-size: 15px; line-height: 1.55; padding-left: 18px; position: relative; }
	.md-trade-h-pro ~ ul li::before { content: '+'; position: absolute; left: 0; color: var(--rust); font-weight: 700; }
	.md-trade-h-con ~ ul li::before { content: '−'; position: absolute; left: 0; color: var(--warm-gray); font-weight: 700; }

	/* End CTA */
	.end-cta-eyebrow { color: var(--rust); font-size: 13px; font-weight: 500; letter-spacing: 1px; text-transform: uppercase; margin: 0 0 16px; }
	.end-cta-h { color: var(--off-white); font-size: 44px; font-weight: 600; letter-spacing: -1px; line-height: 1.1; margin: 0 0 14px; max-width: 640px; }
	.end-cta-sub { color: var(--subhead-dark); font-size: 17px; line-height: 1.55; margin: 0 0 28px; max-width: 580px; }
	.end-cta-button { display: inline-flex; align-items: center; padding: 18px 36px; background: var(--rust); color: var(--off-white); font-size: 16px; font-weight: 500; border-radius: var(--radius-pill); box-shadow: var(--shadow-active); }
</style>
