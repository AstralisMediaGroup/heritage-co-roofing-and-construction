---
import { eastTexas, eastTexasMore, centralArkansas } from '../content/cities';
---

<div class="region-grid">
	<div>
		<p class="region-h">East Texas</p>
		<p class="region-cities">{eastTexas.join(' · ')} · {eastTexasMore}</p>
	</div>
	<div>
		<p class="region-h">Central Arkansas</p>
		<p class="region-cities">{centralArkansas.join(' · ')}</p>
	</div>
</div>

<style>
	.region-grid {
		display: grid; grid-template-columns: 1fr 1fr;
		gap: 56px; max-width: 800px; margin: 0 auto;
	}
	.region-h {
		color: #1a1a1a; font-size: 22px; font-weight: 600;
		margin: 0 0 16px; padding-bottom: 12px;
		border-bottom: 2px solid #1a1a1a; letter-spacing: -0.3px;
	}
	.region-cities { color: #5a5347; font-size: 15px; line-height: 1.85; }
</style>
