---
import HeritagePlaceholder from './HeritagePlaceholder.astro';

interface Props {
	heading?: string;
	sub?: string;
}

const {
	heading = 'Certifications, memberships, and licenses',
	sub = 'Plain-text badges. Numbers and accreditation IDs filled in by the founders.',
} = Astro.props;
---

<section class="certs">
	<p class="certs-eyebrow">Credentials</p>
	<h2 class="certs-h">{heading}</h2>
	<p class="certs-sub">{sub}</p>
	<div class="certs-grid">
		<div class="cert-item">
			<p class="cert-label">Manufacturer certifications</p>
			<HeritagePlaceholder fact="GAF Master Elite? Owens Corning Platinum? CertainTeed? — list all manufacturer certs and the year each was earned" />
		</div>
		<div class="cert-item">
			<p class="cert-label">Industry memberships</p>
			<HeritagePlaceholder fact="NRCA member (since when)? Texas Association of Builders? Roofing Contractors Association of Texas?" />
		</div>
		<div class="cert-item">
			<p class="cert-label">BBB accreditation</p>
			<HeritagePlaceholder fact="BBB rating, accreditation start year, and business profile URL" />
		</div>
		<div class="cert-item">
			<p class="cert-label">Licenses + insurance</p>
			<HeritagePlaceholder fact="Texas roofing license # (and Arkansas equivalent); GL coverage limit; workers' comp carrier" />
		</div>
		<div class="cert-item">
			<p class="cert-label">Safety training</p>
			<HeritagePlaceholder fact="OSHA 10 / OSHA 30 / fall protection — what crew has, % of crew trained" />
		</div>
		<div class="cert-item">
			<p class="cert-label">Commercial system certifications</p>
			<HeritagePlaceholder fact="Carlisle SureWeld? Firestone Red Shield? GAF EverGuard? Johns Manville Peak Advantage?" />
		</div>
	</div>
</section>

<style>
	.certs { background: #ffffff; padding: 96px 48px; border-top: 1px solid #ece7de; }
	.certs-eyebrow {
		color: #b54620; font-size: 13px; font-weight: 500;
		text-align: center; margin: 0 0 16px;
		letter-spacing: 1px; text-transform: uppercase;
	}
	.certs-h {
		color: #1a1a1a; font-size: 40px; font-weight: 600;
		text-align: center; margin: 0 0 16px;
		letter-spacing: -1px; line-height: 1.1;
	}
	.certs-sub { color: #5a5347; font-size: 16px; text-align: center; margin: 0 0 56px; }
	.certs-grid {
		display: grid; grid-template-columns: repeat(2, 1fr);
		gap: 32px; max-width: 960px; margin: 0 auto;
	}
	.cert-item { padding: 24px; background: #faf8f4; border: 1px solid #ece7de; }
	.cert-label {
		color: #1a1a1a; font-size: 14px; font-weight: 600;
		margin: 0 0 12px; letter-spacing: -0.2px;
	}
</style>
