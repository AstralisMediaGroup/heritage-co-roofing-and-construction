---
import HeritagePlaceholder from './HeritagePlaceholder.astro';

interface Props {
	projectName?: string;
	city?: string;
	year?: string;
	system?: string;
	sqft?: string;
	industry?: string;
	placeholderFact?: string;
}

const {
	projectName,
	city,
	year,
	system,
	sqft,
	industry,
	placeholderFact = 'Named commercial project — building name, city, year, roof system, sq ft if known, industry. Permission required. See Founder Input page §5.',
} = Astro.props;

const hasReal = projectName && city;
const meta = [year, system, sqft && `${sqft} sq ft`, industry].filter(Boolean).join(' · ');
---

<article class="project-card">
	<div class="project-photo" aria-hidden="true"></div>
	{hasReal ? (
		<div class="project-body">
			<p class="project-industry">{industry || 'Commercial'}</p>
			<h3 class="project-name">{projectName}</h3>
			<p class="project-meta">{meta}</p>
			<p class="project-city">{city}</p>
		</div>
	) : (
		<div class="project-body">
			<HeritagePlaceholder fact={placeholderFact} />
		</div>
	)}
</article>

<style>
	.project-card { background: #ffffff; border: 1px solid #ece7de; overflow: hidden; }
	.project-photo {
		height: 220px;
		background: linear-gradient(180deg, #7d8b9e 0%, #a8a89c 50%, #4a4a48 100%);
	}
	.project-body { padding: 24px 28px; }
	.project-industry {
		color: #b54620; font-size: 11px; font-weight: 500;
		margin: 0 0 10px; letter-spacing: 1.5px; text-transform: uppercase;
	}
	.project-name {
		color: #1a1a1a; font-size: 20px; font-weight: 600;
		margin: 0 0 8px; letter-spacing: -0.3px; line-height: 1.2;
	}
	.project-meta { color: #5a5347; font-size: 13px; margin: 0 0 6px; line-height: 1.5; }
	.project-city { color: #5a5347; font-size: 13px; font-weight: 500; margin: 0; }
</style>
