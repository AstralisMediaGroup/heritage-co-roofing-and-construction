---
interface Step {
	label: string;
	caption?: string;
}

interface Props {
	steps: Step[];
	theme?: 'light' | 'dark';
}

const { steps, theme = 'light' } = Astro.props;
---

<ol class={`flow flow-${theme}`} style={`--cols: ${steps.length};`}>
	{steps.map((s, i) => (
		<li class="flow-step">
			<span class="flow-num">{(i + 1).toString().padStart(2, '0')}</span>
			<p class="flow-label">{s.label}</p>
			{s.caption && <p class="flow-caption">{s.caption}</p>}
		</li>
	))}
</ol>

<style>
	.flow {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0;
		list-style: none;
		display: grid;
		grid-template-columns: repeat(var(--cols, 4), 1fr);
		gap: 0;
		position: relative;
	}
	/* Hairline baseline running across the row, sitting under the numerals */
	.flow::before {
		content: '';
		position: absolute;
		left: 0; right: 0;
		top: 64px;
		height: 1px;
		background: var(--border);
	}
	.flow-dark.flow::before { background: rgba(250,248,244,0.18); }

	.flow-step {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 0 20px 0 0;
		position: relative;
	}
	/* Vertical hairline between steps */
	.flow-step + .flow-step::before {
		content: '';
		position: absolute;
		left: -1px; top: 0; bottom: 0;
		width: 1px;
		background: var(--border);
	}
	.flow-dark .flow-step + .flow-step::before { background: rgba(250,248,244,0.18); }

	.flow-num {
		color: var(--rust);
		font-size: 56px;
		font-weight: 600;
		line-height: 1;
		letter-spacing: -2px;
		font-feature-settings: 'tnum';
		display: inline-block;
		padding-bottom: 24px;
	}
	.flow-label {
		color: var(--charcoal);
		font-size: 19px;
		font-weight: 600;
		letter-spacing: -0.3px;
		line-height: 1.2;
		margin: 0;
	}
	.flow-caption {
		color: var(--warm-gray);
		font-size: 14px;
		line-height: 1.55;
		margin: 0;
		max-width: 240px;
	}

	.flow-dark .flow-label { color: var(--off-white); }
	.flow-dark .flow-caption { color: var(--body-dark); }
</style>
