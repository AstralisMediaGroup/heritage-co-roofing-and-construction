---
interface Props {
	heading: string;
	body: string;
}

const { heading, body } = Astro.props;
---

<div class="local-item">
	<div class="local-item-photo" aria-hidden="true"></div>
	<p class="local-item-h">{heading}</p>
	<p class="local-item-body">{body}</p>
</div>

<style>
	.local-item-photo {
		height: 200px;
		background: linear-gradient(180deg, #4a4a48 0%, #6b5d4a 100%);
		margin-bottom: 24px;
		border-radius: var(--radius-card);
	}
	.local-item-h {
		color: #faf8f4; font-size: 22px; font-weight: 600;
		margin: 0 0 12px; letter-spacing: -0.3px; line-height: 1.2;
	}
	.local-item-body { color: #c4c1ba; font-size: 15px; line-height: 1.6; margin: 0; }
</style>
