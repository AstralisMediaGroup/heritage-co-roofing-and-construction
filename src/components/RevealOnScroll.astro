---
interface Props {
	delay?: number;
	class?: string;
}

const { delay = 0, class: extraClass = '' } = Astro.props;
---

<div class={`reveal ${extraClass}`} data-reveal style={delay ? `transition-delay: ${delay}ms;` : undefined}>
	<slot />
</div>

<style>
	.reveal {
		opacity: 1;
		transform: none;
		transition: opacity 400ms ease-out, transform 400ms ease-out;
	}
	[data-reveal-enhanced] {
		opacity: 0;
		transform: translateY(16px);
	}
	[data-reveal-enhanced].is-revealed {
		opacity: 1;
		transform: none;
	}
	@media (prefers-reduced-motion: reduce) {
		.reveal { transition: none !important; opacity: 1 !important; transform: none !important; }
	}
</style>

<script is:inline>
	(function () {
		const els = document.querySelectorAll('[data-reveal]:not([data-reveal-enhanced])');
		if (!els.length) return;
		els.forEach((el) => el.setAttribute('data-reveal-enhanced', ''));
		if (typeof IntersectionObserver === 'undefined') {
			els.forEach((el) => el.classList.add('is-revealed'));
			return;
		}
		const io = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add('is-revealed');
					io.unobserve(entry.target);
				}
			});
		}, { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });
		els.forEach((el) => io.observe(el));
	})();
</script>
