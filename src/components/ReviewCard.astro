---
import HeritagePlaceholder from './HeritagePlaceholder.astro';

interface Props {
	stars?: number;
	quote?: string;
	name?: string;
	city?: string;
	jobType?: string;
	placeholderFact?: string;
}

const {
	stars = 5,
	quote,
	name,
	city,
	jobType,
	placeholderFact = 'Real customer review — first + last name, city, project type, 1–2 sentences in their words, star rating. Permission required. See Founder Input page §5.',
} = Astro.props;

const hasReal = quote && name;
const starString = '★'.repeat(stars) + '☆'.repeat(5 - stars);
---

<article class="review">
	{hasReal ? (
		<>
			<p class="review-stars" aria-label={`${stars} out of 5 stars`}>{starString}</p>
			<p class="review-quote">{quote}</p>
			<div class="review-attrib">
				<div class="review-avatar" aria-hidden="true"></div>
				<div class="review-meta-text">
					<span class="review-name">{name}</span>
					{(city || jobType) && (
						<span class="review-meta">{[city, jobType].filter(Boolean).join(' · ')}</span>
					)}
				</div>
			</div>
		</>
	) : (
		<HeritagePlaceholder fact={placeholderFact} />
	)}
</article>

<style>
	.review {
		padding: 32px;
		background: #ffffff;
		border: 1px solid #ece7de;
		border-radius: var(--radius-card);
		box-shadow: var(--shadow-subtle);
	}
	.review-stars {
		color: var(--rust);
		font-size: 18px;
		letter-spacing: 2px;
		margin: 0 0 16px;
	}
	.review-quote {
		color: #1a1a1a;
		font-size: 16px;
		line-height: 1.55;
		margin: 0 0 24px;
		letter-spacing: -0.1px;
	}
	.review-quote::before { content: '"'; }
	.review-quote::after { content: '"'; }
	.review-attrib {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.review-avatar {
		width: 40px; height: 40px;
		border-radius: var(--radius-pill);
		background: linear-gradient(135deg, #6b5d4a 0%, #4a4239 100%);
		flex-shrink: 0;
	}
	.review-meta-text { display: flex; flex-direction: column; gap: 2px; }
	.review-name { color: #1a1a1a; font-size: 14px; font-weight: 600; }
	.review-meta { color: #5a5347; font-size: 13px; }
</style>
