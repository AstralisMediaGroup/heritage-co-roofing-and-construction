---
interface Props {
	label?: string;
}

const { label = 'East Texas + Central Arkansas' } = Astro.props;
---

<a href="/service-areas" class="sticky-anchor" data-sticky-anchor aria-label={`Service area: ${label}`}>
	<span class="sa-pin" aria-hidden="true">
		<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
			<path d="M12 22s-7-7-7-12a7 7 0 0 1 14 0c0 5-7 12-7 12z" />
			<circle cx="12" cy="10" r="2.5" />
		</svg>
	</span>
	<span class="sa-label">{label}</span>
</a>

<style>
	.sticky-anchor {
		position: fixed;
		top: 24px;
		left: 50%;
		transform: translateX(-50%) translateY(-12px);
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 9px 16px 9px 14px;
		background: rgba(26,26,26,0.92);
		color: var(--off-white);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.2px;
		border-radius: var(--radius-pill);
		box-shadow: var(--shadow-active);
		z-index: 80;
		opacity: 0;
		pointer-events: none;
		transition: opacity 200ms ease, transform 200ms ease;
		text-decoration: none;
		backdrop-filter: blur(6px);
	}
	.sticky-anchor.is-visible {
		opacity: 1;
		transform: translateX(-50%) translateY(0);
		pointer-events: auto;
	}
	.sa-pin { color: var(--rust); display: inline-flex; }
	.sa-label { white-space: nowrap; }

	@media (max-width: 700px) {
		.sticky-anchor { font-size: 11px; padding: 8px 14px; }
	}
</style>

<script is:inline>
	(function () {
		const anchor = document.querySelector('[data-sticky-anchor]');
		if (!anchor) return;
		const update = () => {
			const top = window.scrollY > window.innerHeight - 100;
			const doc = document.documentElement;
			const nearBottom = (window.scrollY + window.innerHeight) > (doc.scrollHeight - 600);
			if (top && !nearBottom) anchor.classList.add('is-visible');
			else anchor.classList.remove('is-visible');
		};
		update();
		window.addEventListener('scroll', update, { passive: true });
		window.addEventListener('resize', update, { passive: true });
	})();
</script>
