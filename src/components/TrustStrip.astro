---
interface Props {
	items: string[];
}

const { items } = Astro.props;
---

<section class="trust">
	<div class="trust-row">
		{items.map((item) => (
			<span class="trust-pill">{item}</span>
		))}
	</div>
</section>

<style>
	.trust {
		background: #ffffff;
		padding: 36px 48px;
		border-top: 1px solid #ece7de;
		border-bottom: 1px solid #ece7de;
	}
	.trust-row {
		display: flex; gap: 12px; justify-content: center;
		align-items: center; flex-wrap: wrap;
	}
	.trust-pill {
		display: inline-flex;
		align-items: center;
		padding: 8px 18px;
		background: #faf8f4;
		border: 1px solid #ece7de;
		color: #1a1a1a;
		font-size: 13px;
		font-weight: 500;
		letter-spacing: 0.3px;
		border-radius: var(--radius-pill);
	}
</style>
