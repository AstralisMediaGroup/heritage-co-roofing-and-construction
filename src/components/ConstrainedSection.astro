---
interface Props {
	background?: 'light' | 'dark' | 'ivory' | 'transparent';
	paddingY?: 'sm' | 'md' | 'lg';
	class?: string;
}

const {
	background = 'light',
	paddingY = 'md',
	class: extraClass = '',
} = Astro.props;
---

<section class={`constrained constrained-${background} pad-${paddingY} ${extraClass}`}>
	<div class="constrained-inner">
		<slot />
	</div>
</section>

<style>
	.constrained { width: 100%; }
	.pad-sm { padding-top: 56px; padding-bottom: 56px; }
	.pad-md { padding-top: 96px; padding-bottom: 96px; }
	.pad-lg { padding-top: 128px; padding-bottom: 128px; }

	.constrained-light { background: #ffffff; border-top: 1px solid var(--border); }
	.constrained-dark { background: var(--charcoal); }
	.constrained-ivory { background: var(--ivory-tint); border-top: 1px solid var(--border); }
	.constrained-transparent { background: transparent; }

	.constrained-inner {
		max-width: 800px;
		margin: 0 auto;
		padding: 0 48px;
	}
</style>
