---

<div class="nav" data-nav>
	<a class="nav-logo" href="/">HERITAGE Co. ROOFING</a>
	<div class="nav-links">
		<a href="/residential">Residential</a>
		<a href="/commercial">Commercial</a>
		<a href="/service-areas">Service area</a>
		<a href="/about">About</a>
		<a class="nav-cta" href="/#inspection">Free inspection</a>
	</div>
</div>

<style>
	.nav {
		background: #faf8f4;
		padding: 22px 48px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		border-bottom: 1px solid #ece7de;
		transition: padding 250ms ease, background 250ms ease, box-shadow 250ms ease;
	}
	.nav.is-scrolled {
		padding: 14px 48px;
		background: rgba(250, 248, 244, 0.92);
		backdrop-filter: saturate(160%) blur(8px);
		-webkit-backdrop-filter: saturate(160%) blur(8px);
		box-shadow: var(--shadow-subtle);
	}
	.nav-logo {
		color: #1a1a1a;
		font-weight: 600;
		font-size: 20px;
		letter-spacing: 0.5px;
	}
	.nav-links {
		display: flex;
		gap: 36px;
		align-items: center;
		font-size: 14px;
		color: #1a1a1a;
		font-weight: 500;
	}
	.nav-cta {
		background: #1a1a1a;
		color: #faf8f4;
		padding: 12px 24px;
		font-size: 14px;
		font-weight: 500;
		border-radius: var(--radius-pill);
		transition: background 150ms ease;
	}
	.nav-cta:hover { background: #b54620; }
</style>

<script is:inline>
	(function () {
		const nav = document.querySelector('[data-nav]');
		if (!nav) return;
		const update = () => {
			if (window.scrollY > 200) nav.classList.add('is-scrolled');
			else nav.classList.remove('is-scrolled');
		};
		update();
		window.addEventListener('scroll', update, { passive: true });
	})();
</script>
