---
import HeritagePlaceholder from './HeritagePlaceholder.astro';

interface Badge {
	label: string;
	sub?: string;
}

interface Props {
	heading?: string;
	badges?: Badge[];
	placeholderFact?: string;
}

const defaultBadges: Badge[] = [
	{ label: 'BBB Accredited', sub: 'A+ rating' },
	{ label: 'NRCA Member' },
	{ label: 'Texas Association of Builders' },
	{ label: 'GAF Master Elite', sub: 'Manufacturer cert' },
	{ label: 'Owens Corning Platinum', sub: 'Manufacturer cert' },
	{ label: 'OSHA-trained crews' },
];

const {
	heading = 'Accreditations + memberships',
	badges = defaultBadges,
	placeholderFact = 'Replace the badges above with the real list — only show the ones Heritage actually holds. Remove any Heritage does not. See Founder Input page §2.',
} = Astro.props;
---

<div class="badge-cluster">
	<p class="badge-heading">{heading}</p>
	<div class="badge-grid">
		{badges.map((b) => (
			<div class="badge">
				<span class="badge-label">{b.label}</span>
				{b.sub && <span class="badge-sub">{b.sub}</span>}
			</div>
		))}
	</div>
	<div class="badge-placeholder">
		<HeritagePlaceholder fact={placeholderFact} />
	</div>
</div>

<style>
	.badge-cluster {}
	.badge-heading {
		color: #1a1a1a; font-size: 14px; font-weight: 600;
		margin: 0 0 20px; letter-spacing: 1px; text-transform: uppercase;
		text-align: center;
	}
	.badge-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		justify-content: center;
		max-width: 880px;
		margin: 0 auto;
	}
	.badge {
		display: inline-flex;
		flex-direction: column;
		gap: 2px;
		padding: 14px 20px;
		background: #ffffff;
		border: 1px solid #1a1a1a;
		min-width: 180px;
		text-align: center;
		border-radius: var(--radius-pill);
	}
	.badge-label {
		color: #1a1a1a; font-size: 14px; font-weight: 600;
		letter-spacing: -0.2px;
	}
	.badge-sub {
		color: #5a5347; font-size: 12px;
	}
	.badge-placeholder { margin-top: 20px; max-width: 880px; margin-left: auto; margin-right: auto; }
</style>
