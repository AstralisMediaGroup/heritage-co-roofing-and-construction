---
interface Props {
	gradient?: string;
	imageSrc?: string;
	imageAlt?: string;
	bleed?: number;
	aspect?: string;
	align?: 'left' | 'right' | 'center';
	maxWidth?: string;
}

const {
	gradient = 'linear-gradient(180deg, #6b8aa8 0%, #b8a78c 60%, #6b5d4a 100%)',
	imageSrc,
	imageAlt = '',
	bleed = 100,
	aspect = '16 / 9',
	align = 'center',
	maxWidth = '900px',
} = Astro.props;
---

<div class={`bleed bleed-${align}`} style={`margin-bottom: -${bleed}px; max-width: ${maxWidth};`}>
	<div class="bleed-image" style={`aspect-ratio: ${aspect}; ${imageSrc ? '' : `background: ${gradient};`}`} aria-hidden={imageSrc ? undefined : 'true'}>
		{imageSrc && <img src={imageSrc} alt={imageAlt} loading="lazy" />}
	</div>
</div>

<style>
	.bleed {
		position: relative;
		z-index: 2;
		width: 100%;
	}
	.bleed-center { margin-left: auto; margin-right: auto; }
	.bleed-left { margin-right: auto; }
	.bleed-right { margin-left: auto; }
	.bleed-image {
		width: 100%;
		border-radius: var(--radius-large);
		box-shadow: var(--shadow-active);
		overflow: hidden;
	}
	.bleed-image img {
		width: 100%; height: 100%;
		object-fit: cover;
		display: block;
	}
</style>
