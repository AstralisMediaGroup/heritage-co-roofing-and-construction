---
import HeritagePlaceholder from './HeritagePlaceholder.astro';

interface Item {
	q: string;
	a: string;
	placeholderFact?: string;
}

interface Props {
	items: Item[];
}

const { items } = Astro.props;
---

<div class="accordion" data-accordion>
	{items.map((item) => (
		<details class="acc-item">
			<summary class="acc-summary">
				<span class="acc-q">{item.q}</span>
				<span class="acc-icon" aria-hidden="true"></span>
			</summary>
			<div class="acc-collapse">
				<div class="acc-body">
					<p class="acc-a">{item.a}</p>
					{item.placeholderFact && (
						<div class="acc-placeholder">
							<HeritagePlaceholder fact={item.placeholderFact} />
						</div>
					)}
				</div>
			</div>
		</details>
	))}
</div>

<style>
	.accordion {
		max-width: 800px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.acc-item {
		background: #ffffff;
		border: 1px solid var(--border);
		border-radius: var(--radius-card);
		box-shadow: var(--shadow-subtle);
		overflow: hidden;
		transition: box-shadow 200ms ease;
	}
	.acc-item[open] { box-shadow: var(--shadow-active); }
	.acc-summary {
		list-style: none;
		cursor: pointer;
		padding: 22px 26px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
	}
	.acc-summary::-webkit-details-marker { display: none; }
	.acc-q {
		color: var(--charcoal);
		font-size: 17px;
		font-weight: 600;
		letter-spacing: -0.2px;
		line-height: 1.35;
	}
	.acc-icon {
		flex-shrink: 0;
		width: 14px; height: 14px;
		position: relative;
		transition: transform 250ms ease-out;
	}
	.acc-icon::before, .acc-icon::after {
		content: '';
		position: absolute;
		background: var(--charcoal);
	}
	.acc-icon::before { left: 50%; top: 0; bottom: 0; width: 2px; transform: translateX(-50%); }
	.acc-icon::after { top: 50%; left: 0; right: 0; height: 2px; transform: translateY(-50%); }
	.acc-item[open] .acc-icon { transform: rotate(180deg); }
	.acc-item[open] .acc-icon::before { opacity: 0; }

	/* Animated collapse using grid-template-rows trick (modern Chrome/Firefox/Safari) */
	.acc-collapse {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 250ms ease-out;
	}
	.acc-item[open] .acc-collapse {
		grid-template-rows: 1fr;
	}
	.acc-body {
		min-height: 0;
		overflow: hidden;
		padding: 0 26px;
	}
	.acc-item[open] .acc-body { padding: 0 26px 22px; }
	.acc-a {
		color: var(--warm-gray);
		font-size: 15px;
		line-height: 1.65;
		margin: 0;
	}
	.acc-placeholder { margin-top: 14px; }

	@media (prefers-reduced-motion: reduce) {
		.acc-collapse { transition: none; }
		.acc-icon { transition: none; }
	}
</style>

<script is:inline>
	(function () {
		const accs = document.querySelectorAll('[data-accordion]');
		accs.forEach((acc) => {
			acc.setAttribute('data-accordion-enhanced', 'true');
			acc.querySelectorAll('details').forEach((d) => {
				d.addEventListener('toggle', () => {
					if (d.open) {
						acc.querySelectorAll('details').forEach((other) => {
							if (other !== d) other.open = false;
						});
					}
				});
			});
		});
	})();
</script>
