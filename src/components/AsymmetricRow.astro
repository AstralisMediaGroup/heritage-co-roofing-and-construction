---
interface Props {
	heading: string;
	body?: string;
	bullets?: string[];
	photoSide?: 'left' | 'right';
	gradient?: string;
	aspect?: '4/5' | '3/2';
	ctaHref?: string;
	ctaLabel?: string;
}

const {
	heading,
	body,
	bullets = [],
	photoSide = 'left',
	gradient = 'linear-gradient(180deg, #6b8aa8 0%, #b8a78c 60%, #6b5d4a 100%)',
	aspect = '4/5',
	ctaHref,
	ctaLabel,
} = Astro.props;
---

<div class={`row row-${photoSide}`}>
	<div class="row-photo-wrap">
		<div class={`row-photo ratio-${aspect.replace('/', '-')}`} style={`background: ${gradient};`} aria-hidden="true"></div>
	</div>
	<div class="row-content">
		<h2 class="row-h">{heading}</h2>
		{body && <p class="row-body">{body}</p>}
		{bullets.length > 0 && (
			<ul class="row-bullets">
				{bullets.map((b) => <li>{b}</li>)}
			</ul>
		)}
		{ctaHref && ctaLabel && (
			<a href={ctaHref} class="row-cta">{ctaLabel}</a>
		)}
	</div>
</div>

<style>
	.row {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
		gap: 64px;
		align-items: center;
		max-width: 1100px;
		margin: 0 auto;
		padding: 56px 0;
	}
	.row-right { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); }
	.row-right .row-photo-wrap { order: 2; }
	.row-right .row-content { order: 1; }
	.row-photo-wrap {}
	.row-photo {
		width: 100%;
		border-radius: var(--radius-card);
		box-shadow: var(--shadow-subtle);
	}
	.row-photo.ratio-4-5 { aspect-ratio: 4 / 5; }
	.row-photo.ratio-3-2 { aspect-ratio: 3 / 2; }
	.row-content {}
	.row-h {
		color: #1a1a1a;
		font-size: 36px;
		font-weight: 600;
		letter-spacing: -0.8px;
		line-height: 1.1;
		margin: 0 0 20px;
	}
	.row-body {
		color: #5a5347;
		font-size: 17px;
		line-height: 1.6;
		margin: 0 0 20px;
		max-width: 520px;
	}
	.row-bullets {
		list-style: none;
		padding: 0;
		margin: 0 0 24px;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.row-bullets li {
		color: #1a1a1a;
		font-size: 15px;
		font-weight: 500;
		padding-left: 22px;
		position: relative;
	}
	.row-bullets li::before {
		content: '';
		position: absolute;
		left: 0; top: 8px;
		width: 8px; height: 8px;
		background: var(--rust);
		border-radius: var(--radius-pill);
	}
	.row-cta {
		display: inline-flex;
		align-items: center;
		padding: 14px 28px;
		background: var(--rust);
		color: var(--off-white);
		font-size: 15px;
		font-weight: 500;
		border-radius: var(--radius-pill);
		transition: background 150ms ease, box-shadow 150ms ease;
	}
	.row-cta:hover { background: #9d3a1a; box-shadow: var(--shadow-active); }
</style>
