---
import HeritagePlaceholder from './HeritagePlaceholder.astro';

interface Swatch {
	name: string;
	gradient: string;
}

interface Props {
	heading?: string;
	swatches?: Swatch[];
	placeholderFact?: string;
}

const defaultSwatches: Swatch[] = [
	{ name: 'Weathered Wood', gradient: 'linear-gradient(135deg, #6b5d4a 0%, #4a4239 100%)' },
	{ name: 'Charcoal', gradient: 'linear-gradient(135deg, #2a2a28 0%, #141413 100%)' },
	{ name: 'Driftwood', gradient: 'linear-gradient(135deg, #b8a78c 0%, #8a7d63 100%)' },
	{ name: 'Hickory', gradient: 'linear-gradient(135deg, #8a6f54 0%, #5a4836 100%)' },
	{ name: 'Slate', gradient: 'linear-gradient(135deg, #7d8b9e 0%, #4a5566 100%)' },
	{ name: 'Hunter Green', gradient: 'linear-gradient(135deg, #4a5a48 0%, #2a3528 100%)' },
];

const {
	heading = 'Color options',
	swatches = defaultSwatches,
	placeholderFact = 'Actual color names + hex values for the asphalt shingle line Heritage stocks (e.g. GAF Timberline HDZ Pewter Gray). The swatches above are stand-ins. See Founder Input page §2.',
} = Astro.props;
---

<div class="swatch-block">
	<p class="swatch-heading">{heading}</p>
	<div class="swatch-grid">
		{swatches.map((s) => (
			<div class="swatch">
				<div class="swatch-color" style={`background: ${s.gradient};`} aria-hidden="true"></div>
				<p class="swatch-name">{s.name}</p>
			</div>
		))}
	</div>
	<div class="swatch-placeholder">
		<HeritagePlaceholder fact={placeholderFact} />
	</div>
</div>

<style>
	.swatch-block {}
	.swatch-heading {
		color: #1a1a1a; font-size: 14px; font-weight: 600;
		margin: 0 0 20px; letter-spacing: 1px; text-transform: uppercase;
	}
	.swatch-grid {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: 16px;
	}
	.swatch { display: flex; flex-direction: column; gap: 10px; }
	.swatch-color {
		aspect-ratio: 5 / 4;
		width: 100%;
		border: 1px solid #ece7de;
		border-radius: var(--radius-card);
	}
	.swatch-name {
		color: #5a5347; font-size: 12px; font-weight: 500;
		margin: 0; line-height: 1.4;
	}
	.swatch-placeholder { margin-top: 20px; }
</style>
