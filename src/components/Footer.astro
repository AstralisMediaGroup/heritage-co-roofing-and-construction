---
import { attribution } from '../content/imagery';
import FooterDirectory from './FooterDirectory.astro';
---

<FooterDirectory />

<div class="footer">
	<div class="container footer-row">
		<p class="footer-text">© Heritage Co. Roofing & Construction · Locally owned · East Texas + Central Arkansas</p>
		<p class="footer-attribution">{attribution.footer}</p>
	</div>
</div>

<style>
	.footer {
		background: var(--ink-bg);
		padding: 28px 0;
		border-top: 1px solid rgba(255,255,255,0.08);
	}
	.footer-row {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.footer-text { color: var(--ink-bg-mute); font-size: 13px; }
	.footer-attribution { color: var(--ink-bg-mute); font-size: 11px; opacity: 0.6; }
</style>
