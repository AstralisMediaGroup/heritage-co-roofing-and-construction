---
import { attribution } from '../content/imagery';
import FooterDirectory from './FooterDirectory.astro';

interface Props {
	ctaHeading?: string;
	ctaSub?: string;
	ctaButton?: string;
}

const {
	ctaHeading = 'Ready for a free roof inspection?',
	ctaSub = 'No obligation. Same-day or next-day quote.',
	ctaButton = 'Schedule online',
} = Astro.props;
---

<FooterDirectory />

<div class="footer-cta" id="inspection">
	<h2 class="footer-cta-h">{ctaHeading}</h2>
	<p class="footer-cta-sub">{ctaSub}</p>
	<div class="footer-cta-row">
		<button class="footer-cta-btn" type="button">{ctaButton}</button>
		<a class="footer-phone-btn" href="tel:9032428102">Call 903-242-8102</a>
	</div>
</div>

<div class="footer">
	<p class="footer-text">HERITAGE Co. ROOFING & CONSTRUCTION · Locally owned · East Texas + Central Arkansas</p>
	<p class="footer-attribution">{attribution.footer}</p>
</div>

<style>
	.footer-cta { background: #1a1a1a; padding: 80px 48px; text-align: center; }
	.footer-cta-h {
		color: #faf8f4;
		font-size: 36px;
		font-weight: 600;
		margin: 0 0 16px;
		letter-spacing: -0.8px;
		line-height: 1.15;
	}
	.footer-cta-sub { color: #d8d2c2; font-size: 16px; margin: 0 0 32px; }
	.footer-cta-row { display: flex; gap: 18px; justify-content: center; align-items: center; }
	.footer-cta-btn {
		background: #b54620;
		color: #faf8f4;
		padding: 16px 32px;
		font-size: 15px;
		font-weight: 500;
		border-radius: var(--radius-pill);
		transition: background 150ms ease, box-shadow 150ms ease;
	}
	.footer-cta-btn:hover { background: #9d3a1a; box-shadow: var(--shadow-active); }
	.footer-phone-btn {
		color: #faf8f4;
		padding: 14px 26px;
		font-size: 15px;
		font-weight: 500;
		border: 2px solid #faf8f4;
		border-radius: var(--radius-pill);
		transition: background 150ms ease, color 150ms ease;
	}
	.footer-phone-btn:hover { background: #faf8f4; color: #1a1a1a; }

	.footer {
		background: #1a1a1a;
		padding: 32px 48px;
		text-align: center;
		border-top: 1px solid #2a2a28;
	}
	.footer-text { color: #8a8580; font-size: 13px; }
	.footer-attribution { color: #8a8580; font-size: 11px; margin: 8px 0 0; opacity: 0.75; }
</style>
