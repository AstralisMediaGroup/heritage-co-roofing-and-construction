---
import HeritagePlaceholder from './HeritagePlaceholder.astro';

interface SpecRow {
	label: string;
	value: string;
}

interface Material {
	id: string;
	name: string;
	intro: string;
	gradient: string;
	imageSrc?: string;
	imageAlt?: string;
	specs: SpecRow[];
	manufacturerPlaceholder?: string;
}

interface Props {
	materials: Material[];
}

const { materials } = Astro.props;
---

<div class="tabs" data-material-tabs>
	<div class="tabs-bar" role="tablist" aria-label="Roofing materials">
		{materials.map((m, i) => (
			<button
				type="button"
				role="tab"
				class={`tab-btn ${i === 0 ? 'is-active' : ''}`}
				data-tab-target={m.id}
				aria-selected={i === 0 ? 'true' : 'false'}
				aria-controls={`panel-${m.id}`}
				id={`tab-${m.id}`}
			>{m.name}</button>
		))}
	</div>
	<div class="tabs-panels">
		{materials.map((m, i) => (
			<section
				class={`tab-panel ${i === 0 ? 'is-active' : ''}`}
				role="tabpanel"
				aria-labelledby={`tab-${m.id}`}
				id={`panel-${m.id}`}
				data-tab-panel={m.id}
			>
				<div class="tab-grid">
					<div class="tab-photo" style={m.imageSrc ? '' : `background: ${m.gradient};`} aria-hidden={m.imageSrc ? undefined : 'true'}>
						{m.imageSrc && <img src={m.imageSrc} alt={m.imageAlt || ''} loading="lazy" />}
					</div>
					<div class="tab-body">
						<h3 class="tab-name">{m.name}</h3>
						<p class="tab-intro">{m.intro}</p>
						<dl class="tab-specs">
							{m.specs.map((s) => (
								<div class="tab-spec-row">
									<dt class="tab-spec-label">{s.label}</dt>
									<dd class="tab-spec-value">{s.value}</dd>
								</div>
							))}
						</dl>
						{m.manufacturerPlaceholder && (
							<div class="tab-manufacturer">
								<HeritagePlaceholder fact={m.manufacturerPlaceholder} />
							</div>
						)}
					</div>
				</div>
			</section>
		))}
	</div>
</div>

<style>
	.tabs { width: 100%; max-width: 1100px; margin: 0 auto; }
	.tabs-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		padding: 6px;
		background: var(--ivory-tint);
		border: 1px solid var(--border);
		border-radius: var(--radius-pill);
		margin: 0 auto 32px;
		width: fit-content;
	}
	.tab-btn {
		padding: 12px 24px;
		font-size: 14px;
		font-weight: 500;
		color: var(--charcoal);
		background: transparent;
		border: 0;
		border-radius: var(--radius-pill);
		cursor: pointer;
		transition: background 150ms ease, color 150ms ease;
	}
	.tab-btn:hover { background: rgba(26,26,26,0.06); }
	.tab-btn.is-active {
		background: var(--charcoal);
		color: var(--off-white);
	}

	/* Default: all panels visible (no-JS fallback) */
	.tab-panel { padding: 32px 0; border-bottom: 1px solid var(--border); }
	.tab-panel:last-child { border-bottom: 0; }

	/* JS-enabled state: only active panel visible */
	.tabs.js-enabled .tab-panel { display: none; padding: 0; border-bottom: 0; }
	.tabs.js-enabled .tab-panel.is-active { display: block; }

	.tab-grid {
		display: grid;
		grid-template-columns: 5fr 6fr;
		gap: 40px;
		align-items: start;
	}
	.tab-photo {
		aspect-ratio: 4 / 3;
		border-radius: var(--radius-large);
		box-shadow: var(--shadow-subtle);
		overflow: hidden;
	}
	.tab-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
	.tab-body {}
	.tab-name {
		color: var(--charcoal);
		font-size: 28px; font-weight: 600;
		letter-spacing: -0.5px;
		margin: 0 0 12px;
		line-height: 1.15;
	}
	.tab-intro {
		color: var(--warm-gray);
		font-size: 16px;
		line-height: 1.6;
		margin: 0 0 24px;
	}
	.tab-specs {
		display: flex; flex-direction: column;
		border-top: 1px solid var(--border);
	}
	.tab-spec-row {
		display: grid; grid-template-columns: 140px 1fr;
		gap: 16px; padding: 12px 0;
		border-bottom: 1px solid var(--border);
	}
	.tab-spec-label {
		color: var(--charcoal); font-size: 12px; font-weight: 600;
		letter-spacing: 1px; text-transform: uppercase;
		padding-top: 2px;
	}
	.tab-spec-value { color: var(--warm-gray); font-size: 14px; line-height: 1.5; margin: 0; }
	.tab-manufacturer { margin-top: 16px; }
</style>

<script is:inline>
	(function () {
		const containers = document.querySelectorAll('[data-material-tabs]');
		containers.forEach((c) => {
			c.classList.add('js-enabled');
			const buttons = c.querySelectorAll('[data-tab-target]');
			const panels = c.querySelectorAll('[data-tab-panel]');
			buttons.forEach((btn) => {
				btn.addEventListener('click', () => {
					const target = btn.getAttribute('data-tab-target');
					buttons.forEach((b) => {
						const isMatch = b.getAttribute('data-tab-target') === target;
						b.classList.toggle('is-active', isMatch);
						b.setAttribute('aria-selected', isMatch ? 'true' : 'false');
					});
					panels.forEach((p) => {
						p.classList.toggle('is-active', p.getAttribute('data-tab-panel') === target);
					});
				});
			});
		});
	})();
</script>
