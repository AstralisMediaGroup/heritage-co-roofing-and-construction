---
interface Item {
	q: string;
	a: string;
}
interface Props {
	items: Item[];
}
const { items } = Astro.props;
---

<div class="faq-accordion">
	{items.map((item, i) => (
		<details class="faq-item" name="faq-page">
			<summary>
				<span class="faq-q">{item.q}</span>
				<span class="faq-icon" aria-hidden="true">
					<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
				</span>
			</summary>
			<div class="faq-a" set:html={item.a} />
		</details>
	))}
</div>

<style>
	.faq-accordion { display: flex; flex-direction: column; }
	.faq-item {
		border-top: 1px solid var(--rule);
	}
	.faq-item:last-child { border-bottom: 1px solid var(--rule); }
	.faq-item summary {
		list-style: none;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 24px;
		padding: 28px 0;
		cursor: pointer;
		color: var(--ink);
		font-weight: 600;
		font-size: clamp(18px, 1.6vw, 22px);
		letter-spacing: -0.012em;
		line-height: 1.3;
	}
	.faq-item summary::-webkit-details-marker { display: none; }
	.faq-q { flex: 1; }
	.faq-icon {
		width: 36px;
		height: 36px;
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: var(--r-pill);
		border: 1px solid var(--rule-strong);
		color: var(--ink);
		transition: transform 240ms ease, background 200ms ease, color 200ms ease;
	}
	.faq-item[open] .faq-icon {
		transform: rotate(45deg);
		background: var(--rust);
		color: var(--bg);
		border-color: var(--rust);
	}
	.faq-a {
		padding: 0 0 28px;
		color: var(--ink-2);
		font-size: 16px;
		line-height: 1.7;
		max-width: 760px;
	}
	.faq-a p + p { margin-top: 12px; }
</style>
