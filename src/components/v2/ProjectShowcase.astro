---
import type { ImageRef } from '../../content/imagery';

interface Project {
	photo: ImageRef;
	heading?: string;
	caption?: string;
}
interface Props {
	projects: Project[];
	group?: string;
}
const { projects, group = 'project-showcase' } = Astro.props;
---

<div class="project-showcase">
	{projects.map((p, i) => (
		<button
			class={`project-card ratio-${i % 4}`}
			type="button"
			data-lightbox-trigger
			data-lightbox-src={p.photo.url || ''}
			data-lightbox-alt={p.photo.alt}
			data-lightbox-caption={p.caption || p.photo.alt}
			data-lightbox-group={group}
		>
			<div class="project-photo has-zoom-photo">
				{p.photo.url ? (
					<img src={p.photo.url} alt={p.photo.alt} loading="lazy" class="zoom-photo" />
				) : (
					<div class="project-fallback" />
				)}
			</div>
			{(p.heading || p.caption) && (
				<div class="project-meta">
					{p.heading && <p class="project-heading">{p.heading}</p>}
					{p.caption && <p class="project-caption">{p.caption}</p>}
				</div>
			)}
		</button>
	))}
</div>

<style>
	.project-showcase {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		grid-auto-rows: 14vw;
		gap: 12px;
	}
	.project-card {
		position: relative;
		display: block;
		text-align: left;
		background: transparent;
		padding: 0;
		cursor: zoom-in;
		grid-column: span 4;
		grid-row: span 2;
	}
	.project-card.ratio-1 { grid-column: span 5; grid-row: span 2; }
	.project-card.ratio-2 { grid-column: span 3; grid-row: span 2; }
	.project-card.ratio-3 { grid-column: span 4; grid-row: span 2; }

	.project-photo {
		width: 100%;
		height: 100%;
		overflow: hidden;
		background: var(--bg-deep);
	}
	.project-photo img { width: 100%; height: 100%; object-fit: cover; }
	.project-fallback { width: 100%; height: 100%; background: linear-gradient(135deg, #948c7d 0%, #5a5347 100%); }
	.project-meta {
		position: absolute;
		left: 16px;
		bottom: 16px;
		right: 16px;
		color: var(--bg);
		text-shadow: 0 2px 12px rgba(0,0,0,0.6);
	}
	.project-heading { font-size: 15px; font-weight: 600; }
	.project-caption { font-size: 12px; opacity: 0.85; margin-top: 4px; }
	@media (max-width: 880px) {
		.project-showcase { grid-template-columns: repeat(6, 1fr); grid-auto-rows: 24vw; }
		.project-card,
		.project-card.ratio-1,
		.project-card.ratio-2,
		.project-card.ratio-3 { grid-column: span 3; grid-row: span 1; }
	}
</style>
