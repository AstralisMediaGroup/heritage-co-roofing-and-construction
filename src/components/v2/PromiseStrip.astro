---
interface Props {
	items: string[];
	tone?: 'light' | 'dark';
}
const { items, tone = 'light' } = Astro.props;
---

<div class={`promise-strip tone-${tone}`}>
	{items.map((item, i) => (
		<span class="promise-item">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
			<span>{item}</span>
		</span>
	))}
</div>

<style>
	.promise-strip {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 12px 28px;
		font-size: 14px;
		color: var(--ink-2);
		font-weight: 500;
	}
	.promise-item { display: inline-flex; align-items: center; gap: 8px; }
	.promise-item svg { color: var(--rust); flex-shrink: 0; }
	.tone-dark .promise-item { color: var(--ink-bg-text); }
</style>
