---
import type { ImageRef } from '../../content/imagery';

interface Props {
	heading: string;
	lede?: string;
	primaryCta?: { label: string; href: string };
	secondaryCta?: { label: string; href: string };
	photo?: ImageRef;
}
const { heading, lede, primaryCta = { label: 'Get my free inspection', href: '/free-inspection' }, secondaryCta = { label: 'Call 903-242-8102', href: 'tel:9032428102' }, photo } = Astro.props;
---

<section class="page-cta">
	<div class="page-cta-photo">
		{photo?.url ? (
			<img src={photo.url} alt={photo.alt} loading="lazy" />
		) : (
			<div class="page-cta-fallback" />
		)}
		<div class="page-cta-overlay" />
	</div>
	<div class="container page-cta-inner">
		<div class="page-cta-text">
			<h2 class="display page-cta-h" set:html={heading} />
			{lede && <p class="page-cta-lede">{lede}</p>}
			<div class="page-cta-row">
				{primaryCta && <a class="btn btn-primary" href={primaryCta.href}>{primaryCta.label}</a>}
				{secondaryCta && <a class="btn btn-ghost-light" href={secondaryCta.href}>{secondaryCta.label}</a>}
			</div>
		</div>
	</div>
</section>

<style>
	.page-cta {
		position: relative;
		min-height: 64vh;
		display: flex;
		align-items: center;
		color: var(--bg);
		isolation: isolate;
	}
	.page-cta-photo {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		background: var(--ink-bg);
	}
	.page-cta-photo img { width: 100%; height: 100%; object-fit: cover; }
	.page-cta-fallback {
		width: 100%; height: 100%;
		background: linear-gradient(135deg, #2a2826 0%, #4a4a48 100%);
	}
	.page-cta-overlay {
		position: absolute; inset: 0;
		background:
			linear-gradient(120deg, rgba(21,20,15,0.85) 0%, rgba(21,20,15,0.55) 60%, rgba(21,20,15,0.35) 100%);
	}
	.page-cta-inner {
		position: relative;
		z-index: 1;
		padding-top: clamp(80px, 9vw, 140px);
		padding-bottom: clamp(80px, 9vw, 140px);
	}
	.page-cta-text { max-width: 740px; }
	.page-cta-h { color: var(--bg); font-size: clamp(48px, 6vw, 92px); }
	.page-cta-lede {
		color: var(--bg);
		opacity: 0.92;
		font-size: clamp(17px, 1.4vw, 21px);
		line-height: 1.5;
		margin-top: 24px;
		max-width: 600px;
	}
	.page-cta-row { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 36px; }
</style>
