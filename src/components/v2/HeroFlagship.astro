---
import type { ImageRef } from '../../content/imagery';

interface Props {
	eyebrow?: string;
	heading: string;
	lede?: string;
	primaryCta?: { label: string; href: string };
	secondaryCta?: { label: string; href: string };
	photo: ImageRef;
	bullets?: string[];
}

const { eyebrow, heading, lede, primaryCta, secondaryCta, photo, bullets = [] } = Astro.props;
---

<section class="hero-flagship">
	<div class="hero-photo" aria-hidden={photo.url ? 'true' : undefined}>
		{photo.url ? (
			<img src={photo.url} alt={photo.alt} loading="eager" fetchpriority="high" />
		) : (
			<div class="hero-photo-fallback" />
		)}
		<div class="hero-overlay" />
	</div>
	<div class="hero-inner container">
		<div class="hero-content">
			{eyebrow && <p class="eyebrow hero-eyebrow">{eyebrow}</p>}
			<h1 class="display hero-h1" set:html={heading} />
			{lede && <p class="hero-lede">{lede}</p>}
			{bullets.length > 0 && (
				<ul class="hero-bullets">
					{bullets.map((b) => (
						<li>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
							<span>{b}</span>
						</li>
					))}
				</ul>
			)}
			{(primaryCta || secondaryCta) && (
				<div class="hero-cta-row">
					{primaryCta && <a class="btn btn-primary" href={primaryCta.href}>{primaryCta.label}</a>}
					{secondaryCta && <a class="btn btn-ghost-light" href={secondaryCta.href}>{secondaryCta.label}</a>}
				</div>
			)}
		</div>
	</div>
	<div class="hero-photo-credit">
		{photo.photographer && <span>Photo · {photo.photographer} / Unsplash</span>}
		{photo.manufacturer && <span>Photo · {photo.manufacturer}</span>}
	</div>
</section>

<style>
	.hero-flagship {
		position: relative;
		min-height: 92vh;
		display: flex;
		align-items: flex-end;
		color: var(--ink-bg-text);
		isolation: isolate;
		margin-bottom: 0;
	}
	.hero-photo {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		background: var(--ink-bg);
	}
	.hero-photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}
	.hero-photo-fallback {
		width: 100%;
		height: 100%;
		background: linear-gradient(180deg, #4a4a48 0%, #6b5d4a 60%, #2a2826 100%);
	}
	.hero-overlay {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgba(21,20,15,0.45) 0%, rgba(21,20,15,0.35) 40%, rgba(21,20,15,0.85) 100%),
			linear-gradient(90deg, rgba(21,20,15,0.65) 0%, rgba(21,20,15,0.10) 70%);
	}
	.hero-inner {
		position: relative;
		z-index: 1;
		padding-top: 180px;
		padding-bottom: clamp(56px, 7vw, 96px);
	}
	.hero-content {
		max-width: 920px;
	}
	.hero-eyebrow {
		color: var(--bg);
		opacity: 0.85;
		margin-bottom: 24px;
	}
	.hero-h1 {
		color: var(--bg);
	}
	.hero-lede {
		color: var(--bg);
		opacity: 0.92;
		font-size: clamp(18px, 1.6vw, 22px);
		line-height: 1.45;
		max-width: 640px;
		margin-top: 28px;
	}
	.hero-bullets {
		list-style: none;
		margin-top: 28px;
		display: flex;
		flex-wrap: wrap;
		gap: 12px 28px;
	}
	.hero-bullets li {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--bg);
		font-size: 15px;
		font-weight: 500;
	}
	.hero-bullets svg { color: var(--rust); flex-shrink: 0; }
	.hero-cta-row {
		display: flex;
		gap: 14px;
		flex-wrap: wrap;
		margin-top: 36px;
	}
	.hero-photo-credit {
		position: absolute;
		bottom: 16px;
		right: 24px;
		z-index: 2;
		font-size: 11px;
		color: rgba(255,255,255,0.5);
		letter-spacing: 0.04em;
	}
	@media (max-width: 900px) {
		.hero-flagship { min-height: 78vh; }
		.hero-inner { padding-top: 140px; }
	}
</style>
