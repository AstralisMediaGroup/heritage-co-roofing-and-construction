---
interface Item { label: string; }
interface Props {
	items: Item[];
	speedSeconds?: number;
	tone?: 'light' | 'dark';
}
const { items, speedSeconds = 60, tone = 'light' } = Astro.props;
const doubled = [...items, ...items];
---

<section class={`trust-marquee tone-${tone}`} aria-label="Credentials and trust signals">
	<div class="trust-marquee-inner">
		<div class="trust-track" style={`--duration: ${speedSeconds}s;`}>
			{doubled.map((item) => (
				<span class="trust-item">{item.label}</span>
			))}
		</div>
	</div>
</section>

<style>
	.trust-marquee {
		padding: 28px 0;
		border-top: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
		overflow: hidden;
	}
	.trust-marquee-inner {
		overflow: hidden;
		mask-image: linear-gradient(90deg, transparent 0%, black 8%, black 92%, transparent 100%);
		-webkit-mask-image: linear-gradient(90deg, transparent 0%, black 8%, black 92%, transparent 100%);
	}
	.trust-track {
		display: inline-flex;
		gap: 56px;
		white-space: nowrap;
		animation: marquee-scroll var(--duration) linear infinite;
	}
	.trust-item {
		font-size: 14px;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--ink-2);
	}
	.trust-item::before {
		content: '✦';
		display: inline-block;
		margin-right: 56px;
		color: var(--rust);
		opacity: 0.7;
	}
	.trust-item:first-child::before { display: none; }
	.tone-dark { background: var(--ink-bg); border-color: rgba(255,255,255,0.08); }
	.tone-dark .trust-item { color: var(--ink-bg-mute); }
	@media (prefers-reduced-motion: reduce) {
		.trust-track { animation: none; }
	}
	.trust-marquee-inner:hover .trust-track { animation-play-state: paused; }
</style>
