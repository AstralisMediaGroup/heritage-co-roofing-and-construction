---
interface Review {
	quote: string;
	name: string;
	city: string;
	rating?: number;
	project?: string;
}
interface Props {
	reviews: Review[];
}
const { reviews } = Astro.props;
---

<div class="review-block">
	{reviews.map((r) => (
		<figure class="review-card">
			<div class="review-stars" aria-label={`${r.rating ?? 5} star rating`}>
				{Array.from({ length: r.rating ?? 5 }).map(() => (
					<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
				))}
			</div>
			<blockquote class="review-quote">"{r.quote}"</blockquote>
			<figcaption class="review-cite">
				<span class="review-name">{r.name}</span>
				<span class="review-meta">{r.city}{r.project ? ` · ${r.project}` : ''}</span>
			</figcaption>
		</figure>
	))}
</div>

<style>
	.review-block {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: clamp(24px, 3vw, 48px);
	}
	.review-card {
		display: flex;
		flex-direction: column;
		padding-top: 28px;
		border-top: 1px solid var(--rule-strong);
	}
	.review-stars { display: inline-flex; gap: 2px; color: var(--rust); margin-bottom: 16px; }
	.review-quote {
		font-size: clamp(18px, 1.5vw, 22px);
		line-height: 1.45;
		color: var(--ink);
		font-weight: 500;
		letter-spacing: -0.012em;
		margin-bottom: 24px;
		flex: 1;
	}
	.review-cite { display: flex; flex-direction: column; gap: 4px; }
	.review-name { font-size: 14px; font-weight: 600; color: var(--ink); }
	.review-meta { font-size: 13px; color: var(--ink-3); }
	@media (max-width: 880px) {
		.review-block { grid-template-columns: 1fr; gap: 32px; }
	}
</style>
