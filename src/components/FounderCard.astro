---
interface Props {
	name: string;
	role: string;
	cred: string;
	bio?: string;
}

const { name, role, cred, bio } = Astro.props;
---

<div class="founder">
	<div class="founder-photo" aria-hidden="true"></div>
	<p class="founder-name">{name}</p>
	<p class="founder-role">{role}</p>
	<p class="founder-cred" set:html={cred}></p>
	{bio && <p class="founder-bio">{bio}</p>}
</div>

<style>
	.founder { text-align: center; }
	.founder-photo {
		width: 100%; aspect-ratio: 1;
		background: linear-gradient(135deg, #6b5d4a 0%, #4a4239 100%);
		margin-bottom: 18px;
	}
	.founder-name {
		color: #1a1a1a; font-size: 19px; font-weight: 600;
		margin: 0 0 4px; line-height: 1.2;
	}
	.founder-role { color: #5a5347; font-size: 14px; margin: 0 0 8px; }
	.founder-cred { color: #5a5347; font-size: 13px; line-height: 1.5; margin: 0; }
	.founder-bio {
		color: #5a5347; font-size: 14px; line-height: 1.6;
		margin: 16px 0 0; text-align: left;
	}
</style>
