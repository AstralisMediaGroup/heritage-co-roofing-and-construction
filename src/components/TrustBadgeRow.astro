---
import HeritagePlaceholder from './HeritagePlaceholder.astro';

interface Badge {
	label: string;
	sub?: string;
	monogram?: string;
}

interface Props {
	heading?: string;
	badges?: Badge[];
	placeholderFact?: string;
}

const defaultBadges: Badge[] = [
	{ label: 'BBB Accredited', sub: 'A+ rating', monogram: 'BBB' },
	{ label: 'GAF Master Elite', sub: 'Manufacturer cert', monogram: 'GAF' },
	{ label: 'Owens Corning Platinum', sub: 'Manufacturer cert', monogram: 'OC' },
	{ label: 'NRCA Member', sub: 'Industry assoc.', monogram: 'NRCA' },
];

const {
	heading = 'Accreditations',
	badges = defaultBadges,
	placeholderFact = 'Replace the badges below with the real list — only show the ones Heritage actually holds. Remove any that do not apply. See Founder Input page §2.',
} = Astro.props;
---

<div class="row">
	{heading && <p class="row-eyebrow">{heading}</p>}
	<div class="row-track">
		{badges.map((b) => (
			<div class="row-badge">
				<div class="row-monogram" aria-hidden="true">{b.monogram || b.label.slice(0, 3).toUpperCase()}</div>
				<div class="row-text">
					<span class="row-label">{b.label}</span>
					{b.sub && <span class="row-sub">{b.sub}</span>}
				</div>
			</div>
		))}
	</div>
	<div class="row-placeholder">
		<HeritagePlaceholder fact={placeholderFact} />
	</div>
</div>

<style>
	.row {}
	.row-eyebrow {
		color: #b54620;
		font-size: 13px;
		font-weight: 500;
		margin: 0 0 20px;
		letter-spacing: 1px;
		text-transform: uppercase;
		text-align: center;
	}
	.row-track {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 16px;
		max-width: 1100px;
		margin: 0 auto;
	}
	.row-badge {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 18px 22px;
		background: #ffffff;
		border: 1px solid #ece7de;
		border-radius: var(--radius-card);
		box-shadow: var(--shadow-subtle);
	}
	.row-monogram {
		flex-shrink: 0;
		width: 48px; height: 48px;
		background: var(--charcoal);
		color: var(--off-white);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.5px;
		border-radius: var(--radius-card);
	}
	.row-text { display: flex; flex-direction: column; gap: 2px; }
	.row-label { color: #1a1a1a; font-size: 14px; font-weight: 600; letter-spacing: -0.1px; }
	.row-sub { color: #5a5347; font-size: 12px; }
	.row-placeholder { max-width: 1100px; margin: 20px auto 0; }
</style>
