---
// Aesthetic placeholder treatment.
// Visually distinct enough that founders can scan and find them on the live
// site, but not a glaring code-error block. Reads like an editor's "TK" mark
// in a print proof — branded, intentional, soft.

interface Props {
	fact: string;
	inline?: boolean;
}

const { fact, inline = false } = Astro.props;
---

{inline ? (
	<span class="ph ph-inline" role="note" aria-label="Heritage to provide">
		<span class="ph-dot" aria-hidden="true"></span>
		<span class="ph-fact">{fact}</span>
	</span>
) : (
	<div class="ph ph-block" role="note" aria-label="Heritage to provide">
		<span class="ph-rule" aria-hidden="true"></span>
		<div class="ph-body">
			<span class="ph-tag">
				<span class="ph-tag-dot" aria-hidden="true"></span>
				to provide
			</span>
			<p class="ph-fact">{fact}</p>
		</div>
	</div>
)}

<style>
	/* Block variant — soft tinted card, thin rust accent, italic copy */
	.ph-block {
		display: flex;
		gap: 0;
		background: rgba(181, 70, 32, 0.04);
		border: 1px solid rgba(181, 70, 32, 0.18);
		border-radius: var(--radius-card);
		overflow: hidden;
		margin: 12px 0;
	}
	.ph-rule {
		width: 3px;
		background: var(--rust);
		flex-shrink: 0;
	}
	.ph-body {
		flex: 1;
		padding: 14px 18px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.ph-tag {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 1.5px;
		text-transform: uppercase;
		color: var(--rust);
		opacity: 0.9;
	}
	.ph-tag-dot {
		display: inline-block;
		width: 5px; height: 5px;
		background: var(--rust);
		border-radius: var(--radius-pill);
	}
	.ph-block .ph-fact {
		color: var(--charcoal);
		font-size: 14px;
		font-style: italic;
		font-weight: 400;
		line-height: 1.55;
		margin: 0;
		opacity: 0.78;
	}

	/* Inline variant — single rust dot prefix + italic warm-gray text */
	.ph-inline {
		display: inline-flex;
		align-items: baseline;
		gap: 6px;
		color: var(--rust);
		font-size: 0.92em;
		font-style: italic;
		opacity: 0.85;
		padding: 0 4px;
		border-bottom: 1px dashed rgba(181, 70, 32, 0.4);
	}
	.ph-dot {
		display: inline-block;
		width: 5px; height: 5px;
		background: var(--rust);
		border-radius: var(--radius-pill);
		flex-shrink: 0;
		transform: translateY(-1px);
	}
	.ph-inline .ph-fact {
		font-style: italic;
		font-weight: 400;
	}

	/* When sitting on charcoal/dark backgrounds */
	:global(.warranty-dark) .ph-block,
	:global(.systems-island) .ph-block {
		background: rgba(181, 70, 32, 0.10);
		border-color: rgba(181, 70, 32, 0.32);
	}
	:global(.warranty-dark) .ph-block .ph-fact,
	:global(.systems-island) .ph-block .ph-fact {
		color: var(--off-white);
		opacity: 0.85;
	}
</style>
