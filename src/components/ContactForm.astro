---
// Placeholder submit form. No real endpoint. Submit replaces the form with
// a HeritagePlaceholder confirmation noting the destination needs to be wired.
import HeritagePlaceholder from './HeritagePlaceholder.astro';
---

<form class="cf" data-contact-form aria-label="Free inspection request">
	<div class="cf-row cf-row-2">
		<label class="cf-field">
			<span class="cf-label">Name</span>
			<input type="text" name="name" required placeholder="Your full name" autocomplete="name" />
		</label>
		<label class="cf-field">
			<span class="cf-label">Phone</span>
			<input type="tel" name="phone" required placeholder="903-555-0100" autocomplete="tel" />
		</label>
	</div>
	<div class="cf-row cf-row-2">
		<label class="cf-field">
			<span class="cf-label">Email</span>
			<input type="email" name="email" required placeholder="you@example.com" autocomplete="email" />
		</label>
		<label class="cf-field">
			<span class="cf-label">ZIP code</span>
			<input type="text" name="zip" required placeholder="75701" pattern="\d{5}" autocomplete="postal-code" />
		</label>
	</div>
	<fieldset class="cf-field cf-fieldset">
		<legend class="cf-label">Property type</legend>
		<div class="cf-radio-row">
			<label class="cf-radio">
				<input type="radio" name="propertyType" value="residential" checked />
				<span>Residential</span>
			</label>
			<label class="cf-radio">
				<input type="radio" name="propertyType" value="commercial" />
				<span>Commercial</span>
			</label>
		</div>
	</fieldset>
	<fieldset class="cf-field cf-fieldset">
		<legend class="cf-label">Service interest <span class="cf-hint">(check all that apply)</span></legend>
		<div class="cf-checkbox-grid">
			<label class="cf-checkbox"><input type="checkbox" name="service" value="replacement" /><span>Roof replacement</span></label>
			<label class="cf-checkbox"><input type="checkbox" name="service" value="repair" /><span>Roof repair</span></label>
			<label class="cf-checkbox"><input type="checkbox" name="service" value="inspection" /><span>Inspection</span></label>
			<label class="cf-checkbox"><input type="checkbox" name="service" value="storm" /><span>Storm damage / insurance claim</span></label>
			<label class="cf-checkbox"><input type="checkbox" name="service" value="gutters" /><span>Gutters</span></label>
			<label class="cf-checkbox"><input type="checkbox" name="service" value="skylights" /><span>Skylights</span></label>
			<label class="cf-checkbox"><input type="checkbox" name="service" value="ventilation" /><span>Attic ventilation</span></label>
			<label class="cf-checkbox"><input type="checkbox" name="service" value="chimney" /><span>Chimney flashing</span></label>
			<label class="cf-checkbox"><input type="checkbox" name="service" value="commercial" /><span>Commercial system</span></label>
			<label class="cf-checkbox"><input type="checkbox" name="service" value="other" /><span>Other / not sure yet</span></label>
		</div>
	</fieldset>
	<fieldset class="cf-field cf-fieldset">
		<legend class="cf-label">Preferred contact</legend>
		<div class="cf-radio-row">
			<label class="cf-radio"><input type="radio" name="preferredContact" value="phone" checked /><span>Phone</span></label>
			<label class="cf-radio"><input type="radio" name="preferredContact" value="email" /><span>Email</span></label>
		</div>
	</fieldset>
	<label class="cf-field">
		<span class="cf-label">Brief description <span class="cf-hint">(optional)</span></span>
		<textarea name="description" rows="4" placeholder="Tell us what you're seeing — leak location, age of roof, recent storm, etc."></textarea>
	</label>
	<button type="submit" class="cf-submit">Send request</button>
</form>

<div class="cf-confirmation" data-cf-confirmation hidden>
	<HeritagePlaceholder fact="Form submission destination — wire to email / CRM / Formspree before launch. Confirmation message currently fakes-success client-side only; no real submission happens. See Founder Input page §11." />
	<p class="cf-confirmation-note">
		The form submitted on your end. Until launch, the destination is not yet wired —
		<a href="tel:9032428102">call 903-242-8102</a> for an immediate response.
	</p>
</div>

<style>
	.cf { display: flex; flex-direction: column; gap: 24px; max-width: 720px; }
	.cf-row { display: flex; gap: 24px; }
	.cf-row-2 > * { flex: 1; }
	.cf-field { display: flex; flex-direction: column; gap: 8px; }
	.cf-fieldset { border: 0; padding: 0; margin: 0; }
	.cf-label {
		color: var(--charcoal);
		font-size: 13px; font-weight: 600;
		letter-spacing: 0.3px;
		text-transform: uppercase;
	}
	.cf-hint {
		color: var(--warm-gray);
		font-size: 12px; font-weight: 400;
		text-transform: none;
		letter-spacing: 0;
		margin-left: 6px;
	}
	.cf input[type="text"],
	.cf input[type="tel"],
	.cf input[type="email"],
	.cf textarea {
		padding: 12px 14px;
		font-size: 15px;
		font-family: inherit;
		color: var(--charcoal);
		background: #ffffff;
		border: 1px solid var(--border);
		border-radius: var(--radius-input);
		transition: border-color 150ms ease, box-shadow 150ms ease;
	}
	.cf input:focus, .cf textarea:focus {
		outline: none;
		border-color: var(--charcoal);
		box-shadow: 0 0 0 3px rgba(26,26,26,0.08);
	}
	.cf-radio-row { display: flex; gap: 24px; flex-wrap: wrap; padding-top: 4px; }
	.cf-radio, .cf-checkbox {
		display: inline-flex; align-items: center; gap: 8px;
		font-size: 14px; color: var(--charcoal);
		cursor: pointer;
	}
	.cf-checkbox-grid {
		display: grid; grid-template-columns: 1fr 1fr;
		gap: 10px 24px;
		padding-top: 4px;
	}
	.cf-submit {
		align-self: flex-start;
		padding: 16px 36px;
		background: var(--rust); color: var(--off-white);
		font-size: 15px; font-weight: 500;
		border-radius: var(--radius-pill);
		border: 0;
		cursor: pointer;
		transition: background 150ms ease, transform 200ms ease, box-shadow 150ms ease;
	}
	.cf-submit:hover { background: #9d3a1a; box-shadow: var(--shadow-active); transform: translateY(-1px); }
	.cf-confirmation { max-width: 720px; }
	.cf-confirmation-note {
		color: var(--warm-gray);
		font-size: 14px; line-height: 1.6;
		margin: 16px 0 0;
	}
	.cf-confirmation-note a { color: var(--rust); border-bottom: 1px solid var(--rust); }
</style>

<script is:inline>
	(function () {
		const form = document.querySelector('[data-contact-form]');
		const confirmation = document.querySelector('[data-cf-confirmation]');
		if (!form || !confirmation) return;
		form.addEventListener('submit', (e) => {
			e.preventDefault();
			form.style.display = 'none';
			confirmation.removeAttribute('hidden');
			confirmation.scrollIntoView({ behavior: 'smooth', block: 'start' });
		});
	})();
</script>
