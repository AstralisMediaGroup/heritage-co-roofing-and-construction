---
interface Props {
	heading: string;
	body?: string;
	gradient?: string;
	eyebrow?: string;
	ctaHref?: string;
	ctaLabel?: string;
}

const {
	heading,
	body,
	gradient = 'linear-gradient(180deg, #6b8aa8 0%, #b8a78c 60%, #6b5d4a 100%)',
	eyebrow,
	ctaHref,
	ctaLabel,
} = Astro.props;
---

<div class="layered">
	<div class="layered-photo" style={`background: ${gradient};`} aria-hidden="true"></div>
	<div class="layered-content">
		{eyebrow && <p class="layered-eyebrow">{eyebrow}</p>}
		<h3 class="layered-h">{heading}</h3>
		{body && <p class="layered-body">{body}</p>}
		<slot />
		{ctaHref && ctaLabel && (
			<a href={ctaHref} class="layered-cta">{ctaLabel}</a>
		)}
	</div>
</div>

<style>
	.layered {
		position: relative;
		max-width: 1000px;
		margin: 0 auto;
		padding-bottom: 80px;
	}
	.layered-photo {
		width: 75%;
		aspect-ratio: 16 / 9;
		border-radius: var(--radius-large);
		box-shadow: var(--shadow-subtle);
	}
	.layered-content {
		position: absolute;
		right: 0;
		bottom: 0;
		width: 55%;
		background: #ffffff;
		border: 1px solid #ece7de;
		border-radius: var(--radius-large);
		box-shadow: var(--shadow-active);
		padding: 36px 40px;
	}
	.layered-eyebrow {
		color: #b54620;
		font-size: 13px;
		font-weight: 500;
		letter-spacing: 1px;
		text-transform: uppercase;
		margin: 0 0 12px;
	}
	.layered-h {
		color: #1a1a1a;
		font-size: 28px;
		font-weight: 600;
		letter-spacing: -0.5px;
		line-height: 1.15;
		margin: 0 0 14px;
	}
	.layered-body {
		color: #5a5347;
		font-size: 15px;
		line-height: 1.6;
		margin: 0 0 20px;
	}
	.layered-cta {
		display: inline-flex;
		align-items: center;
		padding: 12px 24px;
		background: var(--charcoal);
		color: var(--off-white);
		font-size: 14px;
		font-weight: 500;
		border-radius: var(--radius-pill);
		transition: background 150ms ease;
	}
	.layered-cta:hover { background: var(--rust); }
</style>
