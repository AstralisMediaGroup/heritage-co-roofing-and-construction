---
import HeritagePlaceholder from './HeritagePlaceholder.astro';

interface Props {
	caption?: string;
	beforeGradient?: string;
	afterGradient?: string;
	placeholderFact?: string;
}

const {
	caption,
	beforeGradient = 'linear-gradient(180deg, #6b5d4a 0%, #4a4239 60%, #2a2a28 100%)',
	afterGradient = 'linear-gradient(180deg, #8fa8c0 0%, #c4b89e 50%, #8a6f54 100%)',
	placeholderFact = 'Before/after photo pair from a real Heritage job — same roof, same angle, before storm/repair vs. after install. Permission required. See Founder Input page §10.',
} = Astro.props;
---

<figure class="ba">
	<div class="ba-pair">
		<div class="ba-side">
			<div class="ba-photo" style={`background: ${beforeGradient};`} aria-hidden="true">
				<span class="ba-tag">Before</span>
			</div>
		</div>
		<div class="ba-side">
			<div class="ba-photo" style={`background: ${afterGradient};`} aria-hidden="true">
				<span class="ba-tag">After</span>
			</div>
		</div>
	</div>
	{caption && <figcaption class="ba-caption">{caption}</figcaption>}
	<div class="ba-placeholder">
		<HeritagePlaceholder fact={placeholderFact} />
	</div>
</figure>

<style>
	.ba { margin: 0; }
	.ba-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
	.ba-side { position: relative; }
	.ba-photo {
		aspect-ratio: 1 / 1;
		width: 100%;
		position: relative;
		border-radius: var(--radius-card);
		overflow: hidden;
	}
	.ba-tag {
		position: absolute;
		left: 12px;
		bottom: 12px;
		padding: 6px 12px;
		background: rgba(26,26,26,0.78);
		color: #faf8f4;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 1.5px;
		text-transform: uppercase;
	}
	.ba-caption {
		color: #5a5347;
		font-size: 14px;
		line-height: 1.5;
		margin: 16px 0 0;
		text-align: center;
	}
	.ba-placeholder { margin-top: 12px; }
</style>
