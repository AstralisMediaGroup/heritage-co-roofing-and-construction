---
// Erie-style 3-column technical-feature block. No cards, no backgrounds —
// just rust line-art icon + bold title + body paragraph. Each feature describes
// industry-generic roofing facts (Class 4 impact, ice & water shield, etc.) so
// no Heritage-specific claim gets invented.

interface Feature {
	icon: 'shield' | 'wind' | 'sun' | 'water' | 'layers' | 'gauge' | 'wrench' | 'check' | 'flame' | 'ruler' | 'bolt' | 'compass';
	title: string;
	body: string;
}

interface Props {
	features: Feature[];
	heading?: string;
	sub?: string;
	eyebrow?: string;
	columns?: 2 | 3 | 4;
}

const {
	features,
	heading,
	sub,
	eyebrow,
	columns = 3,
} = Astro.props;
---

<div class="tech">
	{(eyebrow || heading || sub) && (
		<div class="tech-intro">
			{eyebrow && <p class="tech-eyebrow">{eyebrow}</p>}
			{heading && <h2 class="tech-h">{heading}</h2>}
			{sub && <p class="tech-sub">{sub}</p>}
		</div>
	)}
	<div class="tech-grid" style={`--cols: ${columns};`}>
		{features.map((f) => (
			<div class="tech-feature">
				<div class="tech-icon" aria-hidden="true">
					{f.icon === 'shield' && (
						<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4l10 4v8c0 6-4 11-10 12-6-1-10-6-10-12V8l10-4z" /><path d="M11 16l4 4 7-7" /></svg>
					)}
					{f.icon === 'wind' && (
						<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11h17a4 4 0 1 0-4-4" /><path d="M3 16h22a4 4 0 1 1-4 4" /><path d="M3 21h13" /></svg>
					)}
					{f.icon === 'sun' && (
						<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="16" r="5" /><path d="M16 3v3M16 26v3M3 16h3M26 16h3M6.3 6.3l2.1 2.1M23.6 23.6l2.1 2.1M6.3 25.7l2.1-2.1M23.6 8.4l2.1-2.1" /></svg>
					)}
					{f.icon === 'water' && (
						<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4l8 11a8 8 0 1 1-16 0l8-11z" /></svg>
					)}
					{f.icon === 'layers' && (
						<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4l12 6-12 6L4 10l12-6z" /><path d="M4 16l12 6 12-6" /><path d="M4 22l12 6 12-6" /></svg>
					)}
					{f.icon === 'gauge' && (
						<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 22a11 11 0 1 1 22 0" /><path d="M16 16l5-3" /><circle cx="16" cy="16" r="1.5" fill="currentColor" stroke="none" /></svg>
					)}
					{f.icon === 'wrench' && (
						<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 4a6 6 0 0 0-6 8l-9 9a3 3 0 0 0 4 4l9-9a6 6 0 0 0 8-6l-3 3-3-1-1-3 3-3z" /></svg>
					)}
					{f.icon === 'check' && (
						<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="16" r="12" /><path d="M11 16l4 4 7-8" /></svg>
					)}
					{f.icon === 'flame' && (
						<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4c2 4 6 6 6 11a6 6 0 1 1-12 0c0-3 2-5 3-7 1 2 2 3 3 4 0-3-1-6 0-8z" /></svg>
					)}
					{f.icon === 'ruler' && (
						<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 16l12-12 12 12-12 12L4 16z" /><path d="M9 16l3 3M14 11l3 3M19 16l3 3" /></svg>
					)}
					{f.icon === 'bolt' && (
						<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 3l-9 16h6l-2 10 9-16h-6l2-10z" /></svg>
					)}
					{f.icon === 'compass' && (
						<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="16" r="12" /><path d="M21 11l-3 8-8 3 3-8 8-3z" /></svg>
					)}
				</div>
				<h3 class="tech-title">{f.title}</h3>
				<p class="tech-body">{f.body}</p>
			</div>
		))}
	</div>
</div>

<style>
	.tech {
		max-width: 1200px;
		margin: 0 auto;
	}
	.tech-intro {
		max-width: 720px;
		margin: 0 0 56px;
	}
	.tech-eyebrow {
		color: var(--rust);
		font-size: 13px; font-weight: 500;
		letter-spacing: 1px; text-transform: uppercase;
		margin: 0 0 16px;
	}
	.tech-h {
		color: var(--charcoal);
		font-size: 36px; font-weight: 600;
		letter-spacing: -0.8px; line-height: 1.15;
		margin: 0 0 16px;
	}
	.tech-sub {
		color: var(--warm-gray);
		font-size: 17px; line-height: 1.6;
		margin: 0;
	}

	.tech-grid {
		display: grid;
		grid-template-columns: repeat(var(--cols, 3), 1fr);
		gap: 56px 48px;
	}
	.tech-feature {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.tech-icon {
		color: var(--rust);
		width: 32px; height: 32px;
		display: inline-flex;
		align-items: center;
		justify-content: flex-start;
	}
	.tech-icon svg { width: 100%; height: 100%; }
	.tech-title {
		color: var(--charcoal);
		font-size: 22px; font-weight: 600;
		letter-spacing: -0.4px; line-height: 1.2;
		margin: 0;
	}
	.tech-body {
		color: var(--warm-gray);
		font-size: 15px; line-height: 1.65;
		margin: 0;
	}
</style>
