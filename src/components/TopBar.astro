<div class="top-bar">
	<div class="container top-bar-inner">
		<span class="top-locale">Locally owned · East Texas + Central Arkansas</span>
		<a class="top-phone" href="tel:9032428102">
			<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.33 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
			</svg>
			Call us direct: 903-242-8102
		</a>
	</div>
</div>

<style>
	.top-bar {
		background: var(--ink-bg);
		color: var(--bg);
	}
	.top-bar-inner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 11px;
		padding-bottom: 11px;
		font-size: 12px;
	}
	.top-locale {
		opacity: 0.75;
		letter-spacing: 0.02em;
	}
	.top-phone {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-weight: 500;
		color: var(--bg);
	}
	.top-phone:hover { color: var(--rust); }
	.top-phone svg { color: var(--rust); }
	@media (max-width: 700px) {
		.top-locale { display: none; }
		.top-bar-inner { justify-content: center; }
	}
</style>
