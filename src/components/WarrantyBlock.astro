---
import HeritagePlaceholder from './HeritagePlaceholder.astro';

interface WarrantyCard {
	label: string;
	fact: string;
}

interface Props {
	heading?: string;
	sub?: string;
	theme?: 'light' | 'dark';
	cards?: WarrantyCard[];
}

const defaultCards: WarrantyCard[] = [
	{ label: 'Workmanship warranty', fact: 'Workmanship warranty length on residential installs (years). State as a single sentence. See Founder Input page §1.' },
	{ label: 'Material warranty', fact: 'Manufacturer pass-through warranty (which manufacturer, how long, transferable on home sale Y/N). See Founder Input page §1.' },
	{ label: 'Named guarantee', fact: 'Branded one-line guarantee phrase if Heritage has one. If not, leave this card off — do not invent one. See Founder Input page §1.' },
	{ label: 'Money-back / satisfaction', fact: 'Money-back or satisfaction guarantee (Y/N + conditions). See Founder Input page §1.' },
];

const {
	heading = 'What every Heritage Co. roof comes with.',
	sub,
	theme = 'light',
	cards = defaultCards,
} = Astro.props;
---

<section class={`warranty warranty-${theme}`}>
	<p class={`section-eyebrow ${theme === 'dark' ? 'on-dark' : ''}`}>The warranty</p>
	<h2 class={`section-h ${theme === 'dark' ? 'on-dark' : ''}`}>{heading}</h2>
	{sub && <p class={`section-sub ${theme === 'dark' ? 'on-dark' : ''}`}>{sub}</p>}
	<div class="warranty-grid">
		{cards.map((c) => (
			<div class="warranty-card">
				<p class="warranty-label">{c.label}</p>
				<HeritagePlaceholder fact={c.fact} />
			</div>
		))}
	</div>
</section>

<style>
	.warranty { padding: 96px 48px; }
	.warranty-light { background: #ffffff; border-top: 1px solid #ece7de; }
	.warranty-dark { background: #1a1a1a; }

	.section-eyebrow {
		color: #b54620; font-size: 13px; font-weight: 500;
		text-align: center; margin: 0 0 16px;
		letter-spacing: 1px; text-transform: uppercase;
	}
	.section-h {
		color: #1a1a1a; font-size: 40px; font-weight: 600;
		text-align: center; margin: 0 0 16px;
		letter-spacing: -1px; line-height: 1.1;
	}
	.section-h.on-dark { color: #faf8f4; }
	.section-sub {
		color: #5a5347; font-size: 16px; text-align: center;
		margin: 0 auto 56px; max-width: 600px;
	}
	.section-sub.on-dark { color: #d8d2c2; }

	.warranty-grid {
		display: grid; grid-template-columns: repeat(2, 1fr);
		gap: 24px; max-width: 800px; margin: 56px auto 0;
	}
	.warranty-light .warranty-card {
		padding: 28px;
		background: #faf8f4;
		border: 1px solid #ece7de;
		border-radius: var(--radius-card);
		box-shadow: var(--shadow-subtle);
	}
	.warranty-dark .warranty-card {
		padding: 28px;
		background: rgba(250,248,244,0.04);
		border: 1px solid rgba(250,248,244,0.12);
		border-radius: var(--radius-card);
	}
	.warranty-label {
		color: #b54620; font-size: 12px; font-weight: 500;
		margin: 0 0 14px; letter-spacing: 1.5px; text-transform: uppercase;
	}
</style>
