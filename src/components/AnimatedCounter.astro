---
interface Props {
	to: number;
	prefix?: string;
	suffix?: string;
	duration?: number;
	class?: string;
}

const { to, prefix = '', suffix = '', duration = 1200, class: extraClass = '' } = Astro.props;
---

<span class={`counter ${extraClass}`} data-counter-to={to} data-counter-prefix={prefix} data-counter-suffix={suffix} data-counter-duration={duration}>
	<span data-counter-output>{prefix}{to}{suffix}</span>
</span>

<style>
	.counter { font-feature-settings: 'tnum'; display: inline-block; }
</style>

<script is:inline>
	(function () {
		const counters = document.querySelectorAll('[data-counter-to]');
		if (!counters.length) return;
		const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const animate = (el) => {
			const to = parseFloat(el.getAttribute('data-counter-to')) || 0;
			const prefix = el.getAttribute('data-counter-prefix') || '';
			const suffix = el.getAttribute('data-counter-suffix') || '';
			const duration = parseInt(el.getAttribute('data-counter-duration'), 10) || 1200;
			const out = el.querySelector('[data-counter-output]');
			if (!out) return;
			if (reduce) { out.textContent = prefix + Math.round(to) + suffix; return; }
			const start = performance.now();
			const step = (now) => {
				const t = Math.min(1, (now - start) / duration);
				const eased = 1 - Math.pow(1 - t, 3); // easeOutCubic
				const value = Math.round(eased * to);
				out.textContent = prefix + value + suffix;
				if (t < 1) requestAnimationFrame(step);
			};
			requestAnimationFrame(step);
		};
		if (typeof IntersectionObserver === 'undefined') {
			counters.forEach(animate);
			return;
		}
		const io = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					animate(entry.target);
					io.unobserve(entry.target);
				}
			});
		}, { threshold: 0.4 });
		counters.forEach((c) => io.observe(c));
	})();
</script>
