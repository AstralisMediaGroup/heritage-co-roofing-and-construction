---
import MaterialCard from './MaterialCard.astro';

interface SpecRow {
	label: string;
	value: string;
}

interface Material {
	name: string;
	intro: string;
	gradient: string;
	specs: SpecRow[];
	manufacturerPlaceholder?: string;
}

interface Props {
	materials: Material[];
}

const { materials } = Astro.props;
---

<div class="comparison">
	<div class="comparison-grid">
		{materials.map((m) => (
			<MaterialCard
				name={m.name}
				intro={m.intro}
				gradient={m.gradient}
				specs={m.specs}
				manufacturerPlaceholder={m.manufacturerPlaceholder}
			/>
		))}
	</div>
</div>

<style>
	.comparison-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
		max-width: 1200px;
		margin: 0 auto;
	}
</style>
