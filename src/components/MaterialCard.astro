---
import HeritagePlaceholder from './HeritagePlaceholder.astro';

interface SpecRow {
	label: string;
	value: string;
}

interface Props {
	name: string;
	intro: string;
	gradient: string;
	specs: SpecRow[];
	manufacturerPlaceholder?: string;
}

const { name, intro, gradient, specs, manufacturerPlaceholder } = Astro.props;
---

<article class="mat">
	<div class="mat-photo" style={`background: ${gradient};`} aria-hidden="true"></div>
	<div class="mat-body">
		<h3 class="mat-name">{name}</h3>
		<p class="mat-intro">{intro}</p>
		<dl class="mat-specs">
			{specs.map((s) => (
				<div class="mat-spec-row">
					<dt class="mat-spec-label">{s.label}</dt>
					<dd class="mat-spec-value">{s.value}</dd>
				</div>
			))}
		</dl>
		{manufacturerPlaceholder && (
			<div class="mat-manufacturer">
				<HeritagePlaceholder fact={manufacturerPlaceholder} />
			</div>
		)}
	</div>
</article>

<style>
	.mat {
		background: #ffffff;
		border: 1px solid #ece7de;
		overflow: hidden;
		border-radius: var(--radius-large);
		box-shadow: var(--shadow-subtle);
	}
	.mat-photo { aspect-ratio: 4 / 3; width: 100%; }
	.mat-body { padding: 28px; }
	.mat-name {
		color: #1a1a1a; font-size: 24px; font-weight: 600;
		margin: 0 0 10px; letter-spacing: -0.4px; line-height: 1.2;
	}
	.mat-intro { color: #5a5347; font-size: 15px; line-height: 1.6; margin: 0 0 20px; }
	.mat-specs {
		display: flex; flex-direction: column; gap: 0;
		border-top: 1px solid #ece7de;
	}
	.mat-spec-row {
		display: grid; grid-template-columns: 140px 1fr;
		gap: 16px;
		padding: 12px 0;
		border-bottom: 1px solid #ece7de;
	}
	.mat-spec-label {
		color: #1a1a1a; font-size: 12px; font-weight: 600;
		letter-spacing: 1px; text-transform: uppercase;
		padding-top: 2px;
	}
	.mat-spec-value { color: #5a5347; font-size: 14px; line-height: 1.5; margin: 0; }
	.mat-manufacturer { margin-top: 16px; }
</style>
