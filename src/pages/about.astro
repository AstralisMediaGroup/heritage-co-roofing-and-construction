---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPage from '../components/v2/HeroPage.astro';
import SectionHead from '../components/v2/SectionHead.astro';
import PromiseStrip from '../components/v2/PromiseStrip.astro';
import PhotoLede from '../components/v2/PhotoLede.astro';
import PhotoBleed from '../components/v2/PhotoBleed.astro';
import StatBand from '../components/v2/StatBand.astro';
import CrewBlock from '../components/v2/CrewBlock.astro';
import PageCTA from '../components/v2/PageCTA.astro';
import Reveal from '../components/v2/Reveal.astro';
import { imagery } from '../content/imagery';

const v2 = imagery.v2;
---

<BaseLayout
	title="About — Heritage Co. Roofing & Construction"
	description="Built by operators, not marketers. Heritage Co. is a locally-owned roofing company in East Texas and Central Arkansas. Headquartered in Longview, TX."
>
	<HeroPage
		eyebrow="About Heritage Co."
		heading="Built by operators,<br />not marketers."
		lede="Heritage Co. is locally owned and operated by four people whose names are on the about page and whose phones are on the call list. We don't outsource the inspection. We don't outsource the install. We don't outsource the warranty."
		primaryCta={{ label: 'Free inspection', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
		photo={v2.pageHeros.about}
		tier={2}
	/>

	<section class="page-section">
		<div class="container">
			<PromiseStrip items={['Locally owned + operated', 'Heritage Standard · 10-year workmanship', '4,000+ residential roofs', 'Headquartered in Longview, TX']} />
		</div>
	</section>

	<Reveal>
		<section class="page-section">
			<div class="container story-grid">
				<SectionHead
					eyebrow="The story"
					heading="Why Heritage exists."
				/>
				<div class="story-body">
					<p>Heritage Co. was started by people who'd worked in the roofing trade long enough to see what was wrong with how it was being done in East Texas. National chains buying up local shops, sending out commission-paid inspectors, pushing replacements that weren't necessary, disappearing after the install when something went wrong.</p>
					<p>We figured a region this size deserved a contractor that took its name seriously. Locally owned. Founders take calls. Crews live in the area. The work is being done by people who'll still be here in ten years.</p>
					<p>4,000+ residential roofs installed. 100,000+ square feet of commercial roof installed. The oldest roof on our books — installed in 2016 — is still on the house.</p>
					<p>The voice on this site is plainspoken on purpose. We don't write "industry-leading." We don't say "trusted partner." We say what we actually do, in the words a roofer would use, and we let the work speak for itself.</p>
				</div>
			</div>
		</section>
	</Reveal>

	<PhotoBleed
		photo={v2.bleeds.crew}
		heading="Same crew start to warranty.<br />The number on the site is the number we answer."
		caption="When you call, you get one of the four founders. Not a regional dispatcher, not a national CSR. The same person who books your inspection is on the ladder."
		overlay={true}
		heightVw={62}
	/>

	<CrewBlock heading="The four founders." eyebrow="Who you actually talk to" lede="The phone, the inspection, the install, and the warranty all run through the same four people. Same crew shows up if anything needs attention later." />

	<Reveal>
		<section class="page-section">
			<div class="container">
				<PhotoLede
					photo={v2.bleeds.workmanship}
					eyebrow="What we won't do"
					heading="No high-pressure close. No fabricated damage."
					body="Heritage's hard rule: we don't sell work that isn't needed. If your roof is fine, we tell you that and write a report saying so. The Founder Input page tracks our 'no-work-needed' inspection rate as a quality metric. Building a long-term reputation in a region this size means saying no to short-term revenue when it's the right call."
					bullets={['No commission-paid inspectors', "If the roof is fine, we say so", 'Founders are salaried, not chasing close rates']}
					photoSide="right"
				/>
			</div>
		</section>
	</Reveal>

	<Reveal>
		<section class="page-section">
			<div class="container">
				<PhotoLede
					photo={v2.bleeds.workmanship}
					eyebrow="The Heritage Standard"
					heading="What we stand behind."
					body="Heritage Standard is the named guarantee on every job. 10-year Heritage workmanship warranty on residential installs, manufacturer material warranties pass through to the homeowner, transferable once on resale, same warranty terms on storm-damage installs as a standard re-roof. Heritage carries general liability and our crews are covered by workers' comp."
					bullets={['10-year Heritage workmanship warranty', 'Material warranty transferable on home sale (1x)', 'Same warranty on storm-damage installs', 'Insured + workers\' comp covered']}
					photoSide="left"
				/>
			</div>
		</section>
	</Reveal>

	<StatBand stats={[
		{ value: '4,000+', label: 'Residential roofs installed', numericValue: 4000, suffix: '+' },
		{ value: '100k+', label: 'Sq ft commercial installed' },
		{ value: '2016', label: 'Oldest active install · still on the house' },
		{ value: '10 yr', label: 'Workmanship warranty · Heritage Standard' },
	]} />

	<PageCTA
		heading="Talk to the founders.<br />Not a call center."
		lede="Real person on the phone. Real person on the ladder. Real warranty when we're done."
		primaryCta={{ label: 'Get my free inspection', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
		photo={v2.pageHeros.freeInspection}
	/>
</BaseLayout>

<style>
	.page-section { padding: clamp(72px, 8vw, 128px) 0; }
	.story-grid {
		display: grid;
		grid-template-columns: 0.8fr 1fr;
		gap: clamp(32px, 5vw, 80px);
		align-items: start;
	}
	.story-body p {
		font-size: clamp(17px, 1.4vw, 19px);
		line-height: 1.65;
		color: var(--ink-2);
		max-width: 580px;
	}
	.story-body p + p { margin-top: 18px; }
	@media (max-width: 880px) {
		.story-grid { grid-template-columns: 1fr; gap: 32px; }
	}
</style>
