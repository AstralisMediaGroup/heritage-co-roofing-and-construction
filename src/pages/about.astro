---
import BaseLayout from '../layouts/BaseLayout.astro';
import FounderCard from '../components/FounderCard.astro';
import CertificationsBlock from '../components/CertificationsBlock.astro';
import WarrantyBlock from '../components/WarrantyBlock.astro';
import TrustBadgeRow from '../components/TrustBadgeRow.astro';
import AsymmetricRow from '../components/AsymmetricRow.astro';
import StatRow from '../components/StatRow.astro';
import LayeredCard from '../components/LayeredCard.astro';
import ConstrainedSection from '../components/ConstrainedSection.astro';
import FullBleedSection from '../components/FullBleedSection.astro';
import BleedingImage from '../components/BleedingImage.astro';
import HeritagePlaceholder from '../components/HeritagePlaceholder.astro';
import { founders } from '../content/founders';
---

<BaseLayout title="About Heritage Co. — Built by operators, not marketers.">
	<!-- Hero -->
	<section class="hero">
		<div class="hero-photo" aria-hidden="true"></div>
		<div class="hero-overlay" aria-hidden="true"></div>
		<div class="hero-content">
			<p class="hero-eyebrow">About Heritage Co.</p>
			<h1 class="hero-h1">Built by operators,<br />not marketers.</h1>
			<p class="hero-sub">
				Locally owned. Headquartered in Longview, Texas. Crews across East Texas and Central Arkansas. The four people who founded the company are the four people you talk to.
			</p>
		</div>
	</section>

	<!-- Bleeding image transition from hero to story -->
	<section class="bleed-bridge">
		<BleedingImage
			gradient="linear-gradient(180deg, #4a4a48 0%, #6b5d4a 100%)"
			aspect="21 / 9"
			bleed={120}
			maxWidth="900px"
		/>
	</section>

	<!-- Founding story — 2 asymmetric rows -->
	<section class="story">
		<p class="section-eyebrow">Why we built it</p>
		<h2 class="section-h">We did the work for someone else first.</h2>
		<AsymmetricRow
			heading="Years on East Texas roofs first."
			body="The four founders — Jordy, Peyton, Nishil, and Vivek — between them have years on East Texas roofs, years running commercial projects, and years running operations and finance. They started Heritage Co. to build a roofing company that answers the phone, stands behind its work, and is still 30 minutes away when you need it."
			photoSide="left"
			aspect="4/5"
			gradient="linear-gradient(180deg, #6b5d4a 0%, #4a4239 100%)"
		/>
		<div class="story-placeholder">
			<HeritagePlaceholder fact="Real founding story — actual year of founding, what triggered it (specific incident, gap in market, prior shop they left), where the four founders met, and the one or two sentences that capture why in their own words. 2–3 short paragraphs. See Founder Input page §7." />
		</div>
		<AsymmetricRow
			heading="What you can count on."
			body="The same name on the truck and the contract. The same crew on the install and the warranty visit. A number that goes to a person."
			bullets={["Locally owned and operated", "Crews live in the area they work", "Owner-direct line for warranty visits"]}
			photoSide="right"
			aspect="3/2"
			gradient="linear-gradient(180deg, #6b8aa8 0%, #b8a78c 60%, #6b5d4a 100%)"
		/>
	</section>

	<!-- Founders (inset card-on-card on ivory-tint) -->
	<section class="founders">
		<p class="section-eyebrow">Meet the team</p>
		<h2 class="section-h">The people answering your call.</h2>
		<p class="section-sub">Locally owned and operated. The role today is below; the paragraph each founder added is being filled in.</p>
		<div class="founders-inset">
			<div class="founders-grid">
				{founders.map((f) => (
					<FounderCard name={f.name} role={f.role} cred={f.cred} expectBio={true} />
				))}
			</div>
		</div>
	</section>

	<!-- FullBleed cinematic between founders and badges -->
	<FullBleedSection
		gradient="linear-gradient(180deg, #6b5d4a 0%, #4a4239 60%, #2a2a28 100%)"
		overlayPosition="bottom-right"
		minHeight="380px"
		overlayDarken={0.6}
	>
		<p class="fb-eyebrow">It is our name on the truck</p>
		<h2 class="fb-h">Operators on every job, not just on the website.</h2>
	</FullBleedSection>

	<!-- Quick-glance badges (TrustBadgeRow) -->
	<section class="badges">
		<TrustBadgeRow />
	</section>

	<!-- Stats -->
	<section class="stats-section">
		<StatRow stats={[
			{ label: 'Combined years', placeholderFact: 'Real total years roofing across the four founders. See Founder Input page §7.' },
			{ label: 'Roofs installed', placeholderFact: 'Lifetime residential roof count. See Founder Input page §5.' },
			{ label: 'Manufacturer certs', placeholderFact: 'Count of held manufacturer certifications (e.g. 3 — GAF + Owens Corning + CertainTeed). See Founder Input page §2.' },
			{ value: 'TX + AR', label: 'Service area' },
		]} />
	</section>

	<!-- Certifications detail -->
	<CertificationsBlock />

	<!-- Named guarantee callout -->
	<section class="guarantee-callout">
		<LayeredCard
			eyebrow="The guarantee"
			heading="What every Heritage Co. roof comes with."
			body="Workmanship from us. Manufacturer pass-through on the materials. Specific years and any branded guarantee phrase are in the warranty block below."
			gradient="linear-gradient(180deg, #6b5d4a 0%, #4a4239 100%)"
		/>
	</section>

	<WarrantyBlock theme="dark" />

	<!-- Constrained narrative before credentials band -->
	<ConstrainedSection background="ivory" paddingY="sm">
		<p class="cs-eyebrow">In one line</p>
		<h2 class="cs-h">A regional shop. The four founders on every contract.</h2>
	</ConstrainedSection>

	<!-- Credentials band -->
	<section class="creds">
		<p class="creds-text">
			Locally owned and operated. East Texas + Central Arkansas. <span class="creds-inline-placeholder"><HeritagePlaceholder inline={true} fact="real total years roofing across the four founders" /></span> on the roof between us.
		</p>
	</section>
</BaseLayout>

<style>
	/* Hero */
	.hero { position: relative; min-height: 480px; background: #1a1a1a; }
	.hero-photo {
		position: absolute; inset: 0;
		background: linear-gradient(180deg, #6b5d4a 0%, #4a4239 50%, #2a2a28 100%);
		opacity: 0.92;
	}
	.hero-overlay {
		position: absolute; inset: 0;
		background: linear-gradient(90deg, rgba(26,26,26,0.82) 0%, rgba(26,26,26,0.4) 60%, rgba(26,26,26,0.15) 100%);
	}
	.hero-content { position: relative; padding: 96px 48px 80px; max-width: 720px; }
	.hero-eyebrow {
		color: #b54620; font-size: 13px; font-weight: 500;
		margin: 0 0 20px; letter-spacing: 1px; text-transform: uppercase;
	}
	.hero-h1 {
		color: #faf8f4; font-size: 56px; font-weight: 600;
		line-height: 1.05; margin: 0 0 24px; letter-spacing: -1.8px;
	}
	.hero-sub {
		color: #d8d2c2; font-size: 17px; line-height: 1.55;
		margin: 0; max-width: 560px;
	}

	.section-eyebrow {
		color: #b54620; font-size: 13px; font-weight: 500;
		text-align: center; margin: 0 0 16px;
		letter-spacing: 1px; text-transform: uppercase;
	}
	.section-eyebrow.on-dark { color: #b54620; }
	.section-h {
		color: #1a1a1a; font-size: 40px; font-weight: 600;
		text-align: center; margin: 0 0 16px;
		letter-spacing: -1px; line-height: 1.1;
	}
	.section-h.on-dark { color: #faf8f4; }
	.section-sub {
		color: #5a5347; font-size: 16px; text-align: center;
		margin: 0 0 56px; max-width: 600px; margin-left: auto; margin-right: auto;
	}

	/* Story */
	.story { background: #faf8f4; padding: 96px 48px; }
	.story-placeholder { max-width: 1100px; margin: 24px auto; }

	/* Plan 006 helpers */
	.bleed-bridge { padding: 0 48px; background: #faf8f4; position: relative; z-index: 1; }
	.fb-eyebrow { color: var(--rust); font-size: 13px; font-weight: 500; letter-spacing: 1px; text-transform: uppercase; margin: 0 0 16px; }
	.fb-h { color: var(--off-white); font-size: 36px; font-weight: 600; letter-spacing: -0.8px; line-height: 1.15; margin: 0; max-width: 580px; }
	.cs-eyebrow { color: var(--rust); font-size: 13px; font-weight: 500; letter-spacing: 1px; text-transform: uppercase; margin: 0 0 14px; text-align: center; }
	.cs-h { color: var(--charcoal); font-size: 28px; font-weight: 600; letter-spacing: -0.5px; line-height: 1.2; margin: 0; text-align: center; }

	/* Founders (ivory-tint + inset card-on-card) */
	.founders { background: var(--ivory-tint); padding: 96px 48px; border-top: 1px solid #ece7de; }
	.founders-inset {
		max-width: 1040px;
		margin: 0 auto;
		padding: 48px;
		background: #ffffff;
		border: 1px solid #ece7de;
	}
	.founders-grid {
		display: grid; grid-template-columns: repeat(2, 1fr);
		gap: 48px;
	}

	/* Badges */
	.badges { padding: 64px 48px; background: #ffffff; border-top: 1px solid #ece7de; }
	.stats-section { padding: 80px 48px; background: var(--ivory-tint); border-top: 1px solid #ece7de; }
	.guarantee-callout { padding: 96px 48px; background: var(--ivory-tint); border-top: 1px solid #ece7de; }

	/* Credentials band */
	.creds { background: #faf8f4; padding: 56px 48px; text-align: center; border-top: 1px solid #ece7de; }
	.creds-text {
		color: #1a1a1a; font-size: 19px; font-weight: 600;
		max-width: 800px; margin: 0 auto;
		letter-spacing: -0.2px; line-height: 1.5;
	}
	.creds-inline-placeholder { display: inline-block; vertical-align: middle; }
</style>
