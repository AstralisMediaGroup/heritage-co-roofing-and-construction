---
import BaseLayout from '../layouts/BaseLayout.astro';
import RegionColumns from '../components/RegionColumns.astro';
---

<BaseLayout title="Service Areas — East Texas + Central Arkansas | Heritage Co.">
	<!-- Hero -->
	<section class="hero">
		<div class="hero-photo" aria-hidden="true"></div>
		<div class="hero-overlay" aria-hidden="true"></div>
		<div class="hero-content">
			<p class="hero-eyebrow">Service area</p>
			<h1 class="hero-h1">East Texas + Central Arkansas.</h1>
			<p class="hero-sub">
				Headquartered in Longview, TX. Crews live across two states. If you are inside our footprint, we can be on your roof same-day or next-day.
			</p>
		</div>
	</section>

	<!-- Map placeholder -->
	<section class="map">
		<div class="map-placeholder" aria-hidden="true"></div>
	</section>

	<!-- Regions -->
	<section class="regions">
		<p class="section-eyebrow">Where we work</p>
		<h2 class="section-h">Cities and towns we serve.</h2>
		<p class="section-sub">If your town is not on this list and you are nearby, call us anyway — we probably go there too.</p>
		<RegionColumns />
	</section>
</BaseLayout>

<style>
	/* Hero */
	.hero { position: relative; min-height: 440px; background: #1a1a1a; }
	.hero-photo {
		position: absolute; inset: 0;
		background: linear-gradient(180deg, #6b8aa8 0%, #b8a78c 60%, #6b5d4a 100%);
		opacity: 0.92;
	}
	.hero-overlay {
		position: absolute; inset: 0;
		background: linear-gradient(90deg, rgba(26,26,26,0.78) 0%, rgba(26,26,26,0.35) 60%, rgba(26,26,26,0.1) 100%);
	}
	.hero-content { position: relative; padding: 96px 48px 80px; max-width: 720px; }
	.hero-eyebrow {
		color: #b54620; font-size: 13px; font-weight: 500;
		margin: 0 0 20px; letter-spacing: 1px; text-transform: uppercase;
	}
	.hero-h1 {
		color: #faf8f4; font-size: 56px; font-weight: 600;
		line-height: 1.05; margin: 0 0 24px; letter-spacing: -1.8px;
	}
	.hero-sub {
		color: #d8d2c2; font-size: 17px; line-height: 1.55;
		margin: 0; max-width: 560px;
	}

	/* Map */
	.map { background: #faf8f4; padding: 64px 48px 0; }
	.map-placeholder {
		max-width: 1100px;
		margin: 0 auto;
		height: 360px;
		background: linear-gradient(135deg, #d8d2c2 0%, #b8a78c 50%, #8fa8c0 100%);
		border: 1px solid #ece7de;
	}

	/* Regions */
	.regions { background: #faf8f4; padding: 96px 48px; }
	.section-eyebrow {
		color: #b54620; font-size: 13px; font-weight: 500;
		text-align: center; margin: 0 0 16px;
		letter-spacing: 1px; text-transform: uppercase;
	}
	.section-h {
		color: #1a1a1a; font-size: 40px; font-weight: 600;
		text-align: center; margin: 0 0 16px;
		letter-spacing: -1px; line-height: 1.1;
	}
	.section-sub {
		color: #5a5347; font-size: 16px; text-align: center;
		margin: 0 0 56px; max-width: 600px; margin-left: auto; margin-right: auto;
	}
</style>
