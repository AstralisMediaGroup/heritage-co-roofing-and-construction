---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPage from '../components/v2/HeroPage.astro';
import SectionHead from '../components/v2/SectionHead.astro';
import PromiseStrip from '../components/v2/PromiseStrip.astro';
import CityList from '../components/v2/CityList.astro';
import PhotoBleed from '../components/v2/PhotoBleed.astro';
import StatBand from '../components/v2/StatBand.astro';
import PageCTA from '../components/v2/PageCTA.astro';
import Reveal from '../components/v2/Reveal.astro';
import { imagery } from '../content/imagery';

const v2 = imagery.v2;
---

<BaseLayout
	title="Service area — Heritage Co. Roofing & Construction"
	description="Heritage Co. roofs across East Texas and Central Arkansas. Headquartered in Longview, TX. 14+ cities, two states, one shop."
>
	<HeroPage
		eyebrow="Service area"
		heading="East Texas +<br />Central Arkansas."
		lede="Headquartered in Longview, TX. Crews across two states. 15 named cities below — service stretches further. If you're not sure we cover yours, call. We usually do."
		primaryCta={{ label: 'Free inspection', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
		photo={v2.pageHeros.serviceAreas}
		tier={2}
	/>

	<section class="page-section">
		<div class="container">
			<PromiseStrip items={['Same crew region-wide', 'Free inspections', 'Local crews — not regional dispatch']} />
		</div>
	</section>

	<Reveal>
		<section class="page-section">
			<div class="container">
				<SectionHead
					eyebrow="Coverage"
					heading="Where we work."
					lede="Authoritative city list below. Service stretches further than the named cities — call if yours isn't on the list."
					maxWidth="700px"
				/>
				<div class="cities-spacer">
					<CityList />
				</div>
			</div>
		</section>
	</Reveal>

	<PhotoBleed
		photo={v2.bleeds.crew}
		heading="HQ in Longview.<br />Crews in your zip code."
		caption="Drive times from Longview HQ: Tyler 30min · Marshall 30min · Kilgore 15min · Henderson 25min · Nacogdoches 1hr · Little Rock 3hr."
		overlay={true}
		heightVw={62}
	/>

	<StatBand stats={[
		{ value: '15', label: 'Named cities · East TX + Central AR', numericValue: 15 },
		{ value: '2', label: 'States · TX + AR', numericValue: 2 },
		{ value: 'Next day', label: 'Inspection turnaround · region-wide' },
		{ value: '0', label: 'Regional dispatchers · ever', numericValue: 0 },
	]} />

	<Reveal>
		<section class="page-section">
			<div class="container">
				<SectionHead
					eyebrow="Why local matters"
					heading="Local crews. Same crew on the warranty call."
					lede="Crews live in the same cities they service — no commission-paid sales reps driving in from a regional office, no out-of-state imports. Same crew that did the install shows up if anything needs attention later. Heritage Standard is the same in every city."
					maxWidth="820px"
				/>
			</div>
		</section>
	</Reveal>

	<PageCTA
		heading="Free inspection.<br />Anywhere in the service area."
		lede="Same-day or next-day in most cities. Real person on the ladder."
		primaryCta={{ label: 'Schedule online', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
		photo={v2.pageHeros.freeInspection}
	/>
</BaseLayout>

<style>
	.page-section { padding: clamp(72px, 8vw, 120px) 0; }
	.cities-spacer { margin-top: clamp(48px, 5vw, 80px); }
</style>
