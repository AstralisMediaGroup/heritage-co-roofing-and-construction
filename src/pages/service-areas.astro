---
import BaseLayout from '../layouts/BaseLayout.astro';
import RegionColumns from '../components/RegionColumns.astro';
import HeritagePlaceholder from '../components/HeritagePlaceholder.astro';
---

<BaseLayout title="Service Areas — East Texas + Central Arkansas | Heritage Co.">
	<!-- Hero -->
	<section class="hero">
		<div class="hero-photo" aria-hidden="true"></div>
		<div class="hero-overlay" aria-hidden="true"></div>
		<div class="hero-content">
			<p class="hero-eyebrow">Service area</p>
			<h1 class="hero-h1">East Texas + Central Arkansas.</h1>
			<p class="hero-sub">
				Headquartered in Longview, Texas. Crews across two states. If your town is on this page, we come to it.
			</p>
		</div>
	</section>

	<!-- Map -->
	<section class="map">
		<div class="map-placeholder" aria-hidden="true"></div>
		<HeritagePlaceholder fact="Static map asset (East Texas + Central Arkansas with HQ pin on Longview and any satellite-office pins). PNG/SVG, ~1100×360. See Founder Input page §10." />
	</section>

	<!-- Regions -->
	<section class="regions">
		<p class="section-eyebrow">Where we work</p>
		<h2 class="section-h">Cities and towns we serve.</h2>
		<p class="section-sub">If your town is not on the list and you are nearby, call us anyway. We probably go there too.</p>
		<RegionColumns />
	</section>

	<!-- Coverage + response time -->
	<section class="coverage">
		<p class="section-eyebrow">How fast we get there</p>
		<h2 class="section-h">Response times and how we cover the footprint.</h2>
		<div class="coverage-grid">
			<div class="coverage-item">
				<p class="coverage-label">Free inspection turnaround</p>
				<HeritagePlaceholder fact="Free-inspection SLA in plain words: same-day or next-day? 24 hours? Different by zip? See Founder Input page §8." />
			</div>
			<div class="coverage-item">
				<p class="coverage-label">Where the crews live</p>
				<HeritagePlaceholder fact="Cities crews actually live in (vs. cities crews drive to). Supports the 'crews live in your area' claim from the homepage. See Founder Input page §6." />
			</div>
			<div class="coverage-item">
				<p class="coverage-label">Travel charge / drive radius</p>
				<HeritagePlaceholder fact="Maximum drive radius before a travel charge kicks in (miles). Yes/no on travel charge for inside-footprint jobs. See Founder Input page §9." />
			</div>
			<div class="coverage-item">
				<p class="coverage-label">Satellite offices</p>
				<HeritagePlaceholder fact="Offices besides the Longview HQ — addresses if any. (Schulte has 5; Heritage has?) See Founder Input page §9." />
			</div>
			<div class="coverage-item">
				<p class="coverage-label">East Texas vs. Central Arkansas response</p>
				<HeritagePlaceholder fact="Same response-time SLA across both states, or different? If Arkansas is slower, what is realistic? See Founder Input page §9." />
			</div>
			<div class="coverage-item">
				<p class="coverage-label">Emergency / after-hours</p>
				<HeritagePlaceholder fact="Is 903-242-8102 the emergency line, or different? 24-hour response yes/no. See Founder Input page §11." />
			</div>
		</div>
	</section>

	<!-- HQ -->
	<section class="hq">
		<p class="hq-eyebrow">Headquarters</p>
		<p class="hq-h">Longview, Texas.</p>
		<HeritagePlaceholder fact="Full HQ mailing address — for footer, contact page, and Google Business listing. See Founder Input page §11." />
	</section>
</BaseLayout>

<style>
	/* Hero */
	.hero { position: relative; min-height: 440px; background: #1a1a1a; }
	.hero-photo {
		position: absolute; inset: 0;
		background: linear-gradient(180deg, #6b8aa8 0%, #b8a78c 60%, #6b5d4a 100%);
		opacity: 0.92;
	}
	.hero-overlay {
		position: absolute; inset: 0;
		background: linear-gradient(90deg, rgba(26,26,26,0.78) 0%, rgba(26,26,26,0.35) 60%, rgba(26,26,26,0.1) 100%);
	}
	.hero-content { position: relative; padding: 96px 48px 80px; max-width: 720px; }
	.hero-eyebrow {
		color: #b54620; font-size: 13px; font-weight: 500;
		margin: 0 0 20px; letter-spacing: 1px; text-transform: uppercase;
	}
	.hero-h1 {
		color: #faf8f4; font-size: 56px; font-weight: 600;
		line-height: 1.05; margin: 0 0 24px; letter-spacing: -1.8px;
	}
	.hero-sub {
		color: #d8d2c2; font-size: 17px; line-height: 1.55;
		margin: 0; max-width: 560px;
	}

	/* Map */
	.map { background: #faf8f4; padding: 64px 48px 0; }
	.map-placeholder {
		max-width: 1100px;
		margin: 0 auto 16px;
		height: 360px;
		background: linear-gradient(135deg, #d8d2c2 0%, #b8a78c 50%, #8fa8c0 100%);
		border: 1px solid #ece7de;
	}
	.map > :global(.placeholder) { max-width: 1100px; margin-left: auto; margin-right: auto; }

	/* Regions */
	.regions { background: #faf8f4; padding: 96px 48px; }
	.section-eyebrow {
		color: #b54620; font-size: 13px; font-weight: 500;
		text-align: center; margin: 0 0 16px;
		letter-spacing: 1px; text-transform: uppercase;
	}
	.section-h {
		color: #1a1a1a; font-size: 40px; font-weight: 600;
		text-align: center; margin: 0 0 16px;
		letter-spacing: -1px; line-height: 1.1;
	}
	.section-sub {
		color: #5a5347; font-size: 16px; text-align: center;
		margin: 0 auto 56px; max-width: 600px;
	}

	/* Coverage */
	.coverage { background: #ffffff; padding: 96px 48px; border-top: 1px solid #ece7de; }
	.coverage-grid {
		display: grid; grid-template-columns: repeat(2, 1fr);
		gap: 28px; max-width: 960px; margin: 0 auto;
	}
	.coverage-item { padding: 24px; background: #faf8f4; border: 1px solid #ece7de; }
	.coverage-label {
		color: #1a1a1a; font-size: 14px; font-weight: 600;
		margin: 0 0 12px; letter-spacing: -0.2px;
	}

	/* HQ */
	.hq { background: #1a1a1a; padding: 72px 48px; text-align: center; }
	.hq-eyebrow {
		color: #b54620; font-size: 13px; font-weight: 500;
		margin: 0 0 12px; letter-spacing: 1px; text-transform: uppercase;
	}
	.hq-h {
		color: #faf8f4; font-size: 32px; font-weight: 600;
		margin: 0 auto 20px; letter-spacing: -0.5px; max-width: 600px;
	}
	.hq > :global(.placeholder) { max-width: 600px; margin-left: auto; margin-right: auto; }
</style>
