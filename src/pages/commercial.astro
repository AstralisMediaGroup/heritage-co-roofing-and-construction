---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroFlagship from '../components/v2/HeroFlagship.astro';
import TrustMarquee from '../components/v2/TrustMarquee.astro';
import SectionHead from '../components/v2/SectionHead.astro';
import PromiseStrip from '../components/v2/PromiseStrip.astro';
import TileGrid from '../components/v2/TileGrid.astro';
import PhotoBleed from '../components/v2/PhotoBleed.astro';
import PhotoLede from '../components/v2/PhotoLede.astro';
import StatBand from '../components/v2/StatBand.astro';
import ProjectShowcase from '../components/v2/ProjectShowcase.astro';
import PageCTA from '../components/v2/PageCTA.astro';
import Reveal from '../components/v2/Reveal.astro';
import { imagery } from '../content/imagery';

const v2 = imagery.v2;

const systems = [
	{ heading: 'TPO', body: 'White, heat-welded, energy-reflective. The default for re-roofs in cooling-dominated buildings.', href: '/commercial/tpo-roofing', photo: v2.systemTiles.tpo, eyebrow: 'System' },
	{ heading: 'EPDM', body: 'Black rubber. The original single-ply. Cold-weather installable. Long-proven track record.', href: '/commercial/epdm-roofing', photo: v2.systemTiles.epdm, eyebrow: 'System' },
	{ heading: 'Modified bitumen', body: 'Multi-ply asphalt. Heavy-duty for foot-traffic and HVAC-dense roofs.', href: '/commercial/modified-bitumen-roofing', photo: v2.systemTiles.modBit, eyebrow: 'System' },
	{ heading: 'Metal', body: 'Standing seam. 40–60 year service life. The long-term answer.', href: '/commercial/metal-roofing', photo: v2.systemTiles.metal, eyebrow: 'System' },
	{ heading: 'Built-up (BUR)', body: 'Multi-ply asphalt + ballast. The classic. Still right for some buildings.', href: '/commercial/built-up-roofing', photo: v2.systemTiles.bur, eyebrow: 'System' },
	{ heading: 'Coatings + restorations', body: 'Silicone or acrylic over an existing roof. Buys 10–15 years on a sound deck.', href: '/commercial/roof-coatings-and-restorations', photo: v2.systemTiles.coatings, eyebrow: 'System' },
	{ heading: 'Maintenance programs', body: 'Annual inspection + repair contract. Protects warranties; cuts emergency calls.', href: '/commercial/maintenance-programs', photo: v2.systemTiles.maintenance, eyebrow: 'Program' },
];

// Named projects per Founder Input §5 — three Braum's PVC roofs on the books.
// Real Heritage install photography to follow once Founder Input §10 is supplied;
// captions are accurate today.
const projects = v2.projects.slice(0, 8).map((p, i) => ({
	photo: p,
	caption: [
		"Braum's · Longview, TX · PVC",
		"Braum's · Anna, AR · PVC",
		"Braum's · Clarksville, AR · PVC",
		'Standing seam metal, light commercial · Marshall, TX',
		'Multi-building TPO project, Longview, TX',
		'Built-up restoration, manufacturing',
		'TPO re-roof, retail · Tyler, TX',
		'Coating restoration, warehouse',
	][i] || p.alt,
}));
---

<BaseLayout
	title="Commercial roofing — Heritage Co. Roofing & Construction"
	description="Commercial roofing in East Texas and Central Arkansas. TPO, EPDM, metal, modified bitumen, built-up, coatings. Maintenance programs. Bonded and insured."
>
	<HeroFlagship
		eyebrow="Commercial roofing"
		heading="Every major<br />commercial system."
		lede="New construction, re-roofs, restoration, and maintenance for commercial buildings across East Texas and Central Arkansas. Bonded and insured."
		photo={v2.pageHeros.commercial}
		bullets={['TPO, EPDM, mod-bit, BUR, metal, coatings', 'Maintenance + roof asset management', 'Bonded + insured · workmanship warranty']}
		primaryCta={{ label: 'Request a quote', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
	/>

	<TrustMarquee items={v2.trustItems} />

	<Reveal>
		<section class="page-section">
			<div class="container">
				<PromiseStrip items={['GAF Master Elite · commercial', 'Insured + workers\' comp', 'Heritage Standard workmanship warranty', 'All major systems']} />
			</div>
		</section>
	</Reveal>

	<Reveal>
		<section class="page-section">
			<div class="container">
				<SectionHead
					eyebrow="Systems"
					heading="Seven systems. We tell you which one fits."
					lede="The right system for a commercial roof depends on the deck, the slope, the foot traffic, the building's remaining life, and the budget. We don't lead with the system that has our biggest margin."
					maxWidth="800px"
				/>
				<div class="grid-spacer">
					<TileGrid tiles={systems} cols={3} style="photo-card" />
				</div>
			</div>
		</section>
	</Reveal>

	<PhotoBleed
		photo={v2.bleeds.commercial}
		heading="Walkthrough, scope,<br />bid in a week."
		caption="Free roof assessment. Drone-aided where it makes sense. Honest answer on whether to recover, restore, or replace."
		overlay={true}
		heightVw={66}
	/>

	<Reveal>
		<section class="page-section">
			<div class="container">
				<PhotoLede
					photo={v2.systemTiles.maintenance}
					eyebrow="Maintenance"
					heading="Catch the leak before it's a leak."
					body="Annual inspection, twice-yearly for ballasted and TPO. Sealant maintenance, drain cleaning, and a written report. Protects manufacturer warranties; turns emergency calls into scheduled work."
					bullets={['Annual + biannual inspection cadence', 'Drone + thermal imaging where useful', 'Repair-first, replace-when-justified']}
					cta={{ label: 'Maintenance programs →', href: '/commercial/maintenance-programs' }}
					photoSide="right"
				/>
			</div>
		</section>
	</Reveal>

	<StatBand stats={[
		{ value: '100k+', label: 'Sq ft commercial installed' },
		{ value: '7', label: 'Commercial systems installed', numericValue: 7 },
		{ value: 'GAF', label: 'Master Elite · commercial certified' },
		{ value: '1 wk', label: 'Walkthrough → bid · typical' },
	]} />

	<Reveal>
		<section class="page-section">
			<div class="container">
				<SectionHead
					eyebrow="Named work"
					heading="Real Heritage commercial jobs."
					lede="Three Braum's PVC roofs across East Texas and Arkansas. More commercial projects on the books — drone-aided install photography lands once the project library is supplied."
					maxWidth="780px"
				/>
				<div class="grid-spacer">
					<ProjectShowcase projects={projects} group="commercial-projects" />
				</div>
			</div>
		</section>
	</Reveal>

	<PageCTA
		heading="Free commercial roof assessment.<br />Honest answer on what to do."
		lede="We tell you whether to restore, recover, or replace before we put a number to it."
		primaryCta={{ label: 'Request a walkthrough', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
		photo={v2.pageHeros.metalRoofing}
	/>
</BaseLayout>

<style>
	.page-section { padding: clamp(72px, 8vw, 128px) 0; }
	.grid-spacer { margin-top: clamp(48px, 5vw, 80px); }
</style>
