---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceTile from '../components/ServiceTile.astro';
import TrustStrip from '../components/TrustStrip.astro';
import NamedProjectCard from '../components/NamedProjectCard.astro';
import StatRow from '../components/StatRow.astro';
import LayeredCard from '../components/LayeredCard.astro';
import HeritagePlaceholder from '../components/HeritagePlaceholder.astro';

const services = [
	{ label: 'New construction', body: 'Single-source coordination from deck-up. Ground-up builds, on schedule.', gradient: 'linear-gradient(180deg, #7d8b9e 0%, #4a5566 100%)' },
	{ label: 'Re-roofs', body: 'Tear-off and replacement on existing buildings. Minimum tenant disruption.', gradient: 'linear-gradient(180deg, #4a4a48 0%, #6b5d4a 100%)' },
	{ label: 'Maintenance', body: 'Scheduled inspections and small repairs. Stops the leak before it starts.', gradient: 'linear-gradient(180deg, #c4b89e 0%, #8a7d63 100%)' },
	{ label: 'Repairs', body: 'Targeted fixes for known issues. Same-week response for active leaks.', gradient: 'linear-gradient(180deg, #8a6f54 0%, #5a4836 100%)' },
	{ label: 'Roof systems', body: 'TPO, EPDM, modified bitumen, metal, built-up, coatings. We spec to the building.', gradient: 'linear-gradient(180deg, #a8a89c 0%, #4a4a48 100%)' },
	{ label: 'Project portfolio', body: 'Past commercial work across schools, retail, healthcare, and industrial.', gradient: 'linear-gradient(180deg, #6b8aa8 0%, #4a5566 100%)' },
];

const systemsDetail = [
	{ name: 'TPO', body: 'Single-ply thermoplastic. Bright white, reflective, weldable seams. Standard for retail and warehouse re-roofs.' },
	{ name: 'EPDM', body: 'Single-ply rubber. Long service life, forgiving install. Common on flat commercial.' },
	{ name: 'Modified bitumen', body: 'Asphalt-based, multi-ply. Torch-down or self-adhered. Workhorse for institutional buildings.' },
	{ name: 'Metal', body: 'Standing seam, R-panel, structural. Long life, high wind ratings. Common on schools and ag.' },
	{ name: 'Built-up', body: 'Tar-and-gravel BUR systems. Older spec but still installed where the building calls for it.' },
	{ name: 'Coatings', body: 'Acrylic, silicone, urethane. Restoration over an existing roof to extend life and reflect heat.' },
];

const industries = [
	{ label: 'Schools', body: 'Districts and private. Summer-window installs.' },
	{ label: 'Healthcare', body: 'Clinics, MOBs, hospitals. Negative-pressure-aware.' },
	{ label: 'Retail', body: 'Strip centers, big-box, mixed-use.' },
	{ label: 'Industrial', body: 'Warehouses, manufacturing, distribution.' },
	{ label: 'Office', body: 'Class A, B, multi-tenant.' },
	{ label: 'Government', body: 'Municipal, county, federal. Bid-compliant.' },
];

const reRoofProcess = [
	{ n: '01', label: 'Walkthrough', body: 'On-roof survey with the facility manager. Photos, measurements, system options.' },
	{ n: '02', label: 'Spec + bid', body: 'Written scope, system rec, price. Bonded estimate ready for procurement.' },
	{ n: '03', label: 'Pre-construction', body: 'Tenant notice plan, staging, dumpster placement, working hours.' },
	{ n: '04', label: 'Tear-off + install', body: 'Phased on occupied buildings. We work around tenants, not over them.' },
	{ n: '05', label: 'Closeout', body: 'Final walk, warranty hand-off, manufacturer pass-through paperwork.' },
];
---

<BaseLayout
	title="Commercial Roofing — Heritage Co."
	ctaHeading="Need a quote on a commercial roof?"
	ctaSub="Walkthrough, scope, and pricing within the week."
	ctaButton="Request consultation"
>
	<!-- Hero -->
	<section class="hero">
		<div class="hero-photo" aria-hidden="true"></div>
		<div class="hero-overlay" aria-hidden="true"></div>
		<div class="hero-content">
			<p class="hero-eyebrow">For businesses</p>
			<h1 class="hero-h1">Roofs for your business.</h1>
			<p class="hero-sub">
				New construction, re-roofs, maintenance. Bonded and insured. All major roof systems, spec'd to the building and the budget.
			</p>
			<div class="hero-cta-row">
				<a class="cta-primary" href="/#inspection">Request quote</a>
				<a class="cta-secondary" href="tel:9032428102">Call 903-242-8102</a>
			</div>
		</div>
	</section>

	<!-- Service grid -->
	<section class="services">
		<p class="section-eyebrow">What we do</p>
		<h2 class="section-h">Commercial services.</h2>
		<p class="section-sub">From walkthrough to warranty, all under one roof.</p>
		<div class="service-grid">
			{services.map((s) => <ServiceTile label={s.label} body={s.body} photo={true} gradient={s.gradient} />)}
		</div>
	</section>

	<!-- Roof systems EXPANDED -->
	<section class="systems-detail">
		<p class="section-eyebrow on-dark">Roof systems</p>
		<h2 class="section-h on-dark">Six systems. We spec to the building.</h2>
		<p class="section-sub on-dark">Short read on each. The right system depends on slope, occupancy, climate, and budget — we walk through trade-offs at the inspection.</p>
		<div class="systems-grid">
			{systemsDetail.map((s) => (
				<div class="system-card">
					<p class="system-name">{s.name}</p>
					<p class="system-body">{s.body}</p>
				</div>
			))}
		</div>
		<div class="systems-cert">
			<HeritagePlaceholder fact="Manufacturer system certifications Heritage holds (e.g. Carlisle SureWeld, Firestone Red Shield, GAF EverGuard, Johns Manville Peak Advantage). Plain-text list. See Founder Input page §2." />
		</div>
	</section>

	<!-- Industries served (pill tags + caption rows) -->
	<section class="industries">
		<p class="section-eyebrow">Industries served</p>
		<h2 class="section-h">We've worked the building you're in.</h2>
		<p class="section-sub">Six common building types. Plenty of less common ones too.</p>
		<div class="industry-tags">
			{industries.map((i) => <span class="industry-tag">{i.label}</span>)}
		</div>
		<div class="industry-rows">
			{industries.map((i) => (
				<div class="industry-row">
					<span class="industry-row-label">{i.label}</span>
					<span class="industry-row-body">{i.body}</span>
				</div>
			))}
		</div>
	</section>

	<!-- Why Heritage for commercial — LayeredCard -->
	<section class="why-commercial">
		<LayeredCard
			eyebrow="Why Heritage for commercial"
			heading="Bonded, insured, and on the roof when the bid is awarded."
			body="Single-source coordination from walkthrough to closeout. We work around tenants, not over them. Procurement-ready paperwork, named system certifications, real bonding capacity — all in plain numbers below."
			gradient="linear-gradient(180deg, #7d8b9e 0%, #a8a89c 50%, #4a4a48 100%)"
			ctaHref="/#inspection"
			ctaLabel="Request consultation"
		/>
	</section>

	<!-- Stat row (commercial) -->
	<section class="stats">
		<StatRow stats={[
			{ label: 'Bonding (single)', placeholderFact: 'Single-project bonding capacity in dollars (e.g. $2M). See Founder Input page §3.' },
			{ label: 'GL coverage', placeholderFact: 'General liability per-occurrence limit. See Founder Input page §3.' },
			{ label: 'Years in business', placeholderFact: 'Year Heritage Co. was founded → years in business as of 2026. See Founder Input page §7.' },
			{ label: 'Sq ft installed', placeholderFact: 'Lifetime commercial sq ft installed. See Founder Input page §5.' },
		]} />
	</section>

	<!-- Bonding + insurance callout -->
	<section class="bonding">
		<p class="section-eyebrow">Bonding + insurance</p>
		<h2 class="section-h">The numbers procurement wants.</h2>
		<p class="section-sub">Plain answers for the bid form. Filled in by the founders.</p>
		<div class="bonding-grid">
			<div class="bonding-card">
				<p class="bonding-label">Bonding capacity (single)</p>
				<HeritagePlaceholder fact="Single-project bonding capacity (e.g. $2M). See Founder Input page §3." />
			</div>
			<div class="bonding-card">
				<p class="bonding-label">Bonding capacity (aggregate)</p>
				<HeritagePlaceholder fact="Aggregate bonding capacity. See Founder Input page §3." />
			</div>
			<div class="bonding-card">
				<p class="bonding-label">General liability</p>
				<HeritagePlaceholder fact="GL coverage limit per occurrence + aggregate. See Founder Input page §3." />
			</div>
			<div class="bonding-card">
				<p class="bonding-label">Umbrella</p>
				<HeritagePlaceholder fact="Umbrella policy limit. See Founder Input page §3." />
			</div>
			<div class="bonding-card">
				<p class="bonding-label">Workers' comp</p>
				<HeritagePlaceholder fact="Workers' comp carrier name. See Founder Input page §3." />
			</div>
			<div class="bonding-card">
				<p class="bonding-label">Roofing license #</p>
				<HeritagePlaceholder fact="Texas roofing license # and Arkansas equivalent if applicable. See Founder Input page §3." />
			</div>
		</div>
	</section>

	<!-- Re-roof process / tenant disruption -->
	<section class="reroof">
		<p class="section-eyebrow on-dark">How a re-roof runs</p>
		<h2 class="section-h on-dark">Five phases on an occupied building.</h2>
		<p class="section-sub on-dark">We tell tenants what to expect before we tell them to expect it.</p>
		<ol class="reroof-list">
			{reRoofProcess.map((p) => (
				<li class="reroof-step">
					<span class="reroof-n">{p.n}</span>
					<div class="reroof-body">
						<p class="reroof-label">{p.label}</p>
						<p class="reroof-text">{p.body}</p>
					</div>
				</li>
			))}
		</ol>
	</section>

	<!-- Named projects -->
	<section class="projects">
		<p class="section-eyebrow">Past projects</p>
		<h2 class="section-h">Buildings we've roofed.</h2>
		<p class="section-sub">Specific named projects with permission to publish go below. Until they are filled in, the placeholders show what's coming.</p>
		<div class="projects-grid">
			<NamedProjectCard placeholderFact="Named commercial project #1 — building or owner name, city, year, roof system, sq ft, industry. Permission required. See Founder Input page §5." />
			<NamedProjectCard placeholderFact="Named commercial project #2 — building or owner name, city, year, roof system, sq ft, industry. See Founder Input page §5." />
			<NamedProjectCard placeholderFact="Named commercial project #3 — building or owner name, city, year, roof system, sq ft, industry. See Founder Input page §5." />
			<NamedProjectCard placeholderFact="Named commercial project #4 — building or owner name, city, year, roof system, sq ft, industry. See Founder Input page §5." />
			<NamedProjectCard placeholderFact="Named commercial project #5 — building or owner name, city, year, roof system, sq ft, industry. See Founder Input page §5." />
		</div>
		<div class="projects-stats">
			<HeritagePlaceholder fact="Lifetime sq ft of commercial roof installed (number). Oldest active commercial roof Heritage installed (year + city). See Founder Input page §5." />
		</div>
	</section>

	<!-- Maintenance contracts -->
	<section class="maintenance">
		<p class="section-eyebrow">Maintenance contracts</p>
		<h2 class="section-h">Caught small beats fixed expensive.</h2>
		<p class="section-sub">Scheduled inspections, small repairs, and a documented roof history. Quoted by building.</p>
		<HeritagePlaceholder fact="Maintenance contract structure: typical visit frequency (semi-annual / quarterly), what's included, typical price band. See Founder Input page §5." />
	</section>

	<TrustStrip items={["Bonded and insured", "All major systems", "Locally owned"]} />
</BaseLayout>

<style>
	/* Hero */
	.hero { position: relative; min-height: 540px; background: #1a1a1a; }
	.hero-photo {
		position: absolute; inset: 0;
		background: linear-gradient(180deg, #7d8b9e 0%, #a8a89c 50%, #4a4a48 100%);
		opacity: 0.92;
	}
	.hero-overlay {
		position: absolute; inset: 0;
		background: linear-gradient(90deg, rgba(26,26,26,0.78) 0%, rgba(26,26,26,0.35) 60%, rgba(26,26,26,0.1) 100%);
	}
	.hero-content { position: relative; padding: 96px 48px 80px; max-width: 720px; }
	.hero-eyebrow {
		color: #b54620; font-size: 13px; font-weight: 500;
		margin: 0 0 20px; letter-spacing: 1px; text-transform: uppercase;
	}
	.hero-h1 {
		color: #faf8f4; font-size: 56px; font-weight: 600;
		line-height: 1.05; margin: 0 0 24px; letter-spacing: -1.8px;
	}
	.hero-sub {
		color: #d8d2c2; font-size: 17px; line-height: 1.55;
		margin: 0 0 32px; max-width: 560px;
	}
	.hero-cta-row { display: flex; gap: 16px; align-items: center; }
	.cta-primary {
		background: #b54620; color: #faf8f4;
		padding: 14px 28px; font-size: 15px; font-weight: 500;
		border-radius: var(--radius-pill);
		transition: background 150ms ease, box-shadow 150ms ease;
	}
	.cta-primary:hover { background: #9d3a1a; box-shadow: var(--shadow-active); }
	.cta-secondary {
		color: #faf8f4; padding: 12px 26px;
		font-size: 15px; font-weight: 500;
		border: 2px solid #faf8f4;
		border-radius: var(--radius-pill);
		transition: background 150ms ease, color 150ms ease;
	}
	.cta-secondary:hover { background: #faf8f4; color: #1a1a1a; }

	.section-eyebrow {
		color: #b54620; font-size: 13px; font-weight: 500;
		text-align: center; margin: 0 0 16px;
		letter-spacing: 1px; text-transform: uppercase;
	}
	.section-eyebrow.on-dark { color: #b54620; }
	.section-h {
		color: #1a1a1a; font-size: 40px; font-weight: 600;
		text-align: center; margin: 0 0 16px;
		letter-spacing: -1px; line-height: 1.1;
	}
	.section-h.on-dark { color: #faf8f4; }
	.section-sub {
		color: #5a5347; font-size: 16px; text-align: center;
		margin: 0 auto 56px; max-width: 600px;
	}
	.section-sub.on-dark { color: #d8d2c2; }

	/* Services */
	.services { padding: 96px 48px; background: #faf8f4; }
	.service-grid {
		display: grid; grid-template-columns: repeat(3, 1fr);
		gap: 24px; max-width: 1100px; margin: 0 auto;
	}

	/* Systems detail (dark) */
	.systems-detail { background: #1a1a1a; padding: 96px 48px; }
	.systems-grid {
		display: grid; grid-template-columns: repeat(3, 1fr);
		gap: 24px; max-width: 1100px; margin: 0 auto;
	}
	.system-card {
		padding: 28px;
		background: rgba(250,248,244,0.04);
		border: 1px solid rgba(250,248,244,0.12);
	}
	.system-name {
		color: #faf8f4; font-size: 20px; font-weight: 600;
		margin: 0 0 12px; letter-spacing: -0.3px;
	}
	.system-body { color: #c4c1ba; font-size: 14px; line-height: 1.6; margin: 0; }
	.systems-cert { max-width: 1100px; margin: 28px auto 0; }

	/* Industries */
	.industries { padding: 96px 48px; background: #ffffff; border-top: 1px solid #ece7de; }
	.industry-tags {
		display: flex; flex-wrap: wrap; gap: 10px;
		justify-content: center; max-width: 800px; margin: 0 auto 40px;
	}
	.industry-tag {
		display: inline-flex; padding: 10px 22px;
		background: var(--charcoal); color: var(--off-white);
		font-size: 14px; font-weight: 500; letter-spacing: 0.2px;
		border-radius: var(--radius-pill);
	}
	.industry-rows {
		display: grid; grid-template-columns: 1fr 1fr;
		gap: 14px 56px; max-width: 1000px; margin: 0 auto;
	}
	.industry-row {
		display: grid; grid-template-columns: 130px 1fr;
		gap: 16px; padding: 14px 0;
		border-bottom: 1px solid var(--border);
	}
	.industry-row-label { color: var(--charcoal); font-size: 14px; font-weight: 600; letter-spacing: -0.1px; }
	.industry-row-body { color: var(--warm-gray); font-size: 14px; line-height: 1.5; }

	.why-commercial { padding: 96px 48px; background: var(--ivory-tint); border-top: 1px solid #ece7de; }
	.stats { padding: 64px 48px; background: #ffffff; border-top: 1px solid #ece7de; }

	/* Bonding */
	.bonding { padding: 96px 48px; background: #faf8f4; }
	.bonding-grid {
		display: grid; grid-template-columns: repeat(3, 1fr);
		gap: 24px; max-width: 1100px; margin: 0 auto;
	}
	.bonding-card { padding: 24px; background: #ffffff; border: 1px solid #ece7de; }
	.bonding-label {
		color: #1a1a1a; font-size: 14px; font-weight: 600;
		margin: 0 0 12px; letter-spacing: -0.2px;
	}

	/* Re-roof process (dark) */
	.reroof { background: #1a1a1a; padding: 96px 48px; }
	.reroof-list {
		max-width: 800px; margin: 0 auto; padding: 0; list-style: none;
		display: flex; flex-direction: column; gap: 20px;
	}
	.reroof-step {
		display: grid; grid-template-columns: 56px 1fr; gap: 20px;
		padding: 24px 28px;
		background: rgba(250,248,244,0.04);
		border: 1px solid rgba(250,248,244,0.12);
	}
	.reroof-n {
		display: inline-flex; align-items: center; justify-content: center;
		width: 40px; height: 40px;
		background: #b54620; color: #faf8f4;
		font-size: 14px; font-weight: 600;
	}
	.reroof-label { color: #faf8f4; font-size: 18px; font-weight: 600; margin: 0 0 6px; letter-spacing: -0.2px; }
	.reroof-text { color: #c4c1ba; font-size: 15px; line-height: 1.6; margin: 0; }

	/* Projects */
	.projects { padding: 96px 48px; background: #faf8f4; }
	.projects-grid {
		display: grid; grid-template-columns: repeat(3, 1fr);
		gap: 24px; max-width: 1100px; margin: 0 auto;
	}
	.projects-stats { max-width: 1100px; margin: 32px auto 0; }

	/* Maintenance */
	.maintenance { padding: 96px 48px; background: #ffffff; border-top: 1px solid #ece7de; }
	.maintenance > :global(.placeholder) { max-width: 800px; margin-left: auto; margin-right: auto; }
</style>
