---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceTile from '../components/ServiceTile.astro';
import TrustStrip from '../components/TrustStrip.astro';
import FilterableProjectGrid from '../components/FilterableProjectGrid.astro';
import StatRow from '../components/StatRow.astro';
import LayeredCard from '../components/LayeredCard.astro';
import FullBleedSection from '../components/FullBleedSection.astro';
import ProcessFlow from '../components/ProcessFlow.astro';
import HeritagePlaceholder from '../components/HeritagePlaceholder.astro';
import { imagery } from '../content/imagery';

const services = [
	{ label: 'New construction', body: 'Single-source coordination from deck-up. Ground-up builds, on schedule.', gradient: 'linear-gradient(180deg, #7d8b9e 0%, #4a5566 100%)' },
	{ label: 'Re-roofs', body: 'Tear-off and replacement on existing buildings. Minimum tenant disruption.', gradient: 'linear-gradient(180deg, #4a4a48 0%, #6b5d4a 100%)' },
	{ label: 'Maintenance', body: 'Scheduled inspections and small repairs. Stops the leak before it starts.', gradient: 'linear-gradient(180deg, #c4b89e 0%, #8a7d63 100%)' },
	{ label: 'Repairs', body: 'Targeted fixes for known issues. Same-week response for active leaks.', gradient: 'linear-gradient(180deg, #8a6f54 0%, #5a4836 100%)' },
	{ label: 'Roof systems', body: 'TPO, EPDM, modified bitumen, metal, built-up, coatings. We spec to the building.', gradient: 'linear-gradient(180deg, #a8a89c 0%, #4a4a48 100%)' },
	{ label: 'Project portfolio', body: 'Past commercial work across schools, retail, healthcare, and industrial.', gradient: 'linear-gradient(180deg, #6b8aa8 0%, #4a5566 100%)' },
];

const systemsDetail = [
	{ name: 'TPO', body: 'Single-ply thermoplastic. Bright white, reflective, weldable seams. Standard for retail and warehouse re-roofs.' },
	{ name: 'EPDM', body: 'Single-ply rubber. Long service life, forgiving install. Common on flat commercial.' },
	{ name: 'Modified bitumen', body: 'Asphalt-based, multi-ply. Torch-down or self-adhered. Workhorse for institutional buildings.' },
	{ name: 'Metal', body: 'Standing seam, R-panel, structural. Long life, high wind ratings. Common on schools and ag.' },
	{ name: 'Built-up', body: 'Tar-and-gravel BUR systems. Older spec but still installed where the building calls for it.' },
	{ name: 'Coatings', body: 'Acrylic, silicone, urethane. Restoration over an existing roof to extend life and reflect heat.' },
];

const industries = [
	{ label: 'Schools', body: 'Districts and private. Summer-window installs.' },
	{ label: 'Healthcare', body: 'Clinics, MOBs, hospitals. Negative-pressure-aware.' },
	{ label: 'Retail', body: 'Strip centers, big-box, mixed-use.' },
	{ label: 'Industrial', body: 'Warehouses, manufacturing, distribution.' },
	{ label: 'Office', body: 'Class A, B, multi-tenant.' },
	{ label: 'Government', body: 'Municipal, county, federal. Bid-compliant.' },
];

const bondingItems = [
	{ label: 'Bonding capacity (single)', fact: 'Single-project bonding capacity (e.g. $2M). See Founder Input page §3.' },
	{ label: 'Bonding capacity (aggregate)', fact: 'Aggregate bonding capacity. See Founder Input page §3.' },
	{ label: 'General liability', fact: 'GL coverage limit per occurrence + aggregate. See Founder Input page §3.' },
	{ label: 'Umbrella', fact: 'Umbrella policy limit. See Founder Input page §3.' },
	{ label: "Workers' comp", fact: "Workers' comp carrier name. See Founder Input page §3." },
	{ label: 'Roofing license #', fact: 'Texas roofing license # and Arkansas equivalent if applicable. See Founder Input page §3.' },
];
---

<BaseLayout
	title="Commercial Roofing — Heritage Co."
	ctaHeading="Need a quote on a commercial roof?"
	ctaSub="Walkthrough, scope, and pricing within the week."
	ctaButton="Request consultation"
>
	<!-- Hero (unchanged) -->
	<section class="hero">
		<div class="hero-photo" aria-hidden="true"></div>
		<div class="hero-overlay" aria-hidden="true"></div>
		<div class="hero-content">
			<p class="hero-eyebrow">For businesses</p>
			<h1 class="hero-h1">Roofs for your business.</h1>
			<p class="hero-sub">
				New construction, re-roofs, maintenance. Bonded and insured. All major roof systems, spec'd to the building and the budget.
			</p>
			<div class="hero-cta-row">
				<a class="cta-primary" href="/#inspection">Request quote</a>
				<a class="cta-secondary" href="tel:9032428102">Call 903-242-8102</a>
			</div>
		</div>
	</section>

	<!-- Continuous flow on off-white. Single dark island for systems-detail. -->
	<div class="flow">

		<!-- Intro: facility-manager focus, photo on right + content + service grid below -->
		<section class="block intro">
			<div class="intro-row">
				<div class="intro-content">
					<p class="eyebrow">For facility managers</p>
					<h2 class="block-h">One walkthrough. One bid. One crew.</h2>
					<p class="block-sub">From spec through installation through warranty. Single-source coordination, bonded estimate ready for procurement, and crews that work around tenants — not over them.</p>
					<a class="rust-cta" href="/#inspection">Request consultation</a>
				</div>
				<div class="intro-photo has-zoom-photo" aria-hidden="true">
					<img src={imagery.metal.hero.url} alt={imagery.metal.hero.alt} loading="lazy" class="zoom-photo" />
				</div>
			</div>
			<div class="service-grid">
				{services.map((s) => <ServiceTile label={s.label} body={s.body} photo={true} gradient={s.gradient} />)}
			</div>
		</section>

		<!-- Industries — pill tags + compact rows on same bg, no break -->
		<section class="block industries">
			<p class="eyebrow">Industries served</p>
			<h2 class="block-h">We've worked the building you're in.</h2>
			<p class="block-sub">Six common building types. Plenty of less common ones too.</p>
			<div class="industry-tags">
				{industries.map((i) => <span class="industry-tag">{i.label}</span>)}
			</div>
			<div class="industry-rows">
				{industries.map((i) => (
					<div class="industry-row">
						<span class="industry-row-label">{i.label}</span>
						<span class="industry-row-body">{i.body}</span>
					</div>
				))}
			</div>
		</section>
	</div>

	<!-- One darker island for the systems detail — feels like a "spec" section, not a bg swap -->
	<section class="systems-island">
		<div class="block-inner">
			<div class="systems-row">
				<div class="systems-content">
					<p class="eyebrow on-dark">Roof systems</p>
					<h2 class="block-h on-dark">Six systems. We spec to the building.</h2>
					<p class="block-sub on-dark">The right system depends on slope, occupancy, climate, and budget — we walk through trade-offs at the inspection.</p>
				</div>
				<div class="systems-photo has-zoom-photo" aria-hidden="true">
					<img src={imagery.metal.secondary.url} alt={imagery.metal.secondary.alt} loading="lazy" class="zoom-photo" />
				</div>
			</div>
			<div class="systems-grid">
				{systemsDetail.map((s) => (
					<div class="system-card">
						<p class="system-name">{s.name}</p>
						<p class="system-body">{s.body}</p>
					</div>
				))}
			</div>
			<div class="systems-cert">
				<HeritagePlaceholder fact="Manufacturer system certifications Heritage holds (e.g. Carlisle SureWeld, Firestone Red Shield, GAF EverGuard, Johns Manville Peak Advantage). Plain-text list. See Founder Input page §2." />
			</div>
		</div>
	</section>

	<!-- Resume continuous flow on off-white -->
	<div class="flow">

		<!-- Why Heritage for commercial — LayeredCard + StatRow combined -->
		<section class="block why-commercial">
			<LayeredCard
				eyebrow="Why Heritage for commercial"
				heading="Bonded, insured, and on the roof when the bid is awarded."
				body="Single-source coordination from walkthrough to closeout. We work around tenants, not over them. Procurement-ready paperwork below."
				gradient="linear-gradient(180deg, #7d8b9e 0%, #a8a89c 50%, #4a4a48 100%)"
				ctaHref="/#inspection"
				ctaLabel="Request consultation"
			/>
			<div class="stats-inline">
				<StatRow stats={[
					{ label: 'Bonding (single)', placeholderFact: 'Single-project bonding capacity in dollars. See Founder Input page §3.' },
					{ label: 'GL coverage', placeholderFact: 'General liability per-occurrence limit. See Founder Input page §3.' },
					{ label: 'Years in business', placeholderFact: 'Year Heritage Co. was founded → years in business as of 2026. See Founder Input page §7.' },
					{ label: 'Sq ft installed', placeholderFact: 'Lifetime commercial sq ft installed. See Founder Input page §5.' },
				]} />
			</div>
		</section>

		<!-- Bonding + insurance — flat 2-col data list -->
		<section class="block bonding">
			<p class="eyebrow eyebrow-soft">The numbers procurement wants</p>
			<dl class="data-list">
				{bondingItems.map((b) => (
					<div class="data-row">
						<dt class="data-row-label">{b.label}</dt>
						<dd class="data-row-value">
							<HeritagePlaceholder fact={b.fact} />
						</dd>
					</div>
				))}
			</dl>
		</section>

		<!-- Re-roof process — photo + ProcessFlow -->
		<section class="block reroof">
			<div class="reroof-row">
				<div class="reroof-photo has-zoom-photo" aria-hidden="true">
					<img src={imagery.projectGallery[3].url} alt={imagery.projectGallery[3].alt} loading="lazy" class="zoom-photo" />
				</div>
				<div class="reroof-content">
					<p class="eyebrow">How a re-roof runs</p>
					<h2 class="block-h">Five phases on an occupied building.</h2>
					<p class="block-sub">We tell tenants what to expect before we tell them to expect it.</p>
				</div>
			</div>
			<div class="reroof-flow">
				<ProcessFlow steps={[
					{ label: 'Walkthrough', caption: 'On-roof survey with the facility manager.' },
					{ label: 'Spec + bid', caption: 'Written scope, system rec, bonded estimate.' },
					{ label: 'Pre-construction', caption: 'Tenant notice plan, staging, working hours.' },
					{ label: 'Tear-off + install', caption: 'Phased on occupied buildings.' },
					{ label: 'Closeout', caption: 'Final walk, warranty hand-off, paperwork.' },
				]} />
			</div>
		</section>

		<!-- Project gallery — FilterableProjectGrid with lightbox triggers -->
		<section class="block projects">
			<p class="eyebrow">Past projects</p>
			<h2 class="block-h">Buildings we've roofed.</h2>
			<p class="block-sub">Filter by industry. Click a card to view full size. Specific named projects fill in as the founders confirm permission to publish.</p>
			<FilterableProjectGrid
				filters={[
					{ key: 'all', label: 'All' },
					{ key: 'schools', label: 'Schools' },
					{ key: 'healthcare', label: 'Healthcare' },
					{ key: 'retail', label: 'Retail' },
					{ key: 'industrial', label: 'Industrial' },
					{ key: 'office', label: 'Office' },
				]}
				projects={[
					{ industry: 'Schools', industryKey: 'schools', imageSrc: imagery.projectGallery[0].url, placeholderFact: 'Illustrative — Unsplash stand-in. Replace with named school project (district, building, city, year, system, sq ft). See Founder Input §5.' },
					{ industry: 'Healthcare', industryKey: 'healthcare', imageSrc: imagery.projectGallery[1].url, placeholderFact: 'Illustrative — Unsplash stand-in. Replace with named healthcare project. See Founder Input §5.' },
					{ industry: 'Retail', industryKey: 'retail', imageSrc: imagery.projectGallery[2].url, placeholderFact: 'Illustrative — Unsplash stand-in. Replace with named retail project. See Founder Input §5.' },
					{ industry: 'Industrial', industryKey: 'industrial', imageSrc: imagery.projectGallery[3].url, placeholderFact: 'Illustrative — Unsplash stand-in. Replace with named industrial project. See Founder Input §5.' },
					{ industry: 'Office', industryKey: 'office', imageSrc: imagery.projectGallery[4].url, placeholderFact: 'Illustrative — Unsplash stand-in. Replace with named office project. See Founder Input §5.' },
					{ industry: 'Schools', industryKey: 'schools', imageSrc: imagery.projectGallery[5].url, placeholderFact: 'Illustrative — Unsplash stand-in. Replace with second named school project. See Founder Input §5.' },
				]}
			/>
			<div class="projects-stats">
				<HeritagePlaceholder fact="Lifetime sq ft of commercial roof installed. Oldest active commercial roof Heritage installed. See Founder Input page §5." />
			</div>
		</section>

		<!-- Maintenance contracts — same flow, no separate band -->
		<section class="block maintenance">
			<p class="eyebrow">Maintenance contracts</p>
			<h2 class="block-h">Caught small beats fixed expensive.</h2>
			<p class="block-sub">Scheduled inspections, small repairs, and a documented roof history. Quoted by building.</p>
			<HeritagePlaceholder fact="Maintenance contract structure: typical visit frequency (semi-annual / quarterly), what's included, typical price band. See Founder Input page §5." />
			<div class="trust-inline">
				<TrustStrip items={["Bonded and insured", "All major systems", "Locally owned"]} />
			</div>
		</section>

	</div>

	<!-- Page-end CTA -->
	<FullBleedSection
		imageSrc={imagery.heroCandidates.residentialRoofC.url}
		imageAlt="Aerial view of a commercial roof"
		overlayPosition="center"
		minHeight="440px"
		overlayDarken={0.65}
	>
		<p class="end-cta-eyebrow">Bid-ready</p>
		<h2 class="end-cta-h">Walkthrough, scope, and pricing within the week.</h2>
		<p class="end-cta-sub">Send a building address. We send a roofer.</p>
		<a class="end-cta-button" href="/#inspection">Request consultation</a>
	</FullBleedSection>
</BaseLayout>

<style>
	/* Hero */
	.hero { position: relative; min-height: 540px; background: #1a1a1a; }
	.hero-photo {
		position: absolute; inset: 0;
		background: linear-gradient(180deg, #7d8b9e 0%, #a8a89c 50%, #4a4a48 100%);
		opacity: 0.92;
	}
	.hero-overlay {
		position: absolute; inset: 0;
		background: linear-gradient(90deg, rgba(26,26,26,0.78) 0%, rgba(26,26,26,0.35) 60%, rgba(26,26,26,0.1) 100%);
	}
	.hero-content { position: relative; padding: 96px 48px 80px; max-width: 720px; }
	.hero-eyebrow {
		color: #b54620; font-size: 13px; font-weight: 500;
		margin: 0 0 20px; letter-spacing: 1px; text-transform: uppercase;
	}
	.hero-h1 {
		color: #faf8f4; font-size: 56px; font-weight: 600;
		line-height: 1.05; margin: 0 0 24px; letter-spacing: -1.8px;
	}
	.hero-sub {
		color: #d8d2c2; font-size: 17px; line-height: 1.55;
		margin: 0 0 32px; max-width: 560px;
	}
	.hero-cta-row { display: flex; gap: 16px; align-items: center; }
	.cta-primary {
		background: #b54620; color: #faf8f4;
		padding: 14px 28px; font-size: 15px; font-weight: 500;
		border-radius: var(--radius-pill);
		transition: background 150ms ease, box-shadow 150ms ease;
	}
	.cta-primary:hover { background: #9d3a1a; box-shadow: var(--shadow-active); }
	.cta-secondary {
		color: #faf8f4; padding: 12px 26px;
		font-size: 15px; font-weight: 500;
		border: 2px solid #faf8f4;
		border-radius: var(--radius-pill);
		transition: background 150ms ease, color 150ms ease;
	}
	.cta-secondary:hover { background: #faf8f4; color: #1a1a1a; }

	/* Continuous flow */
	.flow { background: var(--off-white); }
	.block {
		padding: 80px 48px;
		max-width: 1200px;
		margin: 0 auto;
	}
	.block + .block { border-top: 1px solid var(--border); }

	.eyebrow {
		color: var(--rust);
		font-size: 13px; font-weight: 500;
		letter-spacing: 1px; text-transform: uppercase;
		margin: 0 0 16px;
	}
	.eyebrow.on-dark { color: var(--rust); }
	.eyebrow-soft { color: var(--charcoal); opacity: 0.65; margin-bottom: 20px; }
	.block-h {
		color: var(--charcoal);
		font-size: 36px; font-weight: 600;
		letter-spacing: -0.8px; line-height: 1.15;
		margin: 0 0 16px;
	}
	.block-h.on-dark { color: var(--off-white); }
	.block-sub {
		color: var(--warm-gray);
		font-size: 17px; line-height: 1.6;
		margin: 0 0 32px;
		max-width: 580px;
	}
	.block-sub.on-dark { color: var(--subhead-dark); }
	.rust-cta {
		display: inline-flex; align-items: center;
		padding: 14px 28px;
		background: var(--rust); color: var(--off-white);
		font-size: 15px; font-weight: 500;
		border-radius: var(--radius-pill);
		transition: background 150ms ease, box-shadow 150ms ease;
	}
	.rust-cta:hover { background: #9d3a1a; box-shadow: var(--shadow-active); }

	/* Intro row */
	.intro-row {
		display: grid;
		grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
		gap: 56px;
		align-items: center;
		margin-bottom: 56px;
	}
	.intro-photo {
		aspect-ratio: 4 / 3;
		border-radius: var(--radius-large);
		box-shadow: var(--shadow-subtle);
		overflow: hidden;
	}
	.intro-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
	.service-grid {
		display: grid; grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	/* Industries */
	.industry-tags {
		display: flex; flex-wrap: wrap; gap: 10px;
		margin-bottom: 32px;
	}
	.industry-tag {
		display: inline-flex; padding: 10px 22px;
		background: var(--charcoal); color: var(--off-white);
		font-size: 14px; font-weight: 500; letter-spacing: 0.2px;
		border-radius: var(--radius-pill);
	}
	.industry-rows {
		display: grid; grid-template-columns: 1fr 1fr;
		gap: 14px 56px; max-width: 1000px;
	}
	.industry-row {
		display: grid; grid-template-columns: 130px 1fr;
		gap: 16px; padding: 14px 0;
		border-bottom: 1px solid var(--border);
	}
	.industry-row-label { color: var(--charcoal); font-size: 14px; font-weight: 600; }
	.industry-row-body { color: var(--warm-gray); font-size: 14px; line-height: 1.5; }

	/* Systems island (one dark stretch) */
	.systems-island { background: var(--charcoal); padding: 96px 48px; }
	.block-inner { max-width: 1200px; margin: 0 auto; }
	.systems-row {
		display: grid;
		grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
		gap: 56px;
		align-items: center;
		margin-bottom: 56px;
	}
	.systems-photo {
		aspect-ratio: 4 / 3;
		border-radius: var(--radius-large);
		overflow: hidden;
		box-shadow: var(--shadow-active);
	}
	.systems-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
	.systems-grid {
		display: grid; grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}
	.system-card {
		padding: 28px;
		background: rgba(250,248,244,0.04);
		border: 1px solid rgba(250,248,244,0.12);
		border-radius: var(--radius-card);
	}
	.system-name {
		color: var(--off-white); font-size: 20px; font-weight: 600;
		margin: 0 0 12px; letter-spacing: -0.3px;
	}
	.system-body { color: var(--body-dark); font-size: 14px; line-height: 1.6; margin: 0; }
	.systems-cert { margin-top: 28px; }

	/* Why commercial — LayeredCard + StatRow */
	.stats-inline { margin-top: 56px; }

	/* Bonding — flat data list */
	.data-list {
		max-width: 880px; margin: 0;
		display: flex; flex-direction: column; gap: 0;
	}
	.data-row {
		display: grid; grid-template-columns: 240px 1fr;
		gap: 32px; padding: 18px 0;
		border-top: 1px solid var(--border);
		align-items: start;
	}
	.data-row:last-child { border-bottom: 1px solid var(--border); }
	.data-row-label {
		color: var(--charcoal); font-size: 14px; font-weight: 600;
		letter-spacing: -0.1px; padding-top: 4px;
	}
	.data-row-value { margin: 0; }

	/* Re-roof row */
	.reroof-row {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
		gap: 56px;
		align-items: center;
		margin-bottom: 48px;
	}
	.reroof-photo {
		aspect-ratio: 4 / 3;
		border-radius: var(--radius-large);
		box-shadow: var(--shadow-subtle);
		overflow: hidden;
	}
	.reroof-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
	.reroof-flow { --cols: 5; }

	/* Projects */
	.projects-stats { max-width: 1100px; margin: 32px auto 0; }

	/* Maintenance */
	.trust-inline { margin-top: 32px; }
	.trust-inline > :global(.trust) {
		background: transparent;
		border-top: 0;
		border-bottom: 0;
		padding: 0;
	}

	/* End CTA */
	.end-cta-eyebrow {
		color: var(--rust);
		font-size: 13px; font-weight: 500;
		letter-spacing: 1px; text-transform: uppercase;
		margin: 0 0 16px;
	}
	.end-cta-h {
		color: var(--off-white);
		font-size: 44px; font-weight: 600;
		letter-spacing: -1px; line-height: 1.1;
		margin: 0 0 14px;
		max-width: 640px;
	}
	.end-cta-sub {
		color: var(--subhead-dark);
		font-size: 17px; line-height: 1.55;
		margin: 0 0 28px;
		max-width: 580px;
	}
	.end-cta-button {
		display: inline-flex; align-items: center;
		padding: 18px 36px;
		background: var(--rust); color: var(--off-white);
		font-size: 16px; font-weight: 500;
		border-radius: var(--radius-pill);
		box-shadow: var(--shadow-active);
		transition: background 150ms ease, transform 200ms ease;
	}
	.end-cta-button:hover { background: #9d3a1a; transform: translateY(-1px); }
</style>
