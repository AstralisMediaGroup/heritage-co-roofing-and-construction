---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroPage from '../../components/v2/HeroPage.astro';
import PromiseStrip from '../../components/v2/PromiseStrip.astro';
import SectionHead from '../../components/v2/SectionHead.astro';
import ToggleFacts from '../../components/v2/ToggleFacts.astro';
import TileGrid from '../../components/v2/TileGrid.astro';
import PageCTA from '../../components/v2/PageCTA.astro';
import Reveal from '../../components/v2/Reveal.astro';
import { imagery } from '../../content/imagery';
import { otherSystems } from '../../content/commercialSystems';

const v2 = imagery.v2;
---

<BaseLayout
	title="Modified bitumen roofing — Heritage Co."
	description="Heritage Co. installs modified bitumen multi-ply roofing on commercial buildings across East Texas. Strong puncture resistance, foot-traffic-tolerant."
>
	<HeroPage
		eyebrow="Commercial · multi-ply"
		heading="Modified bitumen."
		lede="Multi-ply asphalt-based system reinforced with polymer modifiers. Strong puncture and foot-traffic resistance — the right call where rooftop equipment service is heavy."
		photo={v2.pageHeros.modifiedBitumen}
		primaryCta={{ label: 'Request a quote', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
		tier={2}
	/>

	<PromiseStrip items={['We install mod-bit', 'Heat-welded or cold-applied', 'Puncture-resistant', 'Bonded + insured']} />

	<Reveal>
		<section class="page-section">
			<div class="container">
				<ToggleFacts facts={[
					{ label: 'What it is', body: 'Asphalt-based membrane modified with SBS or APP polymers and reinforced with a fiberglass or polyester mat. Installed in two or three plies via heat-welded torch, cold-applied adhesive, or self-adhered. Granule-surfaced top sheet provides UV protection.' },
					{ label: 'When we spec it', body: 'Buildings with heavy rooftop foot traffic — HVAC service, restaurant-vent maintenance, telecom equipment. Re-roofs where the existing system is mod-bit and a recover beats a tear-off. Owners who want the multi-ply redundancy single-ply does not provide.' },
					{ label: 'When we skip it', body: 'Cooling-dominated buildings usually do better with a reflective TPO. Tight budgets sometimes land on a coating restoration instead. The free assessment tells you which — see the other commercial systems below.' },
				]} />
			</div>
		</section>
	</Reveal>

	<Reveal>
		<section class="page-section section-tight">
			<div class="container">
				<SectionHead
					eyebrow="Other commercial systems"
					heading="Not mod-bit?<br />Here's the rest."
					lede="We install every major commercial roof type. Pick the one that fits the building."
					maxWidth="780px"
				/>
				<div class="systems-spacer">
					<TileGrid tiles={otherSystems('modBit')} cols={3} style="photo-card" />
				</div>
			</div>
		</section>
	</Reveal>

	<PageCTA
		heading="Free roof assessment.<br />Real recommendation in a week."
		lede="We tell you whether mod-bit is the right call before we quote it."
		primaryCta={{ label: 'Request a quote', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
		photo={v2.pageHeros.commercial}
	/>
</BaseLayout>

<style>
	.page-section { padding: clamp(64px, 7vw, 112px) 0; }
	.section-tight { padding-top: clamp(40px, 4vw, 64px); }
	.systems-spacer { margin-top: clamp(40px, 4vw, 64px); }
</style>
