---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroPage from '../../components/v2/HeroPage.astro';
import PromiseStrip from '../../components/v2/PromiseStrip.astro';
import SectionHead from '../../components/v2/SectionHead.astro';
import ToggleFacts from '../../components/v2/ToggleFacts.astro';
import TileGrid from '../../components/v2/TileGrid.astro';
import PageCTA from '../../components/v2/PageCTA.astro';
import Reveal from '../../components/v2/Reveal.astro';
import { imagery } from '../../content/imagery';
import { otherSystems } from '../../content/commercialSystems';

const v2 = imagery.v2;
const m = imagery.metal;
---

<BaseLayout
	title="Commercial metal roofing — Heritage Co."
	description="Heritage Co. installs standing seam metal roofs on commercial buildings across East Texas. Concealed-fastener panels, 30–40 year paint warranty."
>
	<HeroPage
		eyebrow="Commercial · metal"
		heading="Standing seam metal."
		lede="Concealed-fastener metal panels. The longest-warranty commercial roof on the market — 30–40 year paint, 40+ year service life. The roof you only buy once."
		photo={m.standingSeam}
		primaryCta={{ label: 'Request a quote', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
		tier={2}
	/>

	<PromiseStrip items={['We install standing seam', 'Concealed fasteners', '30–40 yr paint warranty', 'Bonded + insured']} />

	<Reveal>
		<section class="page-section">
			<div class="container">
				<ToggleFacts facts={[
					{ label: 'What it is', body: 'Galvalume steel panels with PVDF (Kynar 500) finish, mechanically seamed at vertical ribs with no fasteners exposed in the field of the roof. Class 4 impact, Class A fire, 30–40 year paint warranty. The longest-warranty commercial roof on the market.' },
					{ label: 'When we spec it', body: 'Owner-occupied buildings with a long horizon — the up-front premium pays back over the time you keep the building. Steep-slope commercial where the visual matters. Re-roofs where the existing system has already failed twice and the owner wants the last roof they will ever buy.' },
					{ label: 'When we skip it', body: 'Tight-budget re-roofs that just need 15–20 more years usually go TPO or coatings. Heavily penetrated roofs with lots of HVAC service trade well to mod-bit. The free assessment tells you which — see the other commercial systems below.' },
				]} />
			</div>
		</section>
	</Reveal>

	<Reveal>
		<section class="page-section section-tight">
			<div class="container">
				<SectionHead
					eyebrow="Other commercial systems"
					heading="Not metal?<br />Here's the rest."
					lede="We install every major commercial roof type. Pick the one that fits the building."
					maxWidth="780px"
				/>
				<div class="systems-spacer">
					<TileGrid tiles={otherSystems('metal')} cols={3} style="photo-card" />
				</div>
			</div>
		</section>
	</Reveal>

	<PageCTA
		heading="Free roof assessment.<br />Real recommendation in a week."
		lede="We tell you whether metal is the right call before we quote it."
		primaryCta={{ label: 'Request a quote', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
		photo={v2.pageHeros.commercial}
	/>
</BaseLayout>

<style>
	.page-section { padding: clamp(64px, 7vw, 112px) 0; }
	.section-tight { padding-top: clamp(40px, 4vw, 64px); }
	.systems-spacer { margin-top: clamp(40px, 4vw, 64px); }
</style>
