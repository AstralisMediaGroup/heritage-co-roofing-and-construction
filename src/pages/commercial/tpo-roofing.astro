---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroPage from '../../components/v2/HeroPage.astro';
import PromiseStrip from '../../components/v2/PromiseStrip.astro';
import SectionHead from '../../components/v2/SectionHead.astro';
import TileGrid from '../../components/v2/TileGrid.astro';
import PageCTA from '../../components/v2/PageCTA.astro';
import Reveal from '../../components/v2/Reveal.astro';
import { imagery } from '../../content/imagery';

const v2 = imagery.v2;

const otherSystems = [
	{
		eyebrow: 'EPDM',
		heading: 'EPDM single-ply.',
		body: 'Black rubber membrane. The right call for certain re-roofs.',
		href: '/commercial/epdm-roofing',
		photo: v2.systemTiles.epdm,
	},
	{
		eyebrow: 'Modified bitumen',
		heading: 'Modified bitumen.',
		body: 'Multi-ply asphalt-based system with strong puncture resistance.',
		href: '/commercial/modified-bitumen-roofing',
		photo: v2.systemTiles.modBit,
	},
	{
		eyebrow: 'Built-up roofing',
		heading: 'BUR (tar and gravel).',
		body: 'Multi-layer asphalt-and-gravel. Decades of proven service.',
		href: '/commercial/built-up-roofing',
		photo: v2.systemTiles.bur,
	},
	{
		eyebrow: 'Metal',
		heading: 'Standing seam metal.',
		body: 'Concealed-fastener panels. The longest-warranty option.',
		href: '/commercial/metal-roofing',
		photo: v2.systemTiles.metal,
	},
	{
		eyebrow: 'Coatings',
		heading: 'Coatings + restoration.',
		body: 'Silicone or acrylic recoats over an existing system. Adds 10–15 years.',
		href: '/commercial/roof-coatings-and-restorations',
		photo: v2.systemTiles.coatings,
	},
	{
		eyebrow: 'Maintenance',
		heading: 'Maintenance programs.',
		body: 'Scheduled inspection + minor-repair cadence. Protects the warranty.',
		href: '/commercial/maintenance-programs',
		photo: v2.systemTiles.maintenance,
	},
];
---

<BaseLayout
	title="TPO commercial roofing — Heritage Co."
	description="Heritage Co. installs TPO single-ply membrane on commercial roofs across East Texas. White, heat-welded, energy-reflective."
>
	<HeroPage
		eyebrow="Commercial · single-ply"
		heading="TPO."
		lede="White single-ply membrane with heat-welded seams. The default re-roof for retail, light commercial, and cooling-dominated buildings across East Texas."
		photo={v2.pageHeros.tpoRoofing}
		primaryCta={{ label: 'Request a quote', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
		tier={2}
	/>

	<PromiseStrip items={['We install TPO', 'Heat-welded seams', '20+ yr service life', 'Bonded + insured']} />

	<Reveal>
		<section class="page-section">
			<div class="container narrow">
				<p class="lede">
					TPO is a thermoplastic membrane installed in wide sheets and welded together at every overlap. The reflective white surface drops summer cooling load. We spec it on most flat or low-slope re-roofs unless the building calls for something different. Free assessment tells you whether it's the right call.
				</p>
			</div>
		</section>
	</Reveal>

	<Reveal>
		<section class="page-section section-tight">
			<div class="container">
				<SectionHead
					eyebrow="Other commercial systems"
					heading="Not TPO?<br />Here's the rest."
					lede="We install every major commercial roof type. Pick the one that fits the building."
					maxWidth="780px"
				/>
				<div class="systems-spacer">
					<TileGrid tiles={otherSystems} cols={3} style="photo-card" />
				</div>
			</div>
		</section>
	</Reveal>

	<PageCTA
		heading="Free roof assessment.<br />Real recommendation in a week."
		lede="We tell you whether TPO is the right call before we quote it."
		primaryCta={{ label: 'Request a quote', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
		photo={v2.pageHeros.commercial}
	/>
</BaseLayout>

<style>
	.page-section { padding: clamp(64px, 7vw, 112px) 0; }
	.section-tight { padding-top: clamp(40px, 4vw, 64px); }
	.container.narrow { max-width: 760px; }
	.lede {
		font-size: clamp(18px, 1.6vw, 21px);
		line-height: 1.55;
		color: var(--ink-2);
		margin: 0;
	}
	.systems-spacer { margin-top: clamp(40px, 4vw, 64px); }
</style>
