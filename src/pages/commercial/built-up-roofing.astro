---
import SystemPage from '../../components/v2/SystemPage.astro';
import { imagery } from '../../content/imagery';

const v2 = imagery.v2;
---

<SystemPage
	title="Built-up commercial roofing (BUR)"
	heroEyebrow="Commercial · multi-ply"
	heroHeading="Built-up roofing.<br />The classic that still holds."
	heroLede="Multiple plies of asphalt-saturated felt + hot asphalt + a gravel or granulated cap. The original commercial flat roof. Still right for some buildings — we tell you when."
	heroPhoto={v2.pageHeros.builtUpRoofing}
	bleedPhoto={v2.bleeds.commercial}
	bleedHeading="Three to five plies.<br />Redundancy in the membrane itself."
	overview={{
		eyebrow: 'What BUR is',
		heading: 'Asphalt + felt + ballast.',
		body: "Built-up roofing layers asphalt-saturated felts with hot asphalt between them, three to five plies thick, then finishes with a flood coat of asphalt embedded with gravel or a granulated cap sheet. It predates single-ply by decades and was the dominant flat-roof system from the 1920s through the 1990s. A correctly-installed BUR runs 20–30 years, sometimes longer."
	}}
	keyPoints={[
		{
			heading: "Where BUR still fits.",
			body: "BUR is right for buildings where the spec calls for it, where puncture resistance and ballast weight are advantages, and where the budget tolerates a labor-intensive install. Industrial sites, public buildings, and historical structures with existing BUR roofs are the typical fits.",
			bullets: ['Industrial, manufacturing, government', 'Heavy-duty roof environments', 'Existing BUR re-roof candidates', 'Specifications that explicitly call for BUR'],
			photo: v2.systemTiles.bur,
			photoSide: 'left',
		},
		{
			heading: 'Hot vs cold-applied.',
			body: "Hot-mopped BUR uses a kettle on-site to melt asphalt and bond each ply — the original method, still used where feasibility permits. Cold-applied uses adhesive in place of hot asphalt, removes the kettle hazard, and works on jobs where hot work isn't allowed.",
			bullets: ['Hot-mopped (traditional)', 'Cold-applied (adhesive-bonded)', 'Aggregate-surfaced or smooth cap'],
			photo: v2.bleeds.workmanship,
			photoSide: 'right',
		},
	]}
	stats={[
		{ value: '20–30', label: 'Years typical service life' },
		{ value: '3–5', label: 'Plies in the membrane' },
		{ value: 'Class A', label: 'Fire rating · UL 790' },
		{ value: 'High', label: 'Ballast weight (psf)' },
	]}
	projectPhotos={[v2.projects[6], v2.projects[5], v2.projects[3], v2.projects[8]]}
	projectCaptions={['BUR restoration, industrial', 'Built-up replacement, multi-tenant', 'BUR + flashing rebuild', 'Aggregate-surfaced BUR']}
	faq={[
		{ q: 'Why is BUR still on the spec sheet?', a: "<p>Because it works. A 3- to 5-ply BUR is mechanically the most redundant membrane you can install. Public buildings, industrial sites, and some historic specifications still call for BUR explicitly. We don't push it on jobs where mod-bit or single-ply would be a better fit, but where it's right, it's right.</p>" },
		{ q: 'Is the kettle a problem?', a: '<p>It can be. Hot-mopped BUR requires a kettle, hot-pipe, and trained crew, and hot work isn\'t allowed on every site. Cold-applied BUR removes the kettle while keeping the multi-ply membrane structure. We use the method the site allows.</p>' },
		{ q: 'BUR vs mod-bit?', a: "<p>Mod-bit is BUR's modern successor — fewer plies, polymer-modified for tensile strength, faster to install. Mod-bit wins on most jobs. BUR wins where the spec calls for it, where the existing roof is BUR and a like-replacement is the easiest path, and where ballast weight is an asset (it is, on some industrial roofs).</p>" },
		{ q: 'How long does it last?', a: "<p>20–30 years properly installed. Longer with periodic flood-coating and ballast maintenance. The failure point on BUR is almost never the field — it's flashings, drains, and edges.</p>" },
	]}
	ctaHeading="BUR walkthrough,<br />scope, and bid in a week."
	ctaLede="Free roof assessment. Honest answer on whether to stay with built-up or move to mod-bit."
	ctaPhoto={v2.pageHeros.commercial}
/>
