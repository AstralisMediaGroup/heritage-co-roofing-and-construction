---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroPage from '../../components/v2/HeroPage.astro';
import PromiseStrip from '../../components/v2/PromiseStrip.astro';
import SectionHead from '../../components/v2/SectionHead.astro';
import ToggleFacts from '../../components/v2/ToggleFacts.astro';
import TileGrid from '../../components/v2/TileGrid.astro';
import PageCTA from '../../components/v2/PageCTA.astro';
import Reveal from '../../components/v2/Reveal.astro';
import { imagery } from '../../content/imagery';
import { otherSystems } from '../../content/commercialSystems';

const v2 = imagery.v2;
---

<BaseLayout
	title="Built-up roofing (BUR) — Heritage Co."
	description="Heritage Co. installs built-up tar-and-gravel roofing on commercial buildings across East Texas. Decades of proven service life on flat roofs."
>
	<HeroPage
		eyebrow="Commercial · multi-ply"
		heading="Built-up roofing."
		lede="Tar-and-gravel multi-layer system. Decades of proven service life. The legacy commercial standard — still the right answer on certain buildings."
		photo={v2.pageHeros.builtUpRoofing}
		primaryCta={{ label: 'Request a quote', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
		tier={2}
	/>

	<PromiseStrip items={['We install BUR', 'Multi-layer redundancy', '20–30 yr service life', 'Bonded + insured']} />

	<Reveal>
		<section class="page-section">
			<div class="container">
				<ToggleFacts facts={[
					{ label: 'What it is', body: 'Multiple plies of asphalt-saturated felt or fabric, bonded with hot or cold asphalt, topped with a layer of mineral aggregate (gravel) for UV and impact protection. The original commercial flat-roof system, dating back to the late 1800s.' },
					{ label: 'When we spec it', body: 'Re-roofs over an existing BUR where a like-for-like recover is the cleanest path. Buildings where the owner wants multi-ply redundancy and is OK with a heavier system. Roofs where the existing structure was specced for the dead load.' },
					{ label: 'When we skip it', body: 'Most new construction goes single-ply (TPO or EPDM) or modified bitumen now — lighter, faster install, comparable life. Coating restoration sometimes wins on tight budgets. The free assessment tells you which — see the other commercial systems below.' },
				]} />
			</div>
		</section>
	</Reveal>

	<Reveal>
		<section class="page-section section-tight">
			<div class="container">
				<SectionHead
					eyebrow="Other commercial systems"
					heading="Not BUR?<br />Here's the rest."
					lede="We install every major commercial roof type. Pick the one that fits the building."
					maxWidth="780px"
				/>
				<div class="systems-spacer">
					<TileGrid tiles={otherSystems('bur')} cols={3} style="photo-card" />
				</div>
			</div>
		</section>
	</Reveal>

	<PageCTA
		heading="Free roof assessment.<br />Real recommendation in a week."
		lede="We tell you whether built-up is the right call before we quote it."
		primaryCta={{ label: 'Request a quote', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
		photo={v2.pageHeros.commercial}
	/>
</BaseLayout>

<style>
	.page-section { padding: clamp(64px, 7vw, 112px) 0; }
	.section-tight { padding-top: clamp(40px, 4vw, 64px); }
	.systems-spacer { margin-top: clamp(40px, 4vw, 64px); }
</style>
