---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroPage from '../../components/v2/HeroPage.astro';
import PromiseStrip from '../../components/v2/PromiseStrip.astro';
import SectionHead from '../../components/v2/SectionHead.astro';
import ToggleFacts from '../../components/v2/ToggleFacts.astro';
import TileGrid from '../../components/v2/TileGrid.astro';
import PageCTA from '../../components/v2/PageCTA.astro';
import Reveal from '../../components/v2/Reveal.astro';
import { imagery } from '../../content/imagery';
import { otherSystems } from '../../content/commercialSystems';

const v2 = imagery.v2;
---

<BaseLayout
	title="Commercial roof maintenance programs — Heritage Co."
	description="Scheduled inspection, minor-repair cadence, and warranty protection for commercial roofs across East Texas."
>
	<HeroPage
		eyebrow="Commercial · maintenance"
		heading="Maintenance programs."
		lede="Scheduled inspection and minor-repair cadence. Catches problems before they leak. Protects the manufacturer warranty. The difference between a 20-year roof and a 30-year roof."
		photo={v2.pageHeros.maintenance}
		primaryCta={{ label: 'Request a program quote', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
		tier={2}
	/>

	<PromiseStrip items={['Scheduled inspections', 'Minor-repair cadence', 'Warranty protection', 'Bonded + insured']} />

	<Reveal>
		<section class="page-section">
			<div class="container">
				<ToggleFacts facts={[
					{ label: 'What it is', body: 'A scheduled cadence of roof inspections (annual, semi-annual, or quarterly) plus minor-repair work — sealing penetrations, clearing drains, fixing flashing — that compounds into significant life extension. Most manufacturer warranties require regular maintenance to stay valid.' },
					{ label: 'When we spec it', body: 'Owners with a portfolio of buildings who want a single point of contact and predictable annual roof spend. Newer roofs under manufacturer warranty that require documented inspections to stay valid. Older roofs where deferred maintenance is starting to compound.' },
					{ label: 'When we skip it', body: 'A roof that is past its useful life and leaking now usually needs full replacement, not maintenance. Coatings or recovers may be a better next-step there. The free assessment tells you which — see the other commercial systems below.' },
				]} />
			</div>
		</section>
	</Reveal>

	<Reveal>
		<section class="page-section section-tight">
			<div class="container">
				<SectionHead
					eyebrow="Other commercial systems"
					heading="Need a new roof,<br />not maintenance?"
					lede="We install every major commercial roof type. Pick the one that fits the building."
					maxWidth="780px"
				/>
				<div class="systems-spacer">
					<TileGrid tiles={otherSystems('maintenance')} cols={3} style="photo-card" />
				</div>
			</div>
		</section>
	</Reveal>

	<PageCTA
		heading="Free roof assessment.<br />Maintenance plan in a week."
		lede="We tell you whether a maintenance program makes sense for your building before we quote it."
		primaryCta={{ label: 'Request a program quote', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
		photo={v2.pageHeros.commercial}
	/>
</BaseLayout>

<style>
	.page-section { padding: clamp(64px, 7vw, 112px) 0; }
	.section-tight { padding-top: clamp(40px, 4vw, 64px); }
	.systems-spacer { margin-top: clamp(40px, 4vw, 64px); }
</style>
