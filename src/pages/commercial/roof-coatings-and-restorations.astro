---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroPage from '../../components/v2/HeroPage.astro';
import PromiseStrip from '../../components/v2/PromiseStrip.astro';
import SectionHead from '../../components/v2/SectionHead.astro';
import ToggleFacts from '../../components/v2/ToggleFacts.astro';
import TileGrid from '../../components/v2/TileGrid.astro';
import PageCTA from '../../components/v2/PageCTA.astro';
import Reveal from '../../components/v2/Reveal.astro';
import { imagery } from '../../content/imagery';
import { otherSystems } from '../../content/commercialSystems';

const v2 = imagery.v2;
---

<BaseLayout
	title="Roof coatings + restoration — Heritage Co."
	description="Silicone and acrylic roof coatings restore existing commercial roofs across East Texas. Adds 10–15 years without a tear-off."
>
	<HeroPage
		eyebrow="Commercial · restoration"
		heading="Coatings + restoration."
		lede="Silicone or acrylic spray-applied coating over your existing roof. Adds 10–15 years of life and reflective surface. No tear-off, no disposal cost, building stays open."
		photo={v2.pageHeros.coatings}
		primaryCta={{ label: 'Request a quote', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
		tier={2}
	/>

	<PromiseStrip items={['We coat + restore', 'No tear-off', '10–15 yr life extension', 'Bonded + insured']} />

	<Reveal>
		<section class="page-section">
			<div class="container">
				<ToggleFacts facts={[
					{ label: 'What it is', body: 'A liquid-applied membrane (silicone, acrylic, or polyurethane) sprayed or rolled over an existing flat or low-slope roof. Bonds to the existing surface, seals seams and minor punctures, and adds a fresh reflective topcoat with manufacturer-backed warranty.' },
					{ label: 'When we spec it', body: 'The existing roof has 60%+ life remaining structurally but the surface is failing. Owner wants to defer a full re-roof. Building cannot tolerate the noise/disruption of tear-off. Tight budget that needs a 10–15 year solution rather than 25+.' },
					{ label: 'When we skip it', body: "Wet insulation underneath, ponding water that won't resolve, or substrate that has already failed — coatings cannot fix structural problems. Those need tear-off and replacement. The free assessment tells you which — see the other commercial systems below." },
				]} />
			</div>
		</section>
	</Reveal>

	<Reveal>
		<section class="page-section section-tight">
			<div class="container">
				<SectionHead
					eyebrow="Other commercial systems"
					heading="Not coatings?<br />Here's the rest."
					lede="We install every major commercial roof type. Pick the one that fits the building."
					maxWidth="780px"
				/>
				<div class="systems-spacer">
					<TileGrid tiles={otherSystems('coatings')} cols={3} style="photo-card" />
				</div>
			</div>
		</section>
	</Reveal>

	<PageCTA
		heading="Free roof assessment.<br />Real recommendation in a week."
		lede="We tell you whether a coating is the right call before we quote it."
		primaryCta={{ label: 'Request a quote', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
		photo={v2.pageHeros.commercial}
	/>
</BaseLayout>

<style>
	.page-section { padding: clamp(64px, 7vw, 112px) 0; }
	.section-tight { padding-top: clamp(40px, 4vw, 64px); }
	.systems-spacer { margin-top: clamp(40px, 4vw, 64px); }
</style>
