---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroPage from '../../components/v2/HeroPage.astro';
import PromiseStrip from '../../components/v2/PromiseStrip.astro';
import SectionHead from '../../components/v2/SectionHead.astro';
import ToggleFacts from '../../components/v2/ToggleFacts.astro';
import TileGrid from '../../components/v2/TileGrid.astro';
import PageCTA from '../../components/v2/PageCTA.astro';
import Reveal from '../../components/v2/Reveal.astro';
import { imagery } from '../../content/imagery';
import { otherSystems } from '../../content/commercialSystems';

const v2 = imagery.v2;
---

<BaseLayout
	title="EPDM commercial roofing — Heritage Co."
	description="Heritage Co. installs EPDM single-ply rubber membrane on commercial roofs across East Texas. Black synthetic rubber, 25+ year service life."
>
	<HeroPage
		eyebrow="Commercial · single-ply"
		heading="EPDM."
		lede="Black synthetic-rubber single-ply membrane. The cold-climate workhorse and the right call on certain re-roofs where the existing system is already EPDM."
		photo={v2.pageHeros.epdmRoofing}
		primaryCta={{ label: 'Request a quote', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
		tier={2}
	/>

	<PromiseStrip items={['We install EPDM', 'Seam-taped + adhered', '25+ yr service life', 'Bonded + insured']} />

	<Reveal>
		<section class="page-section">
			<div class="container">
				<ToggleFacts facts={[
					{ label: 'What it is', body: 'Single-ply rubber membrane (ethylene propylene diene monomer) installed in wide sheets and bonded with seam tape or adhesive. Excellent flexibility across temperature swings, proven 40-year track record on commercial roofs.' },
					{ label: 'When we spec it', body: 'Cold-climate jobs where TPO seam reliability is a question. Re-roofs where the existing system is already EPDM and a like-for-like recover is the cleanest path. Buildings where black absorptive surface is acceptable or preferred (heating-dominated load).' },
					{ label: 'When we skip it', body: 'East Texas summer load usually favors a reflective TPO membrane over EPDM. Heavy foot traffic favors mod-bit. The free assessment tells you which — see the other commercial systems below.' },
				]} />
			</div>
		</section>
	</Reveal>

	<Reveal>
		<section class="page-section section-tight">
			<div class="container">
				<SectionHead
					eyebrow="Other commercial systems"
					heading="Not EPDM?<br />Here's the rest."
					lede="We install every major commercial roof type. Pick the one that fits the building."
					maxWidth="780px"
				/>
				<div class="systems-spacer">
					<TileGrid tiles={otherSystems('epdm')} cols={3} style="photo-card" />
				</div>
			</div>
		</section>
	</Reveal>

	<PageCTA
		heading="Free roof assessment.<br />Real recommendation in a week."
		lede="We tell you whether EPDM is the right call before we quote it."
		primaryCta={{ label: 'Request a quote', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
		photo={v2.pageHeros.commercial}
	/>
</BaseLayout>

<style>
	.page-section { padding: clamp(64px, 7vw, 112px) 0; }
	.section-tight { padding-top: clamp(40px, 4vw, 64px); }
	.systems-spacer { margin-top: clamp(40px, 4vw, 64px); }
</style>
