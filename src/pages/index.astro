---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroFlagship from '../components/v2/HeroFlagship.astro';
import TrustMarquee from '../components/v2/TrustMarquee.astro';
import SectionHead from '../components/v2/SectionHead.astro';
import PhotoLede from '../components/v2/PhotoLede.astro';
import PhotoBleed from '../components/v2/PhotoBleed.astro';
import StatBand from '../components/v2/StatBand.astro';
import ProcessSteps from '../components/v2/ProcessSteps.astro';
import CrewBlock from '../components/v2/CrewBlock.astro';
import ReviewBlock from '../components/v2/ReviewBlock.astro';
import PageCTA from '../components/v2/PageCTA.astro';
import Reveal from '../components/v2/Reveal.astro';
import { imagery } from '../content/imagery';

const v2 = imagery.v2;

const reviews = [
	{ quote: 'They answered the phone the first time, showed up the next morning, and the roof was on inside a week.', name: 'Reviewer placeholder', city: 'Tyler, TX', project: 'Asphalt re-roof', rating: 5 },
	{ quote: 'Same crew start to finish. They worked with my adjuster — I barely had to do anything.', name: 'Reviewer placeholder', city: 'Longview, TX', project: 'Storm damage', rating: 5 },
	{ quote: 'Actual people. Local truck. Came back twice in the next month to check on it.', name: 'Reviewer placeholder', city: 'Marshall, TX', project: 'Metal install', rating: 5 },
];

const process = [
	{ heading: 'Inspect', body: 'Free roof inspection from a real person on the ladder. We document everything — shingles, flashing, decking, ventilation.' },
	{ heading: 'Quote', body: 'Same-day or next-day written quote. No upsell pressure. We tell you the system, the warranty, and the timeline.' },
	{ heading: 'Install', body: 'Most residential roofs install in one day. Our crews live in your area, work in your area, and clean up before they leave.' },
	{ heading: 'Stand behind', body: 'Workmanship and material warranties on every job. Call about a question in 2030 and the same shop is still here.' },
];
---

<BaseLayout
	title="Heritage Co. Roofing & Construction — East Texas + Central Arkansas"
	description="Locally owned roofing in East Texas and Central Arkansas. Free inspections, same-day quotes, real warranties. Headquartered in Longview, TX."
>
	<HeroFlagship
		eyebrow="Locally owned · Longview, TX"
		heading="Roofs done right.<br />Built to last."
		lede="Heritage Co. is locally owned and operated in East Texas and Central Arkansas. When you call us, you get us — not a national call center."
		photo={v2.pageHeros.home}
		bullets={['Free roof inspections', 'Same-day or next-day quotes', 'Workmanship + material warranties']}
		primaryCta={{ label: 'Get my free inspection', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
	/>

	<TrustMarquee items={v2.trustItems} />

	<Reveal>
		<section class="page-section section-tight">
			<div class="container">
				<SectionHead
					eyebrow="What kind of roof do you need?"
					heading="We do both. The work is different for each."
					maxWidth="780px"
				/>
			</div>
		</section>
	</Reveal>

	<Reveal>
		<section class="page-section section-tight-bottom">
			<div class="container">
				<PhotoLede
					photo={v2.pageHeros.residential}
					eyebrow="For homeowners"
					heading="Roofs for your home."
					body="Replacement, repair, and storm damage. Insurance accepted. Free inspections, same-day quotes. Most residential roofs install in a single day."
					bullets={['Asphalt shingle, metal, and tile', 'Insurance claim handling', 'Workmanship + material warranties']}
					cta={{ label: 'See residential services →', href: '/residential' }}
					photoSide="left"
				/>
			</div>
		</section>
	</Reveal>

	<Reveal>
		<section class="page-section">
			<div class="container">
				<PhotoLede
					photo={v2.pageHeros.commercial}
					eyebrow="For businesses"
					heading="Roofs for your business."
					body="New construction, re-roofs, restoration, and maintenance programs. Bonded and insured. We install every major commercial system."
					bullets={['TPO, EPDM, mod-bit, BUR, metal, coatings', 'Maintenance + roof asset management', 'Bonded + insured']}
					cta={{ label: 'See commercial systems →', href: '/commercial' }}
					photoSide="right"
				/>
			</div>
		</section>
	</Reveal>

	<PhotoBleed
		photo={v2.bleeds.home}
		heading="We're 30 minutes away."
		caption="Crews live across East Texas and Central Arkansas. After the install, we're not gone. Call about a question in 2030 — same shop, same number."
		overlay={true}
		heightVw={68}
	/>

	<StatBand stats={[
		{ value: '30+', label: 'Combined years roofing', numericValue: 30, suffix: '+' },
		{ value: '14', label: 'Service-area cities · TX + AR', numericValue: 14 },
		{ value: '1 day', label: 'Typical residential install' },
		{ value: 'A+', label: 'BBB rating · pending confirm' },
	]} />

	<Reveal>
		<section class="page-section">
			<div class="container">
				<SectionHead
					eyebrow="How we work"
					heading="Free inspection. Real quote. Real warranty."
					lede="Same person from inspection through warranty. No call-center, no script."
					maxWidth="720px"
				/>
				<div class="process-spacer">
					<ProcessSteps steps={process} />
				</div>
			</div>
		</section>
	</Reveal>

	<CrewBlock />

	<Reveal>
		<section class="page-section">
			<div class="container">
				<SectionHead
					eyebrow="From our customers"
					heading="What people in your zip code have said."
					lede="Three reviews below. Names and projects are placeholders until Heritage gets permission to publish."
					maxWidth="720px"
				/>
				<div class="reviews-spacer">
					<ReviewBlock reviews={reviews} />
				</div>
			</div>
		</section>
	</Reveal>

	<PageCTA
		heading="Free roof inspection.<br />Real quote in a day."
		lede="No obligation. Same-day or next-day quote. Real person on the ladder."
		primaryCta={{ label: 'Schedule online', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
		photo={v2.pageHeros.freeInspection}
	/>
</BaseLayout>

<style>
	.page-section { padding: clamp(80px, 9vw, 144px) 0; }
	.section-tight { padding: clamp(72px, 8vw, 120px) 0 clamp(20px, 2vw, 32px); }
	.section-tight-bottom { padding-top: clamp(40px, 5vw, 80px); padding-bottom: clamp(40px, 5vw, 80px); }
	.process-spacer { margin-top: clamp(56px, 6vw, 88px); }
	.reviews-spacer { margin-top: clamp(48px, 5vw, 72px); }
</style>
