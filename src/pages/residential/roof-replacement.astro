---
import SystemPage from '../../components/v2/SystemPage.astro';
import { imagery } from '../../content/imagery';

const v2 = imagery.v2;
---

<SystemPage
	title="Roof replacement"
	heroEyebrow="Residential · service"
	heroHeading="Roof replacement.<br />Most install in one day."
	heroLede="Tear-off and full re-roof for East Texas and Central Arkansas homes. Asphalt, metal, or tile. Same crew start to finish. Insurance accepted."
	heroPhoto={v2.pageHeros.roofReplacement}
	heroCta={{ label: 'Get my free inspection', href: '/free-inspection' }}
	bleedPhoto={v2.bleeds.workmanship}
	bleedHeading="Tear off in the morning.<br />Cleaned up before sundown."
	overview={{
		eyebrow: 'What replacement looks like',
		heading: 'Same crew. One day. Real warranty.',
		body: "A residential re-roof is a one-day job for most East Texas houses — tear-off in the morning, decking inspection and any repairs midday, dry-in by early afternoon, finished and cleaned up before the crew leaves. The same people you talked to on the inspection are the people on the ladder. The warranty starts the day we finish."
	}}
	keyPoints={[
		{
			heading: 'What we do on every replacement.',
			body: "Tear off the existing roof down to decking. Inspect every sheet of decking and replace anything soft. Install new ice-and-water shield at eaves and valleys. Synthetic underlayment over the field. Drip edge, starter strip, shingles, ridge cap. New flashings at every penetration. Photo-document everything.",
			bullets: ['Tear-off to decking', 'Decking inspection + repair', 'Ice-and-water shield + synthetic underlayment', 'New flashings at every penetration', 'Final clean-up + magnetic nail sweep'],
			photo: v2.serviceTiles.replacement,
			photoSide: 'left',
		},
		{
			heading: 'Insurance vs out-of-pocket.',
			body: "If your roof has hail or wind damage, your homeowners insurance likely covers the replacement minus your deductible. Heritage handles the adjuster, the documentation, and the supplements. If the roof is just old (no claim event), it's an out-of-pocket replacement and we work with you on financing options.",
			bullets: ['Insurance claim documentation', 'Adjuster meetings on-site', 'Supplement requests when underwriter undervalues'],
			photo: v2.bleeds.storm,
			photoSide: 'right',
		},
	]}
	stats={[
		{ value: '1 day', label: 'Typical install timeline' },
		{ value: '20–25', label: 'Years service · architectural asphalt' },
		{ value: '40+', label: 'Years service · standing seam metal' },
		{ value: '50+', label: 'Years · concrete tile' },
	]}
	projectPhotos={[v2.projects[0], v2.projects[1], v2.projects[6], v2.projects[7]]}
	projectCaptions={['Architectural re-roof, Tyler', 'Insurance replacement, Longview', 'Tear-off + decking, Marshall', 'Premium shingle install']}
	faq={[
		{ q: "How do I know if I need replacement vs repair?", a: "<p>Repair makes sense for a localized failure on a roof with 5+ years of life left. Replacement makes sense for a roof past 18 years (asphalt), with widespread damage, or when repair cost approaches 50% of replacement cost. We give you both numbers on the inspection so the math is on the page, not in our head.</p>" },
		{ q: "Will my premium go up if I file a claim?", a: "<p>No. Texas insurance premiums don't go up on a single weather-related claim filed properly. (General guidance — your specific carrier and policy govern. We're not insurance professionals.)</p>" },
		{ q: "How long does it actually take?", a: "<p>Most residential re-roofs install in one day. Larger or steeper homes can run two days. The timeline depends on square footage, slope, decking condition, and weather. We tell you the timeline on the proposal.</p>" },
		{ q: "What about the warranty?", a: "<p>Manufacturer warranty (typically 30 years to limited-lifetime on architectural shingles, 30–40 years on metal paint, 50+ on tile) plus Heritage workmanship warranty on the install. Specific terms on the proposal.</p>" },
		{ q: "What if it rains during the install?", a: "<p>We don't tear off in active rain. If weather changes mid-install, we dry-in the exposed area with synthetic underlayment and ice-and-water shield — your house stays dry. We finish the next clear day at no additional cost.</p>" },
	]}
	ctaHeading="Free inspection.<br />Real quote in a day."
	ctaLede="Same-day or next-day quote. Real person on the ladder."
	ctaPhoto={v2.pageHeros.freeInspection}
	ctaPrimary={{ label: 'Get my free inspection', href: '/free-inspection' }}
	promises={['Insurance accepted', 'Workmanship + material warranties', 'Free inspections']}
/>
