---
import SystemPage from '../../components/v2/SystemPage.astro';
import { imagery } from '../../content/imagery';

const v2 = imagery.v2;
---

<SystemPage
	title="Tile roofs · residential"
	heroEyebrow="Residential · materials"
	heroHeading="Tile roofs.<br />50+ year roofs."
	heroLede="Concrete and synthetic tile for East Texas homes. Class A fire, Class 4 hail (flat profile), 50+ year service life. Structural feasibility comes first — we say so honestly."
	heroPhoto={v2.pageHeros.tileRoofs}
	heroCta={{ label: 'Get my free inspection', href: '/free-inspection' }}
	bleedPhoto={v2.bleeds.workmanship}
	bleedHeading="Class A fire.<br />Color built into the body."
	overview={{
		eyebrow: 'Why tile',
		heading: "A roof you put on once, sized for the building it's on.",
		body: "Tile is the longest-life residential roof material — 50+ years on concrete, more on clay, lifetime-rated on synthetic. Class A fire rating is structural; Class 4 hail rating applies to flat-profile tiles; the color is body-through, not a coating, so weathering doesn't change the look. The constraint is structural — most East Texas homes are built for asphalt loading, and a switch to concrete tile sometimes requires reinforcement. We do the engineering check first."
	}}
	keyPoints={[
		{
			heading: 'Concrete tile — Eagle Roofing Products.',
			body: "Eagle is the regional concrete tile leader. Tapered Slate, Copper Series, and the color blend lines (Walnut Creek, Kings Canyon, Light Gray Range) give a tile look without the structural penalty of clay. Body-through color, 50-year warranty, Class A/Class 4 ratings.",
			bullets: ['Eagle Roofing Products — primary supplier', 'Body-through color (no fade)', 'Class A fire · Class 4 hail (flat profile)', '50-year warranty standard'],
			photo: v2.materialTiles.tile,
			photoSide: 'left',
		},
		{
			heading: 'Synthetic tile — DaVinci, Brava.',
			body: "Synthetic (composite) tile mimics slate or shake at a fraction of the structural load. DaVinci Roofscapes and Brava Roof Tile lead the category. Lifetime-rated, lighter than concrete, easier to retrofit on homes designed for asphalt. Premium-tier pricing.",
			bullets: ['DaVinci Roofscapes, Brava Roof Tile', 'Lifetime warranty', 'Lighter than concrete · easier retrofit', 'Slate or shake aesthetic without the weight'],
			photo: v2.bleeds.workmanship,
			photoSide: 'right',
		},
	]}
	stats={[
		{ value: '50+', label: 'Years service life · concrete' },
		{ value: 'Class A', label: 'Fire rating · UL 790' },
		{ value: '180mph', label: 'Wind rating · Miami-Dade tested' },
		{ value: 'Body', label: 'Through-color · no fade' },
	]}
	projectPhotos={[v2.projects[1], v2.projects[3], v2.projects[7], v2.projects[8]]}
	projectCaptions={['Eagle Tapered Slate, custom home', 'Synthetic shake retrofit, Tyler', 'Concrete tile re-roof, Marshall', 'Full tile install with skylights']}
	faq={[
		{ q: 'Will my house support tile?', a: "<p>Most East Texas homes are framed for asphalt loading (~3 psf). Concrete tile lands at ~9–11 psf. The structural check is the first thing we do on a tile inspection — sometimes the answer is 'yes, no reinforcement needed,' sometimes it's 'yes with sistered rafters,' and sometimes it's 'no, look at synthetic instead.' Synthetic tile lands at ~2–3 psf and retrofits onto asphalt-spec framing without reinforcement.</p>" },
		{ q: 'Concrete or synthetic?', a: "<p>Concrete if the structure supports it and the budget is in range — it's cheaper than synthetic and the look is hard to beat. Synthetic if the structure doesn't support concrete, or if you want a slate or shake aesthetic that concrete can't fully replicate.</p>" },
		{ q: 'How much heavier than asphalt?', a: '<p>Asphalt: ~3 psf. Synthetic tile: ~2–3 psf. Concrete tile: ~9–11 psf. Clay tile: ~12–15 psf. We do the load math on the inspection.</p>' },
		{ q: "What about clay?", a: "<p>Clay tile is the longest-life option (often outlasts the building) but the structural penalty is significant. We install clay where the structure supports it and the homeowner specifically wants it. Concrete and synthetic cover most of the design-intent for less weight and lower cost.</p>" },
		{ q: 'How long does it actually last?', a: '<p>Concrete tile: 50+ years documented. Clay: 75+. Synthetic: lifetime-rated by manufacturer (DaVinci, Brava). The roof itself outlasts most owners — flashings and ridge caps are the maintenance items, not the field tile.</p>' },
	]}
	ctaHeading="Free inspection.<br />Structural check first."
	ctaLede="We tell you whether tile fits your house before we quote it."
	ctaPhoto={v2.pageHeros.freeInspection}
	ctaPrimary={{ label: 'Get my free inspection', href: '/free-inspection' }}
	promises={['Insurance accepted', '50+ yr warranty', 'Locally owned + crewed']}
/>
