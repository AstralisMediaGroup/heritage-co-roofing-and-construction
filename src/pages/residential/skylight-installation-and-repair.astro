---
import SystemPage from '../../components/v2/SystemPage.astro';
import { imagery } from '../../content/imagery';

const v2 = imagery.v2;
---

<SystemPage
	title="Skylight installation and repair"
	heroEyebrow="Residential · service"
	heroHeading="Skylights.<br />The flashing decides everything."
	heroLede="Velux and Fakro skylights. Curb-mounted and deck-mounted. Replacement and repair. Most skylight leaks come from the flashing, not the skylight — we diagnose to the source."
	heroPhoto={v2.pageHeros.skylight}
	heroCta={{ label: 'Get my free inspection', href: '/free-inspection' }}
	bleedPhoto={v2.bleeds.workmanship}
	bleedHeading="Curb. Apron. Step.<br />Counter. Saddle."
	overview={{
		eyebrow: 'Why skylights leak',
		heading: 'It is almost always the flashing.',
		body: "Skylight glass and frames don't usually fail — flashing kits do. The kit is a five-piece system (curb, apron, step, counter, saddle) and any one of them being installed wrong or aging out lets water in. We diagnose to the source on the inspection. Often the fix is a flashing rebuild, not a skylight replacement."
	}}
	keyPoints={[
		{
			heading: 'New installation.',
			body: 'Velux is the dominant manufacturer; Fakro is a strong alternative. Curb-mounted (raised box around the opening) is more flashing-tolerant in heavy weather. Deck-mounted (low-profile, factory-fitted to the roof slope) is cleaner-looking and more efficient at shedding water on simple roofs.',
			bullets: ['Velux, Fakro — primary brands', 'Curb-mounted (most weather-tolerant)', 'Deck-mounted (low-profile, sleek)', 'Solar-powered venting available (Velux VSS)'],
			photo: v2.serviceTiles.skylight,
			photoSide: 'left',
		},
		{
			heading: 'Repair and replacement.',
			body: 'Most skylight repairs are flashing rebuilds — we strip the kit, inspect the curb or deck, and re-flash with a fresh kit and ice-and-water shield. Frame and seal repair only when the unit itself has failed (rare on units under 15 years old). Full replacement makes sense on units past 20.',
			bullets: ['Flashing kit rebuild (most common fix)', 'Seal + frame repair', 'Full unit replacement (20+ year units)'],
			photo: v2.bleeds.workmanship,
			photoSide: 'right',
		},
	]}
	faq={[
		{ q: "Why does my skylight leak when there's no rain?", a: '<p>Condensation. Warm humid interior air hits the cold glass surface and water collects on the inside. Looks like a leak. The fix is ventilation in the room below, not skylight replacement.</p>' },
		{ q: "How long does a skylight last?", a: '<p>Velux units carry a 10-year glass warranty and typically run 20–25 years before replacement. Flashing kits last 15–20 with a quality install. Most "skylight failures" we see are flashing failures, not unit failures.</p>' },
		{ q: "Curb or deck mount?", a: '<p>Curb-mount on roofs with weather-prone exposure or steep slope. Deck-mount on simple roofs where appearance matters and the slope sheds water cleanly. We tell you which fits your roof.</p>' },
		{ q: "Can you add one to my existing roof?", a: '<p>Yes — but cleanest if we cut the opening during a re-roof. Adding a skylight to an existing roof requires opening the deck, framing the curb (curb-mount) or the deck-mount cutout, full flashing kit, and shingle integration. We do them as standalone jobs but the math usually points toward bundling with replacement.</p>' },
	]}
	ctaHeading="Skylight inspection.<br />We can tell where it's leaking."
	ctaLede="Free inspection. Most skylight leaks are flashing problems with a known fix."
	ctaPhoto={v2.pageHeros.freeInspection}
	ctaPrimary={{ label: 'Get my free inspection', href: '/free-inspection' }}
/>
