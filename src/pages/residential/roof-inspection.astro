---
import SystemPage from '../../components/v2/SystemPage.astro';
import { imagery } from '../../content/imagery';

const v2 = imagery.v2;
---

<SystemPage
	title="Roof inspection"
	heroEyebrow="Residential · service"
	heroHeading="Free roof inspection.<br />Real person on the ladder."
	heroLede="Free roof inspection from a Heritage crew member, not a salesperson. Photos, documented findings, written report — whether you need work or not."
	heroPhoto={v2.pageHeros.roofInspection}
	heroCta={{ label: 'Schedule my inspection', href: '/free-inspection' }}
	bleedPhoto={v2.bleeds.workmanship}
	bleedHeading="Documented.<br />Photographed.<br />Yours to keep."
	overview={{
		eyebrow: 'What an inspection is',
		heading: 'A walk-and-document. Not a sales pitch.',
		body: "Heritage inspections are free, no-obligation, and run by a roofer — not a sales rep. We climb the roof, walk the field, photograph every penetration and edge, look at decking and ventilation from inside the attic if access permits, and write a report with findings and (only if needed) a quote. If your roof is fine, we tell you that. If it needs work, we tell you what and price it."
	}}
	keyPoints={[
		{
			heading: 'What we look at.',
			body: "Field membrane condition, granule loss, shingle lift, flashings at every penetration, chimney step + counter flashing, valleys and ridges, gutters and drip edge, decking from above where visible, attic ventilation balance from inside if access is available.",
			bullets: ['Field condition + granule loss', 'Every penetration + flashing', 'Decking + structure from inside attic', 'Ventilation balance (intake + exhaust)'],
			photo: v2.serviceTiles.inspection,
			photoSide: 'left',
		},
		{
			heading: 'When you should book one.',
			body: "After any meaningful storm event (hail, high wind). Before buying or selling a house. When the roof hits 15 years (asphalt) or 25 years (metal). When you see a stain on a ceiling. As a yearly check-in if the roof is 12+ years old.",
			bullets: ['After any major storm', 'Pre-purchase or pre-sale', 'At 15 years (asphalt) / 25 (metal)', 'Annual check-in past year 12'],
			photo: v2.bleeds.storm,
			photoSide: 'right',
		},
	]}
	faq={[
		{ q: "Is it really free?", a: '<p>Yes. No upsell, no fine print. The inspection itself costs us about an hour of crew time and we treat it as a marketing cost — most homeowners we inspect end up calling us when they actually need work, and that\'s the math that pays for the inspection time.</p>' },
		{ q: "Will you tell me my roof is fine?", a: '<p>Yes, if it is. We don\'t fabricate work to do. The Founder Input page actively tracks our "no-work-needed" inspection rate as a quality metric. A roof that doesn\'t need a thing gets a written report saying so and a calendar reminder for the next inspection.</p>' },
		{ q: "Do I need to be home?", a: '<p>Preferred but not required. We can inspect with the homeowner away if exterior access is available, then text or call you with findings. Attic inspection (recommended) requires interior access.</p>' },
		{ q: "How long does it take?", a: '<p>30 to 60 minutes for most residential roofs. Longer for larger or steeper homes, or roofs with multiple slopes and complex flashings.</p>' },
		{ q: "What if I need work after?", a: '<p>You get a written quote with the work scope, the warranty, and the timeline. No high-pressure close. The quote is good for 30 days. Most homeowners take 1–2 weeks to decide.</p>' },
	]}
	ctaHeading="Free inspection.<br />No obligation."
	ctaLede="Same-day or next-day. Real person on the ladder. Written report whether you need work or not."
	ctaPhoto={v2.pageHeros.freeInspection}
	ctaPrimary={{ label: 'Schedule my inspection', href: '/free-inspection' }}
	promises={['Free + no obligation', 'Real person, not a salesperson', 'Written report']}
/>
