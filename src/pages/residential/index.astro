---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceTile from '../../components/ServiceTile.astro';
import LocalItem from '../../components/LocalItem.astro';
import WarrantyBlock from '../../components/WarrantyBlock.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import MaterialTabs from '../../components/MaterialTabs.astro';
import Accordion from '../../components/Accordion.astro';
import ColorSwatchGrid from '../../components/ColorSwatchGrid.astro';
import ProcessFlow from '../../components/ProcessFlow.astro';
import LayeredCard from '../../components/LayeredCard.astro';
import ConstrainedSection from '../../components/ConstrainedSection.astro';
import SplitScreenSection from '../../components/SplitScreenSection.astro';
import FullBleedSection from '../../components/FullBleedSection.astro';
import HeritagePlaceholder from '../../components/HeritagePlaceholder.astro';

const services = [
	{ label: 'Roof replacement', body: 'Full tear-off and install. Asphalt, metal, synthetic. Workmanship and material warranties.', gradient: 'linear-gradient(180deg, #6b8aa8 0%, #b8a78c 60%, #6b5d4a 100%)' },
	{ label: 'Roof repair', body: 'Leaks, missing shingles, flashing failures. Fast turnaround, no upsell.', gradient: 'linear-gradient(180deg, #8a6f54 0%, #5a4836 100%)' },
	{ label: 'Storm damage', body: 'Hail, wind, tree fall. We work directly with your insurance adjuster.', href: '/residential/storm-damage-roofing', gradient: 'linear-gradient(180deg, #4a4a48 0%, #6b5d4a 50%, #2a2a28 100%)' },
	{ label: 'Inspection', body: 'Free, no-obligation roof inspection. Honest report, photos included.', gradient: 'linear-gradient(180deg, #7d8b9e 0%, #b8a78c 100%)' },
	{ label: 'Maintenance', body: 'Annual checkups and tune-ups. Catch problems before they become claims.', gradient: 'linear-gradient(180deg, #c4b89e 0%, #8a7d63 100%)' },
	{ label: 'Insurance claims', body: 'Adjuster meetings, documentation, scope review. We handle the back-and-forth.', gradient: 'linear-gradient(180deg, #6b5d4a 0%, #4a4239 100%)' },
];

const materials = [
	{
		id: 'asphalt',
		name: 'Asphalt shingle',
		intro: 'The standard for East Texas residential. Lower up-front cost, wide color range, replaceable shingle-by-shingle on repairs.',
		gradient: 'linear-gradient(135deg, #8a6f54 0%, #5a4836 60%, #2a2a28 100%)',
		specs: [
			{ label: 'Service life', value: '20–30 years (architectural / dimensional)' },
			{ label: 'Hail rating', value: 'Class 3 or Class 4 impact-resistant available' },
			{ label: 'Repair', value: 'Shingle-by-shingle on damaged sections' },
			{ label: 'Cost band', value: 'Lowest of the three. Standard for insurance jobs.' },
		],
		manufacturerPlaceholder: "Preferred asphalt manufacturer Heritage stocks (e.g. GAF Timberline HDZ, Owens Corning Duration, CertainTeed Landmark) and the impact-rating line. See Founder Input page §2.",
	},
	{
		id: 'metal',
		name: 'Metal',
		intro: 'Longer service life, better in hail. Higher up-front. Standing seam or stamped-profile panel.',
		gradient: 'linear-gradient(135deg, #7d8b9e 0%, #4a5566 60%, #2a3035 100%)',
		specs: [
			{ label: 'Service life', value: '40–60 years' },
			{ label: 'Hail rating', value: 'Standing seam: Class 4 standard' },
			{ label: 'Repair', value: 'Panel replacement; seam-level fixes possible' },
			{ label: 'Cost band', value: 'Roughly 2–3× asphalt up-front, lower lifetime cost.' },
		],
		manufacturerPlaceholder: "Metal panel brand Heritage installs most often (e.g. McElroy, Mueller, Berridge) and standard gauges offered. See Founder Input page §2.",
	},
	{
		id: 'tile',
		name: 'Tile',
		intro: 'Slate-look, tile-look, or real concrete tile. Niche but worth the conversation if the roof line and the budget are right.',
		gradient: 'linear-gradient(135deg, #b8a78c 0%, #8a7d63 60%, #4a4239 100%)',
		specs: [
			{ label: 'Service life', value: '40–50 years (synthetic); 50+ (real tile)' },
			{ label: 'Hail rating', value: 'Synthetic: Class 4 standard. Real tile varies.' },
			{ label: 'Repair', value: 'Tile-by-tile or panel; specialty install.' },
			{ label: 'Cost band', value: '3–5× asphalt up-front. Worth it on the right home.' },
		],
		manufacturerPlaceholder: "Synthetic-tile or composite brand Heritage installs (e.g. DaVinci Roofscapes, Brava). See Founder Input page §2.",
	},
];

const process = [
	{ n: '01', h: 'Inspect', body: 'Free. We climb the roof, take photos, write it up.' },
	{ n: '02', h: 'Quote', body: 'Clear scope, clear pricing. No surprise line items, no pressure.' },
	{ n: '03', h: 'Install', body: 'Most residential roofs install in one day. Crews live in your area.' },
	{ n: '04', h: 'Stand behind', body: 'Workmanship and material warranties. Owner-direct line if anything needs attention.' },
];

const faqs = [
	{
		q: 'Do you handle small repairs, or only full replacements?',
		a: 'Both. A missing shingle, a piece of flashing, a leak around a chimney — those are fast jobs and we do not pad them into a tear-off pitch. If the roof is genuinely past repair, we say so and put numbers next to both options.',
	},
	{
		q: 'How long will my install take?',
		a: 'Most residential roofs install in one day. Larger or steeper roofs can run two. Weather can stretch the schedule by a day; we tell you before we start, not after.',
	},
	{
		q: 'What does your warranty cover, and for how long?',
		a: 'There are two warranties on every Heritage Co. roof — workmanship from us, and material pass-through from the manufacturer. Specific years and transferability are below.',
		placeholderFact: 'Workmanship warranty length (years), manufacturer pass-through length (years), transferable on home sale Y/N. See Founder Input page §1.',
	},
	{
		q: 'Do you take insurance jobs, or only out-of-pocket?',
		a: 'Both. Storm-damage claims are common in East Texas — see the storm damage page for how that process runs. Out-of-pocket replacements use the same crew, same materials, same warranty.',
	},
	{
		q: 'Do I have to be home for the inspection or install?',
		a: 'For the inspection, no — we work outside and the attic when accessible. For the install, no, but it helps if we can reach you for any judgment call. We coordinate access in advance either way.',
	},
	{
		q: 'Is there financing if my deductible is large or I am paying out-of-pocket?',
		a: 'Financing options vary by job. The specifics are below.',
		placeholderFact: 'Financing partners (GreenSky, Service Finance, Hearth, in-house, none) and typical promo terms (e.g. 0% for 18 months). Insurance-deductible payment plans Y/N. See Founder Input page §4.',
	},
	{
		q: 'What happens if I have a leak again three years from now?',
		a: 'You call us. The workmanship warranty covers our install for the term, and we are 30 minutes away. We do not disappear after the truck pulls out.',
	},
	{
		q: 'What other homes in my zip code have you done?',
		a: 'Specific addresses go to references on request. Recent named jobs are below.',
		placeholderFact: 'Named recent residential jobs Heritage has permission to publish — city and rough month/year is enough. See Founder Input page §5.',
	},
];
---

<BaseLayout title="Residential Roofing — Heritage Co.">
	<!-- Hero -->
	<section class="hero">
		<div class="hero-photo" aria-hidden="true"></div>
		<div class="hero-overlay" aria-hidden="true"></div>
		<div class="hero-content">
			<p class="hero-eyebrow">For homeowners</p>
			<h1 class="hero-h1">Roofs for your home.</h1>
			<p class="hero-sub">
				Replacement, repair, and storm damage. Insurance accepted. Free inspections. The same shop is still around if something needs attention next year.
			</p>
			<div class="hero-cta-row">
				<a class="cta-primary" href="/#inspection">Get my free inspection</a>
				<a class="cta-secondary" href="tel:9032428102">Call 903-242-8102</a>
			</div>
		</div>
	</section>

	<!-- Service grid -->
	<section class="services">
		<p class="section-eyebrow">What we do</p>
		<h2 class="section-h">Residential services.</h2>
		<p class="section-sub">Six things we are good at, on every house.</p>
		<div class="service-grid">
			{services.map((s) => <ServiceTile label={s.label} body={s.body} href={s.href} photo={true} gradient={s.gradient} />)}
		</div>
	</section>

	<!-- Split-screen: residential focus -->
	<SplitScreenSection
		imageSide="left"
		gradient="linear-gradient(180deg, #6b8aa8 0%, #b8a78c 60%, #6b5d4a 100%)"
		background="ivory"
		minHeight="440px"
	>
		<p class="ss-eyebrow">For homeowners</p>
		<h2 class="ss-h">Six things on every house.</h2>
		<p class="ss-body">Replacement, repair, storm damage, inspection, maintenance, insurance claims. We do all six. The first three are the most common in East Texas; the last three are how we keep a roof out of trouble in the first place.</p>
		<a class="ss-cta" href="/#inspection">Get my free inspection</a>
	</SplitScreenSection>

	<!-- Materials (MaterialTabs — interactive) -->
	<section class="materials">
		<p class="section-eyebrow">Materials</p>
		<h2 class="section-h">What we install.</h2>
		<p class="section-sub">A short read, not a manufacturer brochure. We talk trade-offs at the inspection.</p>
		<MaterialTabs materials={materials} />
		<p class="materials-attribution">Product photography courtesy of GAF, Owens Corning, CertainTeed (asphalt); Drexel Metals, McElroy Metal (standing seam); Boral, Eagle Roofing (tile). See <code>imagery-manifest.json</code> for license status — gradient placeholders shown until manufacturer assets land.</p>
	</section>

	<!-- Color swatches (ivory-tint section) -->
	<section class="colors">
		<p class="section-eyebrow">Asphalt color options</p>
		<h2 class="section-h">A range that fits the house.</h2>
		<p class="section-sub">Six common color families below. The full line carries 20+ options — your inspection report includes a color sheet.</p>
		<div class="colors-inset">
			<ColorSwatchGrid />
		</div>
	</section>

	<!-- Why local matters (reused) -->
	<section class="local">
		<p class="local-eyebrow">Why local matters</p>
		<h2 class="local-h">We're not a national chain.</h2>
		<p class="local-sub">When the big roofing companies finish a job, they're gone. We don't go anywhere.</p>
		<div class="local-grid">
			<LocalItem heading="We live here." body="Heritage Co. is locally owned and operated. Our crews live in your area, work in your area, send their kids to school in your area." />
			<LocalItem heading="We answer the phone." body="When you call, you get us. Not a 1-800 number routing through three states to a script-reader." />
			<LocalItem heading="We're around if you need us." body="After the install, we're not gone. We're 30 minutes away if something needs attention. Call the owner direct." />
		</div>
	</section>

	<!-- FullBleed cinematic: "One day install" -->
	<FullBleedSection
		gradient="linear-gradient(135deg, #8fa8c0 0%, #c4b89e 50%, #8a6f54 100%)"
		overlayPosition="bottom-right"
		minHeight="380px"
	>
		<p class="fb-eyebrow">Most installs</p>
		<h2 class="fb-h">One day from tear-off to cleanup.</h2>
	</FullBleedSection>

	<!-- Process -->
	<section class="process">
		<p class="section-eyebrow">How we work</p>
		<h2 class="section-h">Four steps. No surprises.</h2>
		<ProcessFlow steps={[
			{ label: 'Inspect', caption: 'Free. We climb the roof, take photos, write it up.' },
			{ label: 'Quote', caption: 'Clear scope, clear pricing. No surprise line items.' },
			{ label: 'Install', caption: 'Most residential roofs install in one day.' },
			{ label: 'Stand by', caption: 'Workmanship + material warranties. Owner-direct line.' },
		]} />
		<div class="process-sla">
			<HeritagePlaceholder fact="Free-inspection turnaround SLA in plain words (e.g. 'same-day or next-day'). Same-crew on warranty visits Y/N. See Founder Input page §6 + §8." />
		</div>
	</section>

	<!-- Named guarantee callout (LayeredCard) -->
	<section class="guarantee-callout">
		<LayeredCard
			eyebrow="The guarantee"
			heading="Every Heritage Co. roof comes with a written guarantee."
			body="Workmanship from us. Manufacturer pass-through on the materials. The full terms — years, transferability, named guarantee phrase — are filled in below as the founders confirm."
			gradient="linear-gradient(180deg, #6b8aa8 0%, #b8a78c 60%, #6b5d4a 100%)"
			ctaHref="/about"
			ctaLabel="See full warranty terms"
		/>
	</section>

	<!-- Warranty detailed -->
	<WarrantyBlock theme="light" />

	<!-- Financing + insurance partners -->
	<section class="financing">
		<p class="section-eyebrow on-dark">Paying for it</p>
		<h2 class="section-h on-dark">Insurance and financing options.</h2>
		<div class="financing-grid">
			<div class="financing-card">
				<p class="financing-label">Insurance jobs</p>
				<p class="financing-body">For storm-damage claims, your deductible is the only out-of-pocket on most jobs. See <a href="/residential/storm-damage-roofing" class="inline-link">storm damage</a> for the full process.</p>
			</div>
			<div class="financing-card">
				<p class="financing-label">Financing partners</p>
				<HeritagePlaceholder fact="Financing partners (GreenSky, Service Finance, Hearth, Aqua Finance, EnerBank, in-house, or none). Typical promo terms. See Founder Input page §4." />
			</div>
			<div class="financing-card">
				<p class="financing-label">Deductible payment plans</p>
				<HeritagePlaceholder fact="Whether Heritage accepts payment plans on the homeowner deductible (Y/N + conditions). See Founder Input page §4 + §8." />
			</div>
		</div>
	</section>

	<!-- Constrained narrative before testimonials -->
	<ConstrainedSection background="ivory" paddingY="md">
		<p class="cs-eyebrow">From the roofs we've done</p>
		<h2 class="cs-h">Three real customers. Names go below.</h2>
		<p class="cs-body">We post named reviews only with permission. Until the founders confirm three to publish, the cards below show what is coming.</p>
	</ConstrainedSection>

	<!-- Testimonials -->
	<section class="testimonials">
		<p class="section-eyebrow">From our customers</p>
		<h2 class="section-h">What homeowners have said.</h2>
		<p class="section-sub">Three named testimonials go below — first + last name, city, project, in their own words. Until we have permission to publish, the placeholders show what's coming.</p>
		<div class="testimonials-grid">
			<ReviewCard placeholderFact="Residential review #1 — first + last name, city, project type (replacement / repair / storm), star rating, 1–2 sentence quote. Permission required. See Founder Input page §5." />
			<ReviewCard placeholderFact="Residential review #2 — first + last name, city, project type, star rating, 1–2 sentence quote. See Founder Input page §5." />
			<ReviewCard placeholderFact="Residential review #3 — first + last name, city, project type, star rating, 1–2 sentence quote. See Founder Input page §5." />
		</div>
	</section>

	<!-- FAQ (Accordion — interactive) -->
	<section class="faq">
		<p class="section-eyebrow">Common questions</p>
		<h2 class="section-h">What homeowners ask us.</h2>
		<Accordion items={faqs} />
	</section>
</BaseLayout>

<style>
	/* Hero */
	.hero { position: relative; min-height: 540px; background: #1a1a1a; }
	.hero-photo {
		position: absolute; inset: 0;
		background: linear-gradient(180deg, #6b8aa8 0%, #8fa8c0 38%, #ece7de 38%, #b8a78c 70%, #6b5d4a 100%);
		opacity: 0.92;
	}
	.hero-overlay {
		position: absolute; inset: 0;
		background: linear-gradient(90deg, rgba(26,26,26,0.78) 0%, rgba(26,26,26,0.35) 60%, rgba(26,26,26,0.1) 100%);
	}
	.hero-content { position: relative; padding: 96px 48px 80px; max-width: 720px; }
	.hero-eyebrow {
		color: #b54620; font-size: 13px; font-weight: 500;
		margin: 0 0 20px; letter-spacing: 1px; text-transform: uppercase;
	}
	.hero-h1 {
		color: #faf8f4; font-size: 56px; font-weight: 600;
		line-height: 1.05; margin: 0 0 24px; letter-spacing: -1.8px;
	}
	.hero-sub {
		color: #d8d2c2; font-size: 17px; line-height: 1.55;
		margin: 0 0 32px; max-width: 560px;
	}
	.hero-cta-row { display: flex; gap: 16px; align-items: center; }
	.cta-primary {
		background: #b54620; color: #faf8f4;
		padding: 14px 28px; font-size: 15px; font-weight: 500;
		border-radius: var(--radius-pill);
		transition: background 150ms ease, box-shadow 150ms ease;
	}
	.cta-primary:hover { background: #9d3a1a; box-shadow: var(--shadow-active); }
	.cta-secondary {
		color: #faf8f4; padding: 12px 26px;
		font-size: 15px; font-weight: 500;
		border: 2px solid #faf8f4;
		border-radius: var(--radius-pill);
		transition: background 150ms ease, color 150ms ease;
	}
	.cta-secondary:hover { background: #faf8f4; color: #1a1a1a; }

	.section-eyebrow {
		color: #b54620; font-size: 13px; font-weight: 500;
		text-align: center; margin: 0 0 16px;
		letter-spacing: 1px; text-transform: uppercase;
	}
	.section-eyebrow.on-dark { color: #b54620; }
	.section-h {
		color: #1a1a1a; font-size: 40px; font-weight: 600;
		text-align: center; margin: 0 0 16px;
		letter-spacing: -1px; line-height: 1.1;
	}
	.section-h.on-dark { color: #faf8f4; }
	.section-sub {
		color: #5a5347; font-size: 16px; text-align: center;
		margin: 0 auto 56px; max-width: 600px;
	}

	/* Services */
	.services { padding: 96px 48px; background: #faf8f4; }
	.service-grid {
		display: grid; grid-template-columns: repeat(3, 1fr);
		gap: 24px; max-width: 1100px; margin: 0 auto;
	}

	/* Materials */
	.materials { padding: 96px 48px; background: #ffffff; border-top: 1px solid #ece7de; }
	.materials-grid {
		display: grid; grid-template-columns: repeat(3, 1fr);
		gap: 24px; max-width: 1200px; margin: 0 auto;
	}

	/* Colors (ivory-tint section, inset card-on-card) */
	.colors { padding: 96px 48px; background: var(--ivory-tint); border-top: 1px solid #ece7de; }
	.colors-inset {
		max-width: 1000px;
		margin: 0 auto;
		padding: 36px;
		background: #ffffff;
		border: 1px solid #ece7de;
	}

	/* Why local */
	.local { padding: 120px 48px; background: #1a1a1a; }
	.local-eyebrow {
		color: #b54620; font-size: 13px; font-weight: 500;
		text-align: center; margin: 0 0 20px;
		letter-spacing: 1px; text-transform: uppercase;
	}
	.local-h {
		color: #faf8f4; font-size: 48px; font-weight: 600;
		text-align: center; line-height: 1.05; margin: 0 auto 24px;
		letter-spacing: -1.5px; max-width: 720px;
	}
	.local-sub {
		color: #d8d2c2; font-size: 17px; text-align: center;
		max-width: 600px; margin: 0 auto 64px; line-height: 1.6;
	}
	.local-grid {
		display: grid; grid-template-columns: repeat(3, 1fr);
		gap: 40px; max-width: 1100px; margin: 0 auto;
	}

	/* Process */
	.process { padding: 96px 48px; background: #faf8f4; }
	.process-sla { max-width: 1100px; margin: 40px auto 0; }
	.guarantee-callout { padding: 96px 48px; background: #ffffff; border-top: 1px solid #ece7de; }

	/* SplitScreen helpers */
	.ss-eyebrow { color: var(--rust); font-size: 13px; font-weight: 500; letter-spacing: 1px; text-transform: uppercase; margin: 0 0 16px; }
	.ss-h { color: var(--charcoal); font-size: 36px; font-weight: 600; letter-spacing: -0.8px; line-height: 1.15; margin: 0 0 16px; }
	.ss-body { color: var(--warm-gray); font-size: 17px; line-height: 1.6; margin: 0 0 24px; }
	.ss-cta { display: inline-flex; padding: 14px 28px; background: var(--rust); color: var(--off-white); font-size: 15px; font-weight: 500; border-radius: var(--radius-pill); transition: background 150ms ease; }
	.ss-cta:hover { background: #9d3a1a; }

	/* FullBleed helpers */
	.fb-eyebrow { color: var(--rust); font-size: 13px; font-weight: 500; letter-spacing: 1px; text-transform: uppercase; margin: 0 0 16px; }
	.fb-h { color: var(--off-white); font-size: 40px; font-weight: 600; letter-spacing: -1px; line-height: 1.15; margin: 0; max-width: 580px; }

	/* Constrained helpers */
	.cs-eyebrow { color: var(--rust); font-size: 13px; font-weight: 500; letter-spacing: 1px; text-transform: uppercase; margin: 0 0 14px; text-align: center; }
	.cs-h { color: var(--charcoal); font-size: 32px; font-weight: 600; letter-spacing: -0.6px; line-height: 1.2; margin: 0 0 16px; text-align: center; }
	.cs-body { color: var(--warm-gray); font-size: 15px; line-height: 1.65; margin: 0 auto; text-align: center; max-width: 600px; }

	/* Materials attribution */
	.materials-attribution {
		max-width: 1100px;
		margin: 24px auto 0;
		font-size: 12px;
		color: var(--warm-gray);
		text-align: center;
	}
	.materials-attribution code { font-size: 11px; }

	/* Financing */
	.financing { background: #1a1a1a; padding: 96px 48px; }
	.financing-grid {
		display: grid; grid-template-columns: repeat(3, 1fr);
		gap: 24px; max-width: 1100px; margin: 56px auto 0;
	}
	.financing-card {
		padding: 28px;
		background: rgba(250,248,244,0.04);
		border: 1px solid rgba(250,248,244,0.12);
	}
	.financing-label { color: #b54620; font-size: 12px; font-weight: 500; margin: 0 0 14px; letter-spacing: 1.5px; text-transform: uppercase; }
	.financing-body { color: #d8d2c2; font-size: 15px; line-height: 1.6; margin: 0; }
	.inline-link { color: #faf8f4; border-bottom: 1px solid #faf8f4; padding-bottom: 1px; }

	/* Testimonials */
	.testimonials { background: #faf8f4; padding: 96px 48px; }
	.testimonials-grid {
		display: grid; grid-template-columns: repeat(3, 1fr);
		gap: 24px; max-width: 1100px; margin: 0 auto;
	}

	/* FAQ */
	.faq { background: #ffffff; padding: 96px 48px; border-top: 1px solid #ece7de; }
	.faq-list { max-width: 800px; margin: 0 auto; }
	.faq-wrap {}
	.faq-placeholder { margin: 0 0 12px; padding: 0 0 16px; border-bottom: 1px solid #ece7de; }
</style>
