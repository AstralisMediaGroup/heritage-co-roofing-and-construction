---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroFlagship from '../../components/v2/HeroFlagship.astro';
import TrustMarquee from '../../components/v2/TrustMarquee.astro';
import SectionHead from '../../components/v2/SectionHead.astro';
import PromiseStrip from '../../components/v2/PromiseStrip.astro';
import TileGrid from '../../components/v2/TileGrid.astro';
import PhotoBleed from '../../components/v2/PhotoBleed.astro';
import PhotoLede from '../../components/v2/PhotoLede.astro';
import ProcessSteps from '../../components/v2/ProcessSteps.astro';
import StatBand from '../../components/v2/StatBand.astro';
import PageCTA from '../../components/v2/PageCTA.astro';
import Reveal from '../../components/v2/Reveal.astro';
import { imagery } from '../../content/imagery';

const v2 = imagery.v2;

const services = [
	{ heading: 'Roof replacement', body: 'Tear-off and full re-roof. Most jobs install in a single day.', href: '/residential/roof-replacement', photo: v2.serviceTiles.replacement, eyebrow: 'Service' },
	{ heading: 'Roof repair', body: 'Targeted repair when replacement is overkill. Diagnostic-first.', href: '/residential/roof-repair', photo: v2.serviceTiles.repair, eyebrow: 'Service' },
	{ heading: 'Storm damage', body: 'Hail and wind damage. We handle the insurance back-and-forth.', href: '/residential/storm-damage-roofing', photo: v2.serviceTiles.storm, eyebrow: 'Service' },
	{ heading: 'Roof inspection', body: 'Free, documented inspection from a real person on the ladder.', href: '/residential/roof-inspection', photo: v2.serviceTiles.inspection, eyebrow: 'Service' },
	{ heading: 'Gutter installation + repair', body: 'Seamless aluminum and steel. Gutter guards available.', href: '/residential/gutter-installation-and-repair', photo: v2.serviceTiles.gutter, eyebrow: 'Service' },
	{ heading: 'Skylight installation + repair', body: 'Velux, Fakro. Curb-mounted and deck-mounted.', href: '/residential/skylight-installation-and-repair', photo: v2.serviceTiles.skylight, eyebrow: 'Service' },
	{ heading: 'Attic ventilation', body: 'Ridge, soffit, and powered. Often the missing factor in early failures.', href: '/residential/attic-ventilation', photo: v2.serviceTiles.attic, eyebrow: 'Service' },
	{ heading: 'Chimney flashing + repair', body: 'Where most leaks actually start. Step + counter flashing rebuilt.', href: '/residential/chimney-flashing-and-repair', photo: v2.serviceTiles.chimney, eyebrow: 'Service' },
];

const materials = [
	{ heading: 'Asphalt shingle', body: 'GAF, Owens Corning, CertainTeed, Atlas, Malarkey. The default for East Texas.', href: '/residential/asphalt-shingle-roofs', photo: v2.materialTiles.asphalt, eyebrow: 'Material' },
	{ heading: 'Metal', body: 'Standing seam and exposed-fastener. 40+ year service life.', href: '/residential/metal-roofs', photo: v2.materialTiles.metal, eyebrow: 'Material' },
	{ heading: 'Tile', body: 'Concrete and synthetic. 50+ year roofs, but structural feasibility first.', href: '/residential/tile-roofs', photo: v2.materialTiles.tile, eyebrow: 'Material' },
];

const process = [
	{ heading: 'Next-day inspection', body: 'Real person on the ladder. Photos, decking, ventilation, flashings — fully documented.' },
	{ heading: 'Same-day quote', body: 'Written quote with system, warranty, and timeline. GoodLeap financing if you need it. No high-pressure upsell.' },
	{ heading: 'Install', body: 'Most residential roofs install in one day. Same crew start to finish.' },
	{ heading: 'Heritage Standard warranty', body: '10-year Heritage workmanship warranty plus manufacturer material warranty. Transferable once on home sale.' },
];
---

<BaseLayout
	title="Residential roofing — Heritage Co. Roofing & Construction"
	description="Residential roofing in East Texas and Central Arkansas. Replacement, repair, storm damage, inspection. Asphalt, metal, and tile."
>
	<HeroFlagship
		eyebrow="Residential roofing"
		heading="Roofs for your home."
		lede="Replacement, repair, and storm damage. Insurance accepted. Free inspections, same-day quotes. Most residential roofs install in a single day."
		photo={v2.pageHeros.residential}
		bullets={['Next-day free inspection', '10-year Heritage workmanship warranty', 'Insurance claim handling · GoodLeap financing']}
		primaryCta={{ label: 'Get my free inspection', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
	/>

	<TrustMarquee items={v2.trustItems} />

	<Reveal>
		<section class="page-section">
			<div class="container">
				<PromiseStrip items={['Heritage Standard · 10-year workmanship', 'Insurance accepted · all carriers', 'GoodLeap financing · 0% up to 12 mo', 'Locally owned + crewed']} />
			</div>
		</section>
	</Reveal>

	<Reveal>
		<section class="page-section">
			<div class="container">
				<SectionHead
					eyebrow="Services"
					heading="What we do on a residential roof."
					lede="Eight services on the residential side. Pick the one you need or call us and we'll figure out which it is."
					maxWidth="780px"
				/>
				<div class="grid-spacer">
					<TileGrid tiles={services} cols={4} style="photo-card" />
				</div>
			</div>
		</section>
	</Reveal>

	<PhotoBleed
		photo={v2.bleeds.workmanship}
		heading="Most residential roofs<br />install in one day."
		caption="Tear off in the morning, dry-in by midday, finished and cleaned up before sundown. Same crew start to finish."
		overlay={true}
		heightVw={64}
	/>

	<Reveal>
		<section class="page-section">
			<div class="container">
				<SectionHead
					eyebrow="Materials"
					heading="Three roof materials.<br />East Texas reality, not a catalog."
					lede="The right material for an East Texas home depends on the structure, the roof slope, the budget, and how long you're staying. We tell you which makes sense before we quote it."
					maxWidth="780px"
				/>
				<div class="grid-spacer">
					<TileGrid tiles={materials} cols={3} style="photo-card" />
				</div>
			</div>
		</section>
	</Reveal>

	<Reveal>
		<section class="page-section">
			<div class="container">
				<PhotoLede
					photo={v2.bleeds.storm}
					eyebrow="Storm damage"
					heading="Hail or wind?<br />We handle the whole roof."
					body="Free inspection, full damage documentation, direct work with your adjuster. We handle the back-and-forth. You pay your deductible. We do the rest."
					bullets={['Insurance claim documentation', 'Adjuster meetings on-site', 'Same crew on the install']}
					cta={{ label: 'Storm damage details →', href: '/residential/storm-damage-roofing' }}
					photoSide="right"
				/>
			</div>
		</section>
	</Reveal>

	<StatBand stats={[
		{ value: '4,000+', label: 'Residential roofs installed', numericValue: 4000, suffix: '+' },
		{ value: '10 yr', label: 'Workmanship warranty · Heritage Standard' },
		{ value: '1 day', label: 'Typical residential install' },
		{ value: 'Next day', label: 'Free inspection turnaround' },
	]} />

	<Reveal>
		<section class="page-section">
			<div class="container">
				<SectionHead
					eyebrow="How we work"
					heading="Free inspection. Real quote. Real warranty."
					lede="Same person from inspection through warranty. No call-center, no script."
					maxWidth="720px"
				/>
				<div class="grid-spacer">
					<ProcessSteps steps={process} />
				</div>
			</div>
		</section>
	</Reveal>

	<PageCTA
		heading="Ready for a free roof inspection?"
		lede="Same-day or next-day quote. Real person on the ladder."
		primaryCta={{ label: 'Schedule online', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
		photo={v2.pageHeros.freeInspection}
	/>
</BaseLayout>

<style>
	.page-section { padding: clamp(72px, 8vw, 128px) 0; }
	.grid-spacer { margin-top: clamp(48px, 5vw, 80px); }
</style>
