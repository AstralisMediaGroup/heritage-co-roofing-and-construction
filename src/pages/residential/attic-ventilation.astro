---
import ServiceDetailLayout from '../../layouts/ServiceDetailLayout.astro';
import { imagery } from '../../content/imagery';

const ventTypes = [
	{ title: 'Ridge vents', body: 'Continuous vent along the peak. Exhaust side of the system. The standard on every modern roof.' },
	{ title: 'Soffit vents', body: 'Intake vents at the eaves. Ridge cannot exhaust without soffit pulling. Balanced intake matters more than people realize.' },
	{ title: 'Gable vents', body: 'End-wall louvers. Older roofs use these in place of ridge vents. Less efficient but functional.' },
	{ title: 'Powered attic fans (electric)', body: 'Thermostatic exhaust fan in the attic. Pulls air actively. Worth it on roofs without enough passive flow.' },
	{ title: 'Solar-powered attic fans', body: 'Same idea as electric, but powered by a roof-mounted solar panel. No wiring, no power bill. Slightly less powerful but enough on most homes.' },
	{ title: 'Continuous soffit + ridge', body: 'The current best-practice spec — continuous soffit intake + continuous ridge exhaust = balanced passive flow with no fans.' },
];

const faqs = [
	{ q: 'Do I need ridge AND soffit vents?', a: 'Yes — they work as a system. Ridge vents alone cannot exhaust. They need intake at the soffit to pull air through. Most roofs we replace need soffit intake added; ridge is already there.' },
	{ q: 'Are powered attic fans worth it?', a: 'On a roof with adequate passive flow, no. On a roof that runs hot with poor soffit intake, yes — until you can fix the underlying intake. We try to fix the system before adding a fan.' },
	{ q: 'Can ventilation be added without a new roof?', a: 'Yes. Soffit intake can be added from below (cut louvers or replace blocked panels). Ridge vent installation requires removing a strip of cap shingles — minor roof work, not a replacement.' },
	{ q: 'How does ventilation affect roof warranty?', a: 'Most asphalt shingle warranties require code-compliant ventilation. A roof with poor ventilation that fails early may have its warranty denied. We install to manufacturer-approved spec on every replacement.' },
	{ q: 'What\'s the right balance?', a: 'Code is 1 sq ft of vent area per 300 sq ft of attic floor, split 50/50 intake and exhaust. Best practice is 1 per 150 in humid climates like East Texas. We measure your attic and spec accordingly.' },
	{ q: 'Can solar fans replace electric?', a: 'On most homes, yes. Modern solar fans move 800–1500 CFM and run only when the sun is hitting the roof — which is exactly when you need them. No power bill, no wiring.' },
];
---

<ServiceDetailLayout
	title="Attic Ventilation — Heritage Co."
	heroEyebrow="Residential · Attic ventilation"
	heroH1="A roof that breathes lasts longer."
	heroSub="Hot attics shorten roof life, raise energy bills, and grow mold. Ventilation is cheap insurance — usually addable without a new roof."
	heroPhoto={imagery.heroCandidates.residentialRoofA.url}
	heroPhotoAlt="Residential roof"
	whatWeMeanHeading="Ventilation is a system, not a single vent."
	whatWeMeanParagraphs={[
		'Attic ventilation is two things working together: intake at the soffit and exhaust at the ridge (or gables). Air has to flow in low and out high. When one side is missing or blocked, the system stalls — the attic overheats, the shingles cook, and energy bills climb in the summer.',
		'Most ventilation problems we find are not the exhaust side. Ridge vents are usually present and working. The problem is the intake side: blocked soffit panels, paint-clogged louvers, or no soffit vents at all on older homes. Fixing intake is usually a half-day job and dramatically changes how the roof performs.',
	]}
	whenYouNeedHeading="The signs your attic is not breathing."
	whenYouNeedItems={[
		{ title: 'Cooling bills high in summer', body: 'A 140°F attic radiates heat down through the ceiling all night. Adequate ventilation keeps the attic within 15–20°F of outside air.' },
		{ title: 'Ice dams in winter', body: 'A warm attic melts snow on the upper roof; the runoff refreezes at the cold eave. Ice dams. Ventilation keeps the deck cold and the snow uniform.' },
		{ title: 'Mold smell or visible mold', body: 'Trapped moisture from showers, cooking, and breath has nowhere to go. Mold grows on rafters and decking.' },
		{ title: 'Premature shingle wear', body: 'Curling, blistering, or granule loss before year 15. Heat from below shortens the shingle life faster than UV from above.' },
		{ title: 'No ridge vent visible from the ground', body: 'On 2000s+ homes, ridge vent should be visible as a small bump at the peak. Older homes may have gable vents instead — check from the ground.' },
		{ title: 'Frost on rafters in winter', body: 'Visible frost or moisture on the underside of decking in cold weather. Warm interior moist air condensing on cold wood. Pure ventilation problem.' },
	]}
	processHeading="Four steps. Most jobs done in a day."
	processSteps={[
		{ label: 'Inspect', caption: 'Attic + roof. Measure intake + exhaust against code.' },
		{ label: 'Quote', caption: 'Soffit / ridge / fan combo. Per-vent pricing.' },
		{ label: 'Install', caption: 'Soffit cuts + ridge vent + any fan in one day.' },
		{ label: 'Stand by', caption: 'Workmanship guarantee on the install.' },
	]}
	materialsHeading="Six ventilation systems."
	materialsSub="From passive ridge + soffit (the default) to solar-powered active exhaust."
	costHeading="Per-system pricing."
	costPriceBandFact="Typical attic ventilation work — soffit vent retrofit (low end) vs ridge + soffit + fan combo (high end). Plus a separate band for solar-fan installs. See Founder Input page §4."
	costFactors={[
		'Attic square footage (drives required vent area)',
		'Existing intake condition (open soffit vs blocked)',
		'Ridge vent install (requires roof opening)',
		'Powered fan add-on (electric vs solar)',
		'Wiring run for electric fans',
		'Roof access difficulty',
	]}
	warrantyHeading="Workmanship warranty on every install."
	faqItems={faqs}
	endCtaPhoto={imagery.heroCandidates.residentialRoofB.url}
	endCtaHeading="Free attic inspection."
	endCtaSub="We measure intake + exhaust and tell you what's missing."
	endCtaLabel="Get my free inspection"
	endCtaHref="/free-inspection"
>
	<div slot="materials">
		<div class="vt-grid">
			{ventTypes.map((v) => (
				<div class="vt-item">
					<p class="vt-title">{v.title}</p>
					<p class="vt-body">{v.body}</p>
				</div>
			))}
		</div>
	</div>
</ServiceDetailLayout>

<style>
	.vt-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-top: 1px solid var(--border); }
	.vt-item { padding: 24px 28px 0 0; }
	.vt-item + .vt-item { padding-left: 28px; border-left: 1px solid var(--border); }
	.vt-item:nth-child(n+4) { padding-top: 24px; border-top: 1px solid var(--border); margin-top: 24px; }
	.vt-title { color: var(--charcoal); font-size: 16px; font-weight: 600; margin: 0 0 8px; }
	.vt-body { color: var(--warm-gray); font-size: 14px; line-height: 1.55; margin: 0; }
</style>
