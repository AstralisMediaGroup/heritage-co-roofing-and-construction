---
import SystemPage from '../../components/v2/SystemPage.astro';
import { imagery } from '../../content/imagery';

const v2 = imagery.v2;
---

<SystemPage
	title="Gutter installation and repair"
	heroEyebrow="Residential · service"
	heroHeading="Seamless gutters.<br />The roof's drainage system."
	heroLede="Seamless aluminum and steel gutters. Gutter guards. Repair, re-pitch, and full installation. The system that determines whether your fascia rots or holds for 30 years."
	heroPhoto={v2.pageHeros.gutter}
	heroCta={{ label: 'Get my free inspection', href: '/free-inspection' }}
	bleedPhoto={v2.bleeds.workmanship}
	bleedHeading="Seamless. Site-formed.<br />No factory-cut joints."
	overview={{
		eyebrow: 'Why gutters matter',
		heading: 'Where the water goes after the roof.',
		body: "Gutters are the infrastructure between your roof and your foundation. Properly-pitched, properly-sized, and free-flowing gutters move every gallon off the roof to a place that doesn't damage the house. Failed gutters back water onto the fascia, behind the siding, or pool at the foundation. Most fascia rot we see in East Texas traces to a gutter problem, not a roof problem."
	}}
	keyPoints={[
		{
			heading: 'Seamless installation.',
			body: "Aluminum (most common) or steel. Site-formed in continuous lengths up to 80+ feet on a portable gutter machine — no factory-cut joints to fail. Pitched 1/4 inch per 10 feet toward downspouts. Hidden hangers (not spike-and-ferrule) for long-term holding power.",
			bullets: ['Aluminum or steel · site-formed', 'No factory joints in long runs', 'Pitched 1/4" per 10 ft to downspouts', 'Hidden hangers, not nails'],
			photo: v2.serviceTiles.gutter,
			photoSide: 'left',
		},
		{
			heading: 'Gutter guards — when they\'re worth it.',
			body: "Gutter guards (mesh, micro-mesh, foam, or solid-cover) reduce cleaning frequency in pine-heavy or oak-heavy yards. Worth it if you have lots of trees overhead. Skippable if you don't. We don't push them on every job — we tell you whether your tree cover justifies the upgrade.",
			bullets: ['Worth it: pine + oak coverage overhead', 'Skip: clear roofline, no trees overhead', 'Micro-mesh > foam > brush > solid-cover'],
			photo: v2.bleeds.workmanship,
			photoSide: 'right',
		},
	]}
	faq={[
		{ q: "How big do my gutters need to be?", a: '<p>5-inch K-style is standard for most residential roofs. 6-inch K-style is recommended for steeper roofs, larger surface areas, and any house with significant rooflines feeding a single downspout. We size based on roof area and rainfall intensity for East Texas.</p>' },
		{ q: "What about gutter guards?", a: '<p>Worth it if you have significant tree cover overhead. Micro-mesh systems are the most effective. We don\'t recommend solid-cover (one-piece) systems on most roofs — they tend to lose water in high-flow events.</p>' },
		{ q: "How often should I clean my gutters?", a: '<p>Twice a year if you have trees overhead — late spring after pollen drop and late fall after leaf drop. Once a year on clear-roof homes. With micro-mesh guards: rinse only, every 1–2 years.</p>' },
		{ q: "Why is my fascia rotting?", a: '<p>Most likely a gutter problem. Either the gutters are pitched wrong (water sitting at the back lip), the back of the gutter has detached and is feeding water down the fascia, or the gutters are oversized for the hangers and pulling away. We diagnose on the inspection.</p>' },
	]}
	ctaHeading="Gutter inspection.<br />Free with any roof inspection."
	ctaLede="We look at the gutters when we look at the roof. No extra charge."
	ctaPhoto={v2.pageHeros.freeInspection}
	ctaPrimary={{ label: 'Get my free inspection', href: '/free-inspection' }}
/>
