---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroPage from '../../components/v2/HeroPage.astro';
import TrustMarquee from '../../components/v2/TrustMarquee.astro';
import SectionHead from '../../components/v2/SectionHead.astro';
import PromiseStrip from '../../components/v2/PromiseStrip.astro';
import ShingleExplorer from '../../components/v2/ShingleExplorer.astro';
import FeaturedShinglesGrid from '../../components/v2/FeaturedShinglesGrid.astro';
import PhotoBleed from '../../components/v2/PhotoBleed.astro';
import StatBand from '../../components/v2/StatBand.astro';
import FAQAccordion from '../../components/v2/FAQAccordion.astro';
import PageCTA from '../../components/v2/PageCTA.astro';
import Reveal from '../../components/v2/Reveal.astro';
import { imagery } from '../../content/imagery';

const v2 = imagery.v2;

const faq = [
	{ q: 'Architectural or designer?', a: '<p>Architectural is the default install on every Heritage residential job — 110–130 mph wind, 20–25 year service life, and a price band that works for nearly every East Texas budget. Designer (Class 4 impact) makes sense if you have hail history in the last 10 years or you plan to keep the house long enough that the lifetime warranty pays back the upgrade.</p>' },
	{ q: 'Class 4 impact — worth it?', a: '<p>If you\'ve had hail damage in the last 10 years, yes. Insurance discounts on Class 4 in hail-prone zips often pay back the upgrade cost over the life of the roof. We tell you both numbers on the proposal.</p>' },
	{ q: 'Which manufacturer is best?', a: '<p>The honest answer: there\'s no single best. GAF, Owens Corning, CertainTeed, Atlas, and Malarkey all make solid architectural shingles in the same performance band. Decision usually comes down to color match and the warranty Heritage carries with that manufacturer.</p>' },
	{ q: 'Tear-off or overlay?', a: '<p>Tear-off, almost always. Overlay locks in any decking problems, voids most warranty coverage, and traps an old layer of failure underneath. We only overlay on jobs where the homeowner accepts the warranty trade-offs in writing.</p>' },
];
---

<BaseLayout
	title="Asphalt shingle roofs — Heritage Co. Roofing & Construction"
	description="Architectural and designer asphalt shingles. Real color palettes, real specs, real installer answers. Click through the options."
>
	<HeroPage
		eyebrow="Residential · materials"
		heading="Asphalt shingles.<br />Architectural and designer."
		lede="Two tiers, both with real colors. Architectural is the default install on most East Texas homes. Designer adds Class 4 impact and a lifetime warranty for hail-prone zips and long-stay homeowners."
		primaryCta={{ label: 'Get my free inspection', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
		photo={v2.pageHeros.asphaltShingle}
		tier={2}
	/>

	<TrustMarquee items={v2.trustItems} />

	<Reveal>
		<section class="page-section">
			<div class="container">
				<PromiseStrip items={['Insurance accepted', 'Free inspections', 'Workmanship + material warranties', '1-day install · most homes']} />
			</div>
		</section>
	</Reveal>

	<Reveal>
		<section class="page-section">
			<div class="container">
				<SectionHead
					eyebrow="Pick a tier"
					heading="Two shingle types.<br />Click either to explore."
					lede="Same install crew. Different shingle. The math depends on how long you're staying and whether the zip code sees hail."
					maxWidth="780px"
				/>
				<div class="explorer-spacer">
					<ShingleExplorer />
				</div>
			</div>
		</section>
	</Reveal>

	<Reveal>
		<section class="page-section">
			<div class="container">
				<SectionHead
					eyebrow="Brands we install"
					heading="Three flagship lines.<br />The shingles on most Heritage roofs."
					lede="GAF Timberline HDZ, CertainTeed Landmark, and IKO Cambridge cover the architectural tier we install most often. Color names link to the manufacturer for full palette and warranty terms."
					maxWidth="800px"
				/>
				<div class="featured-spacer">
					<FeaturedShinglesGrid />
				</div>
			</div>
		</section>
	</Reveal>

	<PhotoBleed
		photo={v2.bleeds.workmanship}
		heading="Most residential roofs<br />install in one day."
		caption="Tear off in the morning. Decking inspected and repaired by midday. Dry-in by early afternoon. Cleaned up before sundown."
		overlay={true}
		heightVw={62}
	/>

	<StatBand stats={[
		{ value: '20–25', label: 'Years real-world life · architectural' },
		{ value: '130', label: 'Mph wind rating · architectural' },
		{ value: 'Class 4', label: 'Impact rating · designer tier' },
		{ value: '1 day', label: 'Typical install timeline' },
	]} />

	<Reveal>
		<section class="page-section">
			<div class="container faq-grid">
				<SectionHead eyebrow="Common questions" heading="What homeowners ask us about shingles." />
				<FAQAccordion items={faq} />
			</div>
		</section>
	</Reveal>

	<PageCTA
		heading="Free inspection.<br />Real quote in a day."
		lede="Same-day or next-day quote. Real person on the ladder, not a salesperson."
		primaryCta={{ label: 'Get my free inspection', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
		photo={v2.pageHeros.freeInspection}
	/>
</BaseLayout>

<style>
	.page-section { padding: clamp(72px, 8vw, 128px) 0; }
	.explorer-spacer { margin-top: clamp(48px, 5vw, 72px); }
	.featured-spacer { margin-top: clamp(48px, 5vw, 72px); }
	.faq-grid {
		display: grid;
		grid-template-columns: 0.8fr 1fr;
		gap: clamp(40px, 5vw, 96px);
		align-items: start;
	}
	@media (max-width: 880px) {
		.faq-grid { grid-template-columns: 1fr; gap: 32px; }
	}
</style>
