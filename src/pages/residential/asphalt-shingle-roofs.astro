---
import MaterialDetailLayout from '../../layouts/MaterialDetailLayout.astro';
import { imagery } from '../../content/imagery';

const benefits = [
	{ icon: 'shield' as const, title: 'Class 3 + Class 4 impact ratings', body: 'Class 4 impact-rated shingles take a 2-inch ice ball without splitting. Most Texas insurance carriers offer premium discounts for a Class 4 install — meaningful savings on top of better hail performance.' },
	{ icon: 'wind' as const, title: 'Wind warranties up to 130 mph', body: 'Architectural shingles hand-nailed to the manufacturer spec carry 130 mph wind warranties as standard. Premium SBS-modified lines (StormMaster, Malarkey Legacy) push to 150 mph.' },
	{ icon: 'flame' as const, title: 'Class A fire rating', body: 'Asphalt shingles with the right underlayment assembly are Class A — the highest UL fire rating. Standard on every modern install.' },
	{ icon: 'water' as const, title: 'Algae-resistant granule blends', body: '3M and similar copper-based granules embedded in the cap surface inhibit black-streak algae. Most premium lines now ship algae-resistant by default.' },
	{ icon: 'layers' as const, title: 'Fiberglass laminate construction', body: 'Modern architectural shingles laminate two layers of fiberglass mat with asphalt and ceramic granules. The laminated profile is what gives architecturals their dimensional shadow line.' },
	{ icon: 'gauge' as const, title: 'Energy-rated cool-roof options', body: 'Cool-roof shingles with reflective granules (Atlas Pinnacle Sun, GAF Timberline Cool Series, OC ProArmor) reflect solar heat — measurable summer cooling savings on south-facing roofs.' },
];

const colorSwatches = [
	{ name: 'Charcoal' },
	{ name: 'Weathered Wood' },
	{ name: 'Driftwood' },
	{ name: 'Hickory' },
	{ name: 'Slate' },
	{ name: 'Hunter Green' },
	{ name: 'Pewter Gray' },
	{ name: 'Shakewood' },
];

const specRows = [
	{ label: 'Service life', value: '20–30 years (architectural / dimensional in East Texas climate)' },
	{ label: 'Wind warranty', value: 'Up to 130 mph standard; 150 mph on SBS-modified premium lines' },
	{ label: 'Impact rating', value: 'Class 3 standard; Class 4 (2" ice ball) on impact-resistant lines' },
	{ label: 'Fire rating', value: 'Class A (highest UL rating, with proper assembly)' },
	{ label: 'Algae resistance', value: 'Standard on most premium lines (10–25 year algae warranty)' },
	{ label: 'Construction', value: 'Fiberglass laminate, ceramic-coated granules, polymer-modified asphalt on premium lines' },
	{ label: 'Cool-roof options', value: 'Class 1 cool-roof rated lines available (reflective granules)' },
	{ label: 'Manufacturer warranty', value: 'Lifetime limited (most premium lines); transferable on home sale (typically 1–2 transfers)' },
];

const tradeoffs = [
	{ kind: 'pro' as const, body: 'Lowest up-front cost of any major roofing material' },
	{ kind: 'pro' as const, body: 'Widest color and style range in residential' },
	{ kind: 'pro' as const, body: 'Easiest to repair shingle-by-shingle' },
	{ kind: 'pro' as const, body: 'Standard for insurance-claim work in East Texas' },
	{ kind: 'pro' as const, body: 'Class 4 lines available on every major manufacturer' },
	{ kind: 'con' as const, body: 'Shorter lifespan than metal (20–30 vs 40–60 years)' },
	{ kind: 'con' as const, body: 'Hail-vulnerable on lower Class-3 lines — Class 4 is the upgrade' },
	{ kind: 'con' as const, body: 'East Texas heat shortens shingle life vs cooler regions' },
	{ kind: 'con' as const, body: 'Granule loss is normal but progressive after year 15' },
];

const faqs = [
	{ q: 'How long does an asphalt roof actually last in East Texas?', a: 'Architectural shingles with proper ventilation run 25–30 years here. Texas heat shortens shingle life vs cooler regions — a 30-year shingle in Minnesota often performs like a 25-year shingle in Smith County. The manufacturer warranty length and the real-world lifespan are not the same number.' },
	{ q: 'Should I pay extra for Class 4 impact-resistant shingles?', a: 'Almost always, in East Texas. Spring hail is annual. The Class 4 upgrade typically costs 10–20% more on the shingle, but most Texas insurance carriers offer 20–30% premium discounts on a Class 4 install. The math pencils out by year three on most homes.' },
	{ q: 'What\'s the difference between 3-tab and architectural?', a: '3-tab: a single flat layer of shingle, the budget option, 20–25 year service life, lower wind ratings. Architectural (also called dimensional or laminated): two laminated layers, dimensional shadow line, 25–30 year service life, 130 mph wind standard. Architectural is the modern default.' },
	{ q: 'Do you install Malarkey, Atlas, GAF, Owens Corning, CertainTeed?', a: 'See below — Heritage\'s primary stocked lines vary by what we are running through the warehouse. The major manufacturers are all comparable on quality at equivalent product tiers; the differences are color range and warranty terms.', placeholderFact: 'Heritage\'s primary stocked asphalt manufacturers + product tiers (e.g. GAF Timberline HDZ, Owens Corning Duration, Atlas Pinnacle Impact, Malarkey Legacy, CertainTeed Landmark Pro). See Founder Input page §2.' },
	{ q: 'Are algae streaks covered under warranty?', a: 'Most premium lines now include 10–25 year algae warranties — black-streak coverage included. Older or budget shingle lines do not include algae coverage; a non-algae-resistant install in humid East Texas can show streaking by year 7–8.' },
	{ q: 'Can I get a cool-roof asphalt shingle?', a: 'Yes. Cool-roof shingles use reflective granules to bounce solar heat back. Atlas Pinnacle Sun, GAF Timberline Cool Series, and Owens Corning ProArmor all carry Class 1 cool-roof ratings. Limited color range (mostly lighter grays and tans) — the dark colors do not hit cool-roof reflectance numbers.' },
	{ q: 'What\'s the warranty on a Heritage asphalt install?', a: 'Two warranties on every roof: Heritage workmanship + manufacturer pass-through on the materials.', placeholderFact: 'Heritage workmanship warranty length on residential asphalt installs. Manufacturer pass-through length + transferability terms. See Founder Input page §1.' },
];
---

<MaterialDetailLayout
	title="Asphalt Shingle Roofs — Heritage Co. Residential"
	heroEyebrow="Residential · Asphalt shingles"
	heroH1="Asphalt shingles. The standard for East Texas residential."
	heroSub="Lower up-front cost than metal or tile. Wide color range. Class 4 hail-rated and 130 mph wind options on every major manufacturer."
	heroPhoto={imagery.heroCandidates.residentialRoofA.url!}
	heroPhotoAlt="Residential asphalt shingle roof"
	whatItIsHeading="A laminated fiberglass mat coated in asphalt and granules."
	whatItIsParagraphs={[
		'Asphalt shingles are the most-installed residential roof material in the United States — about 75% of homes. The shingle itself is a fiberglass mat saturated with asphalt, surfaced with ceramic-coated granules that handle UV and weather. Premium lines add polymer modifiers (SBS rubber) for flexibility and impact resistance.',
		'In East Texas, asphalt is the default for almost every residential install. Insurance work runs on it. The local supply chain is built around it. Heritage stocks several manufacturers and chooses by job — color match for repairs, premium lines for new installs, Class 4 upgrades on storm-damage replacements.',
	]}
	benefitsHeading="Six things that distinguish a good asphalt roof from a bad one."
	benefitsSub="Industry-generic specs — these apply to any quality install from any major manufacturer."
	benefits={benefits}
	colorsHeading="Color families across the major manufacturers."
	colorsSub="The exact color names vary by manufacturer (GAF “Pewter Gray” ≈ Owens Corning “Driftwood” ≈ CertainTeed “Moire Black”), but the eight color families below cover what is available. Specific manufacturer SKUs surface at the inspection."
	colorSwatches={colorSwatches}
	colorsPlaceholder="Confirm: Heritage's primary asphalt manufacturer + the actual stocked color line for that brand. See Founder Input page §2. Manufacturer color photography (real product close-ups, not stand-in gradients) requires dealer-portal access from GAF / Owens Corning / CertainTeed / Atlas / Malarkey."
	specsHeading="Asphalt shingle specs at a glance."
	specRows={specRows}
	manufacturerPlaceholder="Heritage's preferred asphalt manufacturer + product tier (e.g. GAF Timberline HDZ for value tier, GAF Timberline UHDZ or Atlas Pinnacle Impact for Class 4 upgrade, Malarkey Legacy for premium SBS-modified). See Founder Input page §2."
	costPriceBandFact="Typical residential asphalt install price band — basic 3-tab on the low end, premium architectural with Class 4 upgrade on the high end, dollars per square (100 sq ft). See Founder Input page §4."
	costFactors={[
		'3-tab vs architectural vs premium SBS-modified',
		'Class 3 vs Class 4 impact rating',
		'Standard vs cool-roof reflective granules',
		'Square footage and roof pitch (steeper = slower install)',
		'Tear-off layers (one layer vs two)',
		'Decking condition once tear-off is done (rot replacement)',
		'Edge metal, flashing, and ridge upgrades',
	]}
	tradeoffsHeading="Where asphalt shines, where it doesn't."
	tradeoffs={tradeoffs}
	faqItems={faqs}
	endCtaPhoto={imagery.heroCandidates.residentialRoofC.url!}
	endCtaHeading="Free inspection. We talk through the right asphalt line for your house."
	endCtaSub="Class 3 vs Class 4, color match, warranty terms — at the inspection, not in a sales pitch."
/>
