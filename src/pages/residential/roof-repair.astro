---
import ServiceDetailLayout from '../../layouts/ServiceDetailLayout.astro';
import HeritagePlaceholder from '../../components/HeritagePlaceholder.astro';
import { imagery } from '../../content/imagery';

const faqs = [
	{ q: 'Will the repair be visible from the ground?', a: 'On a roof under 5 years old, no. The shingle is still close enough to the warehouse stock that we match. On a 10+ year roof, the existing shingles have weathered and the patch will be slightly fresher — visible from the ground if you know where to look. We tell you which side of the line your roof is on.' },
	{ q: 'How long will the repair last?', a: 'A correctly executed repair lasts as long as the rest of the roof. We patch with the same material, re-flash if the leak was at a flashing, and seal under the existing course. The repair does not "expire" before the roof.' },
	{ q: 'Is repair always cheaper than replacement?', a: 'Almost always — until the roof has had 3+ repairs. At that point, you have spent half a replacement on patches and the next leak is likely to cost the other half. We tell you when the math has crossed.' },
	{ q: 'Can you patch a roof that\'s 20 years old?', a: 'Yes — but the patch will be visible, the surrounding shingles may break when we work them, and we cannot guarantee the rest of the roof will not leak somewhere else within the year. On a roof past 18, we usually recommend replacement.' },
	{ q: 'Will my warranty be voided?', a: 'Manufacturer warranties cover the shingles, not workmanship. A repair by us replaces our workmanship guarantee on the patched area. The original manufacturer warranty on undamaged shingles continues.' },
	{ q: 'What if you find more damage during the repair?', a: 'We stop, take photos, and call before we keep going. You decide whether to expand scope or stop with the original repair. We do not surprise you with a larger bill.' },
];
---

<ServiceDetailLayout
	title="Roof Repair — Heritage Co."
	heroEyebrow="Residential · Roof repair"
	heroH1="One leak. One fix. No upsell."
	heroSub="Spot leaks, missing shingles, flashing failures. We repair what's broken. We don't pad it into a replacement."
	heroPhoto={imagery.asphalt.closeup.url}
	heroPhotoAlt="Close-up of asphalt shingles"
	whatWeMeanHeading="Targeted fixes, not full replacements."
	whatWeMeanParagraphs={[
		'A roof repair is a localized fix — a spot leak, a few damaged shingles, a flashing failure at a chimney or vent. The rest of the roof is in good shape. We patch the section, not the whole roof.',
		'The honest version: most repairs we do are 1–3 hour jobs. We charge fairly for the time and materials, not by the gravity of the situation. If the repair is going to cost more than half a replacement, we say so.',
	]}
	whenYouNeedHeading="When repair is the right call."
	whenYouNeedItems={[
		{ title: 'Spot leak in one area', body: 'Stain on the ceiling under one specific roof section. Flashing or one shingle is usually the cause.' },
		{ title: 'Missing shingles after wind', body: 'A handful blew off in a storm. The rest of the roof is intact. Match-and-replace is straightforward.' },
		{ title: 'Isolated impact damage', body: 'A branch hit the roof, or hail bruised one section. The undamaged majority of the roof is still good.' },
		{ title: 'Roof under 15 years old', body: 'A young roof with one problem deserves a repair, not a replacement. The remaining service life is real value.' },
	]}
	processHeading="Four steps. We tell you what we found before we leave."
	processSteps={[
		{ label: 'Inspect', caption: 'Free. We find the actual cause, not just the symptom.' },
		{ label: 'Quote', caption: 'Time + materials, not a fixed-fee inflation.' },
		{ label: 'Repair', caption: 'Same crew, same day on most repairs.' },
		{ label: 'Stand by', caption: 'Workmanship guarantee on the patched area.' },
	]}
	materialsHeading="Match-existing strategy."
	materialsSub="On every repair we identify your shingle (manufacturer + line + color), source matching stock, and blend the patch into the existing course."
	costHeading="Time and materials. No flat-fee inflation."
	costPriceBandFact="Typical repair price band — minimum service-call fee + hourly + materials. Note: free if you proceed with replacement instead. See Founder Input page §4."
	costFactors={[
		'Single shingle replacement vs. multi-shingle section',
		'Flashing repair (chimney, valley, vent boot)',
		'Decking damage discovered (rare on repairs)',
		'Roof pitch and access difficulty',
		'Shingle availability — discontinued lines may need a closest-match',
	]}
	warrantyHeading="Workmanship warranty on every repair."
	warrantyRows={[
		{ label: 'Workmanship on the patch', fact: 'Workmanship guarantee length on residential repair work (years). See Founder Input page §1.' },
		{ label: 'Original manufacturer warranty', fact: 'Confirm: the existing manufacturer warranty on undamaged shingles continues unaffected after a Heritage repair. See Founder Input page §1.' },
	]}
	faqItems={faqs}
	endCtaPhoto={imagery.heroCandidates.residentialRoofB.url}
	endCtaHeading="Free inspection. We tell you if it's a repair or a replacement."
	endCtaSub="Same-day or next-day. No obligation. Honest math, not a sales pitch."
	endCtaLabel="Get my free inspection"
	endCtaHref="/free-inspection"
>
	<div slot="materials">
		<HeritagePlaceholder fact="Heritage's typical match-existing approach: do they stock the most-common East Texas shingles, or order on demand? Confirm typical lead time when shingle is in stock vs. when it has to be sourced. See Founder Input page §2." />
	</div>
</ServiceDetailLayout>
