---
import SystemPage from '../../components/v2/SystemPage.astro';
import { imagery } from '../../content/imagery';

const v2 = imagery.v2;
---

<SystemPage
	title="Roof repair"
	heroEyebrow="Residential · service"
	heroHeading="Roof repair.<br />When replacement is overkill."
	heroLede="Targeted leak repair, missing-shingle replacement, flashing rebuilds, and ridge work. We tell you when repair makes sense and when it doesn't."
	heroPhoto={v2.pageHeros.roofRepair}
	heroCta={{ label: 'Schedule a repair', href: '/free-inspection' }}
	bleedPhoto={v2.bleeds.workmanship}
	bleedHeading="Diagnostic first.<br />Repair only if the math works."
	overview={{
		eyebrow: 'When to repair',
		heading: 'Repair vs replacement is a math problem.',
		body: "A repair makes sense if the rest of the roof has 5+ good years and the failure is localized. A repair is the wrong call if the roof is past 18 years, the failure is structural, or the repair cost is approaching 50% of replacement. We diagnose first, present both numbers, and let you decide."
	}}
	keyPoints={[
		{
			heading: 'What we repair.',
			body: "Missing or torn shingles, lifted shingles after wind events, failed pipe boots, rebuilt step and counter flashing at chimneys and walls, ridge cap replacement, valley repair. Skylight curb leaks (most often a flashing problem, not a skylight problem). Most repairs install in 1–4 hours.",
			bullets: ['Missing or torn shingles', 'Failed pipe boots and vent flashings', 'Chimney + wall flashing rebuilds', 'Ridge cap + valley repair'],
			photo: v2.serviceTiles.repair,
			photoSide: 'left',
		},
		{
			heading: 'Where most leaks actually start.',
			body: "Roof leaks rarely come from the field of the roof. They come from penetrations — pipe boots, vents, skylights, chimneys, walls — where flashing has cracked, lifted, or failed. We diagnose to the source, fix the actual problem, and document it.",
			bullets: ['Pipe boots and vent flashings', 'Chimney step + counter flashing', 'Wall and skylight flashings', 'Ridge cap and ventilation cap'],
			photo: v2.bleeds.workmanship,
			photoSide: 'right',
		},
	]}
	projectPhotos={[v2.projects[0], v2.projects[6], v2.projects[7], v2.projects[1]]}
	projectCaptions={['Pipe boot replacement', 'Chimney flashing rebuild', 'Wind damage repair', 'Localized shingle replacement']}
	faq={[
		{ q: "Can you patch a roof that's 20 years old?", a: '<p>Yes — but the patch will be visible, the surrounding shingles may break when we work them, and we cannot guarantee the rest of the roof will not leak somewhere else within the year. On a roof past 18, we usually recommend replacement instead and tell you why.</p>' },
		{ q: 'Will repair affect my warranty?', a: '<p>If your roof is under manufacturer warranty, we do the repair to manufacturer spec and document it so the warranty stays in force. If the warranty has lapsed, our workmanship warranty covers the repair work itself.</p>' },
		{ q: 'How fast can you come out?', a: '<p>Active leaks: same-day or next-day during business hours. Non-emergency repairs: typically within the week. Emergency tarp service is available — we tarp first, repair second, while the weather window allows.</p>' },
		{ q: 'How much does a typical repair cost?', a: '<p>Wide range — from a basic pipe boot replacement to a full chimney flashing rebuild. We give you a number on the inspection. No hidden charges.</p>' },
	]}
	ctaHeading="Roof leaking?<br />We come out the same day."
	ctaLede="Diagnostic first. Repair if it makes sense, replacement only if it does."
	ctaPhoto={v2.pageHeros.freeInspection}
	ctaPrimary={{ label: 'Schedule a repair', href: '/free-inspection' }}
	promises={['Same-day emergency response', 'Workmanship warranty', 'Diagnostic-first approach']}
/>
