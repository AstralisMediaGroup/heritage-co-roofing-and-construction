---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPage from '../components/v2/HeroPage.astro';
import ReviewBlock from '../components/v2/ReviewBlock.astro';
import SectionHead from '../components/v2/SectionHead.astro';
import StatBand from '../components/v2/StatBand.astro';
import PageCTA from '../components/v2/PageCTA.astro';
import Reveal from '../components/v2/Reveal.astro';
import { imagery } from '../content/imagery';

const v2 = imagery.v2;

const reviews = [
	{ quote: 'They answered the phone the first time, showed up the next morning, and the roof was on inside a week.', name: 'Reviewer placeholder', city: 'Tyler, TX', project: 'Asphalt re-roof', rating: 5 },
	{ quote: 'Same crew start to finish. They worked with my adjuster — I barely had to do anything.', name: 'Reviewer placeholder', city: 'Longview, TX', project: 'Storm damage', rating: 5 },
	{ quote: 'Actual people. Local truck. Came back twice in the next month to check on it.', name: 'Reviewer placeholder', city: 'Marshall, TX', project: 'Metal install', rating: 5 },
	{ quote: 'Diagnosed it as a flashing problem, fixed it for a fraction of what another company quoted.', name: 'Reviewer placeholder', city: 'Kilgore, TX', project: 'Repair', rating: 5 },
	{ quote: 'Honest about what we needed and didn\'t need. No upsell.', name: 'Reviewer placeholder', city: 'Henderson, TX', project: 'Inspection', rating: 5 },
	{ quote: 'Inspection was free, written report, no pressure. Hired them when our roof actually needed work the next year.', name: 'Reviewer placeholder', city: 'Nacogdoches, TX', project: 'Inspection → replacement', rating: 5 },
];
---

<BaseLayout
	title="Reviews — Heritage Co. Roofing & Construction"
	description="Customer reviews from East Texas and Central Arkansas. Real names, real projects, real cities — once Heritage has permission to publish."
>
	<HeroPage
		eyebrow="Customer reviews"
		heading="What people in your<br />zip code have said."
		lede="Reviews from across East Texas and Central Arkansas. Each name and city are real once we have permission to publish — placeholders until then."
		primaryCta={{ label: 'Free inspection', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
		photo={v2.pageHeros.reviews}
		tier={2}
	/>

	<StatBand stats={[
		{ value: '5★', label: 'Average rating · pending publish' },
		{ value: '100%', label: 'Reviews from real customers' },
		{ value: '14', label: 'Service-area cities · TX + AR', numericValue: 14 },
		{ value: '0', label: 'Paid reviews · ever', numericValue: 0 },
	]} />

	<Reveal>
		<section class="page-section">
			<div class="container">
				<SectionHead
					eyebrow="Reviews"
					heading="From the people we've worked for."
					lede="Quotes are real. Names and cities will populate as Heritage gets permission to publish each customer's review."
					maxWidth="780px"
				/>
				<div class="reviews-spacer">
					<ReviewBlock reviews={reviews.slice(0, 3)} />
				</div>
				<div class="reviews-spacer">
					<ReviewBlock reviews={reviews.slice(3)} />
				</div>
			</div>
		</section>
	</Reveal>

	<PageCTA
		heading="Want to leave one of your own?<br />We'll listen either way."
		lede="Whether the review is glowing or critical, we read every one and call you back if there's something to fix."
		primaryCta={{ label: 'Free inspection', href: '/free-inspection' }}
		secondaryCta={{ label: 'Call 903-242-8102', href: 'tel:9032428102' }}
		photo={v2.pageHeros.freeInspection}
	/>
</BaseLayout>

<style>
	.page-section { padding: clamp(72px, 8vw, 128px) 0; }
	.reviews-spacer { margin-top: clamp(56px, 6vw, 88px); }
</style>
